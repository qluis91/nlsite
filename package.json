{
  "name": "nl-site-boilerplate",
  "version": "1.0.0",
  "description": "Plantilla Web Modular - Node.js + Express + EJS + MySQL (Marca Blanca)",
  "main": "app.js",
  "scripts": {
    "prestart": "node scripts/prestart.js",
    "start": "node app.js",
    "dev": "nodemon app.js",
    "test": "node --test",
    "migrate": "node scripts/migrate-all.js",
    "migrate:deploy": "node scripts/migrate-deploy.js",
    "check": "node --test && npm audit --omit=dev"
  },
  "keywords": [
    "boilerplate",
    "express",
    "ejs",
    "mysql",
    "authentication"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": "22.x"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "csrf-sync": "^4.2.1",
    "dotenv": "^16.6.1",
    "ejs": "^3.1.10",
    "express": "^4.22.2",
    "express-mysql-session": "^3.0.3",
    "express-rate-limit": "^8.6.0",
    "express-session": "^1.19.0",
    "gl-matrix": "3.4.3",
    "gsap": "^3.15.0",
    "helmet": "^8.3.0",
    "lenis": "^1.3.25",
    "multer": "^2.2.0",
    "mysql2": "^3.23.1",
    "nodemailer": "^9.0.3",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  },
  "type": "commonjs"
}
