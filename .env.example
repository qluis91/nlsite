# ============================================
# CONFIGURACIÓN DE ENTORNO - PLANTILLA WEB
# Copia este archivo como .env y configura tus valores
# ============================================

# ── Servidor ──
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_MAX_AGE_HOURS=8

# ── Base de Datos (XAMPP - MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nlsite_db

# ── Nombre de la Marca / Sitio ──
SITE_NAME=Mi Sitio Web
SITE_DESCRIPTION=Plantilla modular lista para personalizar

# ── Colores de Marca ──
BRAND_PRIMARY=#2563eb
BRAND_PRIMARY_HOVER=#1d4ed8
BRAND_SECONDARY=#64748b
BRAND_ACCENT=#f59e0b
BRAND_BG=#f8fafc
BRAND_SIDEBAR_BG=#1e293b
BRAND_SIDEBAR_TEXT=#cbd5e1
BRAND_SIDEBAR_HOVER=#334155
BRAND_SUCCESS=#22c55e
BRAND_DANGER=#ef4444
BRAND_WARNING=#f59e0b

# ── Correo (SMTP) ──
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASSWORD=replace_with_mailbox_password
SMTP_FROM_NAME=nlSite
SMTP_FROM_EMAIL=test@example.com

# ── URL de la aplicación ──
APP_URL=http://localhost:3000

# ── Expiración de tokens ──
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=30
