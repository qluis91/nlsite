# ============================================
# CONFIGURACIÓN DE ENTORNO - PLANTILLA WEB
# Copia este archivo como .env y configura tus valores
# ============================================

# ── Servidor ──
PORT=3000
NODE_ENV=development
SESSION_SECRET=replace_with_a_long_random_secret
SESSION_MAX_AGE_HOURS=8

# ── Base de Datos (XAMPP - MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nlsite_db

# ── Nombre de la Marca / Sitio ──
SITE_NAME=Mi Sitio Web
SITE_DESCRIPTION=Plantilla modular lista para personalizar

# ── Colores de Marca ──
BRAND_PRIMARY=#2563eb
BRAND_PRIMARY_HOVER=#1d4ed8
BRAND_SECONDARY=#64748b
BRAND_ACCENT=#f59e0b
BRAND_BG=#f8fafc
BRAND_SIDEBAR_BG=#1e293b
BRAND_SIDEBAR_TEXT=#cbd5e1
BRAND_SIDEBAR_HOVER=#334155
BRAND_SUCCESS=#22c55e
BRAND_DANGER=#ef4444
BRAND_WARNING=#f59e0b

# ── Correo (SMTP o Resend) ──
# MAIL_ENABLED=true
# MAIL_PROVIDER=smtp|resend (default: smtp)
#
# Resend:
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_NAME=nlSite
# RESEND_FROM_EMAIL=noreply@example.com
#
# SMTP:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=test@example.com
SMTP_PASSWORD=replace_with_mailbox_password
SMTP_FROM_NAME=nlSite
SMTP_FROM_EMAIL=test@example.com

# ── URL de la aplicación ──
APP_URL=http://localhost:3000

# ── Identificador de versión ──
# Visible en /admin/media-diagnostic (solo cuando MEDIA_DIAGNOSTIC_ENABLED=true)
# En Railway: usar git commit hash o versión de despliegue
# APP_VERSION=

# ── Expiración de tokens ──
EMAIL_VERIFICATION_EXPIRES_MINUTES=30
PASSWORD_RESET_EXPIRES_MINUTES=30

# ── Upload directories ──
# Development defaults (safe):
#   public/uploads  (product/gallery/category/avatar images)
#   storage/payment-proofs  (private payment-proof files)
# Railway production (mount a persistent volume at /app/storage first):
#   UPLOAD_PUBLIC_DIR=/app/storage/public-uploads
#   UPLOAD_PROOFS_DIR=/app/storage/payment-proofs
# UPLOAD_PUBLIC_DIR=
# UPLOAD_PROOFS_DIR=
# The CMS media library ("Administrar página") stores files under
# <UPLOAD_PUBLIC_DIR>/media/{site,gallery,logos,carousel,icons,models,other,thumbnails}
# and is served read-only at /uploads/media/. It adds no new environment variable.

# ── Diagnóstico temporal de medios ──
# Activación temporal para verificar rutas, permisos y archivos en producción.
# Visita /admin/media-diagnostic como admin autenticado. Desactivar al terminar.
# MEDIA_DIAGNOSTIC_ENABLED=false

# ── WhatsApp Contact ──
# Override with your digits-only WhatsApp number (default: 50670240270)
# WHATSAPP_NUMBER=50670240270

# ── Tilopay Payment Integration ──
# Set TILOPAY_ENABLED=true when credentials are configured.
# See docs/TILOPAY_INTEGRATION.md and docs/TILOPAY_CLIENT_SETUP.md
TILOPAY_ENABLED=false
TILOPAY_ENV=sandbox
# Public-facing URL of THIS site (e.g. https://cliente.example)
# Used to derive return/cancel/webhook callback URLs automatically.
TILOPAY_PUBLIC_BASE_URL=
# Credentials — obtain from Tilopay merchant portal (https://web.tilopay.com/developers)
# ⚠ NEVER use the publicly disclosed test credentials (6609-5850-8330-8034-3464 etc.)
TILOPAY_API_KEY=
TILOPAY_API_USER=
TILOPAY_API_PASSWORD=
# Webhook secret (NOT currently used — webhook signature mechanism unconfirmed from docs)
# TILOPAY_WEBHOOK_SECRET=
# Mock mode — FOR DEVELOPMENT ONLY. Blocked in production.
TILOPAY_MOCK=false
# Request timeout in milliseconds
TILOPAY_REQUEST_TIMEOUT_MS=15000
