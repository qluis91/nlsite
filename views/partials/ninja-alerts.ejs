<%
  const legacyAlerts = [
    ['info', typeof info_msg !== 'undefined' ? info_msg : null],
    ['success', typeof success_msg !== 'undefined' ? success_msg : null],
    ['warning', typeof warning_msg !== 'undefined' ? warning_msg : null],
    ['error', typeof error_msg !== 'undefined' ? error_msg : null]
  ].filter(function (entry) { return entry[1]; }).map(function (entry, index) {
    return { id: 'legacy-' + entry[0] + '-' + index, type: entry[0], title: String(entry[1]) };
  });
  const serverAlerts = []
    .concat(typeof ninjaAlerts !== 'undefined' && Array.isArray(ninjaAlerts) ? ninjaAlerts : [])
    .concat(typeof pageAlerts !== 'undefined' && Array.isArray(pageAlerts) ? pageAlerts : [])
    .concat(legacyAlerts);
  const alertIcons = {
    info: 'M12 16v-4m0-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    success: 'm8.5 12.5 2.25 2.25L15.75 9M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z',
    warning: 'M12 9v4m0 4h.01M10.3 4.2 2.7-1.55a2 2 0 0 1 2.73.73l5.15 8.92A2 2 0 0 1 18.85 19H5.15a2 2 0 0 1-1.73-3l5.15-8.92a2 2 0 0 1 .73-.73Z',
    error: 'm9 9 6 6m0-6-6 6M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z'
  };
%>
<section class="ninja-alerts" data-ninja-alerts aria-label="Notificaciones" aria-relevant="additions removals">
  <% serverAlerts.forEach(function (item) {
    const type = ['info', 'success', 'warning', 'error'].includes(item.type) ? item.type : 'info';
    const urgent = type === 'warning' || type === 'error';
    const title = String(item.title || '');
    const description = item.description ? String(item.description) : '';
  %>
    <article
      class="ninja-alert ninja-alert--<%= type %>"
      data-ninja-alert
      data-alert-id="<%= item.id %>"
      data-alert-type="<%= type %>"
      data-alert-duration="<%= typeof item.duration === 'number' ? item.duration : '' %>"
      data-alert-persistent="<%= item.persistent ? 'true' : 'false' %>"
      role="<%= urgent ? 'alert' : 'status' %>"
      aria-live="<%= urgent ? 'assertive' : 'polite' %>"
      aria-atomic="true"
    >
      <span class="ninja-alert__accent" aria-hidden="true"></span>
      <span class="ninja-alert__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="<%= alertIcons[type] %>"></path>
        </svg>
      </span>
      <span class="ninja-alert__content">
        <strong class="ninja-alert__title"><%= title %></strong>
        <% if (description) { %>
          <span class="ninja-alert__description"><%= description %></span>
        <% } %>
      </span>
      <button class="ninja-alert__close" type="button" data-alert-close aria-label="Cerrar alerta: <%= title %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="m7 7 10 10M17 7 7 17"></path>
        </svg>
      </button>
    </article>
  <% }); %>
</section>
