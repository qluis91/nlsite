<div class="page-header">
  <div>
    <h1>Integraciones sociales</h1>
    <p>Sincroniza contenido automáticamente desde YouTube.</p>
    <% if (schedulerEnabled) { %>
      <p style="color: var(--color-success); font-size: 0.9rem;">
        ✅ Sincronización automática activa — cada <%= Math.round(schedulerIntervalMs / 60000) %> minutos.
      </p>
    <% } else { %>
      <p style="color: var(--color-secondary); font-size: 0.9rem;">
        🔒 Sincronización automática deshabilitada.<br>
        Configurá <code>SOCIAL_SYNC_INTERVAL_MINUTES</code> (&ge;60) en las variables de entorno para activarla.
      </p>
    <% } %>
  </div>
</div>

<section class="cms-modules" aria-label="Integraciones disponibles">
  <% integrations.forEach(function(integration) { %>
    <article class="card cms-module is-active">
      <header class="cms-module-header">
        <h2><%= integration.label %></h2>
        <span class="badge badge-<%= integration.isConnected ? 'published' : 'hidden' %>">
          <%= integration.isConnected ? 'Conectado' : 'No conectado' %>
        </span>
      </header>
      <div class="integration-status" style="margin: 0.5rem 0; font-size: 0.9rem;">
        <% if (integration.isEnabled) { %>
          <p style="color: var(--color-success);">✓ Sincronización habilitada <% if (integration.autoSync) { %>(automática)<% } else { %>(manual)<% } %></p>
        <% } else { %>
          <p style="color: var(--color-secondary);">Sincronización deshabilitada</p>
        <% } %>
        <% if (integration.lastSyncAt) { %>
          <p style="font-size: 0.85rem; color: var(--color-secondary);">
            Última sincronización: <%= new Date(integration.lastSyncAt).toLocaleString('es-CR') %>
            <% if (integration.lastSyncStatus === 'success') { %>
              <span style="color: var(--color-success);">✓</span>
            <% } else if (integration.lastSyncStatus === 'error') { %>
              <span style="color: var(--color-danger);">✖</span>
            <% } %>
          </p>
          <p style="font-size: 0.8rem; color: var(--color-secondary);">
            Importados: <%= integration.importedCount %> · Actualizados: <%= integration.updatedCount %> · Omitidos: <%= integration.skippedCount %>
          </p>
        <% } %>
        <% if (integration.lastSyncError) { %>
          <p style="font-size: 0.8rem; color: var(--color-danger); word-break: break-all;">
            Error: <%= integration.lastSyncError.replace(/AIza[0-9A-Za-z\-_]{35}/g, '[API_KEY]').replace(/ya29\.[0-9A-Za-z\-_]+/g, '[TOKEN]') %>
          </p>
        <% } %>
        <% if (!hasApiKey) { %>
          <p style="color: var(--color-warning); margin-top: 0.25rem;">
            ⚠ No hay YOUTUBE_API_KEY configurada. Agrégala en el <code>.env</code> del servidor.
          </p>
        <% } %>
      </div>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <a class="btn btn-outline" href="/admin/page/integrations/edit?provider=<%= integration.provider %>">Configurar</a>
        <% if (integration.isConnected) { %>
          <form method="POST" action="/admin/page/integrations/test" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="provider" value="<%= integration.provider %>">
            <button type="submit" class="btn btn-outline">Probar conexión</button>
          </form>
          <form method="POST" action="/admin/page/integrations/sync" style="display:inline">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="provider" value="<%= integration.provider %>">
            <button type="submit" class="btn btn-primary">Sincronizar ahora</button>
          </form>
          <form method="POST" action="/admin/page/integrations/disconnect" style="display:inline" onsubmit="return confirm('¿Desconectar <%= integration.label %>? No se eliminarán posts ya importados.')">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input type="hidden" name="provider" value="<%= integration.provider %>">
            <button type="submit" class="btn btn-danger">Desconectar</button>
          </form>
        <% } %>
      </div>
    </article>
  <% }); %>
</section>
