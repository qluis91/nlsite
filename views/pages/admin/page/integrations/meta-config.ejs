<div class="page-header">
  <div>
    <h1><%= provider === 'instagram' ? 'Configurar Instagram' : 'Configurar Facebook' %> — Meta</h1>
    <p>Conecta tu cuenta profesional de <%= provider === 'instagram' ? 'Instagram' : 'Facebook' %> a través de Meta.</p>
  </div>
</div>

<% if (!hasCredentials) { %>
  <div class="card" style="border-left: 4px solid var(--color-warning); margin-bottom: 1.5rem;">
    <p style="margin: 0;">
      <strong>⚠ Meta App no configurada.</strong><br>
      Configura <code>META_APP_ID</code> y <code>META_APP_SECRET</code> en las variables de entorno del servidor.
    </p>
  </div>
<% } %>

<div class="card" style="margin-bottom: 1.5rem;">
  <h3>Conexión OAuth</h3>
  <% if (integration.is_connected) { %>
    <div style="color: var(--color-success);">
      ✅ Conectado — <%= integration.config_json?.pageName || 'Page vinculada' %>
      <% if (integration.config_json?.igUsername) { %>
        · Instagram: @<%= integration.config_json.igUsername %>
      <% } %>
    </div>
    <% if (tokenExpiration) { %>
      <div style="margin-top: 0.5rem; font-size: 0.85rem; color: <%= tokenExpiration.warning ? 'var(--color-warning)' : 'var(--color-secondary)' %>;">
        <%= tokenExpiration.warning ? '⚠' : 'ℹ' %> <%= tokenExpiration.message %>
      </div>
    <% } %>
    <div style="margin-top: 0.5rem; display: flex; gap: 0.5rem;">
      <a class="btn btn-outline" href="/admin/page/integrations/meta-connect?provider=<%= provider %>">Reconectar</a>
      <form method="POST" action="/admin/page/integrations/disconnect" style="display:inline" onsubmit="return confirm('¿Desconectar <%= provider %>?')">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="provider" value="<%= provider %>">
        <button type="submit" class="btn btn-danger">Desconectar</button>
      </form>
    </div>
  <% } else { %>
    <p>No hay una cuenta Meta conectada para <%= provider %>.</p>
    <a class="btn btn-primary" href="/admin/page/integrations/meta-connect?provider=<%= provider %>">Conectar con Facebook</a>
  <% } %>
</div>

<% if (integration.is_connected) { %>
  <form method="POST" action="/admin/page/integrations/save">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <input type="hidden" name="provider" value="<%= provider %>">

    <div class="card" style="margin-bottom: 1.5rem;">
      <h3>Comportamiento de importación</h3>

      <div class="form-group">
        <label for="maxPosts">Máximo de posts por sincronización</label>
        <input type="number" id="maxPosts" name="maxPosts" class="form-control"
               value="<%= (integration.config_json?.maxPosts) || 25 %>" min="1" max="100" style="max-width: 6rem;">
        <small>Entre 1 y 100. Instagram soporta hasta 50.</small>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="isEnabled" value="1" <%= integration.is_enabled ? 'checked' : '' %>>
          <span>Habilitar importación</span>
        </label>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="autoSync" value="1" <%= integration.auto_sync ? 'checked' : '' %>>
          <span>Sincronización automática</span>
        </label>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="requireApproval" value="1" <%= integration.require_approval ? 'checked' : '' %>>
          <span>Requerir aprobación (importar como borrador)</span>
        </label>
      </div>

      <div class="form-group">
        <label class="checkbox-label">
          <input type="checkbox" name="defaultPublished" value="1" <%= integration.config_json?.defaultPublished ? 'checked' : '' %>>
          <span>Publicar automáticamente al importar</span>
        </label>
      </div>
    </div>

    <div class="card" style="margin-bottom: 1.5rem;">
      <h3>Acciones</h3>
      <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <form method="POST" action="/admin/page/integrations/test" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="provider" value="<%= provider %>">
          <button type="submit" class="btn btn-outline">Probar conexión</button>
        </form>
        <form method="POST" action="/admin/page/integrations/sync" style="display:inline">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <input type="hidden" name="provider" value="<%= provider %>">
          <button type="submit" class="btn btn-primary">Sincronizar ahora</button>
        </form>
      </div>
    </div>

    <div class="sticky-actions">
      <a href="/admin/page/integrations" class="btn btn-outline">Volver</a>
      <button type="submit" class="btn btn-primary">Guardar configuración</button>
    </div>
  </form>
<% } %>

<div class="card" style="margin-top: 2rem; padding: 1rem; background: var(--color-bg);">
  <h3 style="margin-top: 0; font-size: 1rem;">Seguridad</h3>
  <p style="font-size: 0.85rem; color: var(--color-secondary); margin: 0;">
    Los tokens de acceso se almacenan cifrados con AES-256-GCM. Nunca se muestran en HTML,
    logs, ni se almacenan en texto plano. La clave de cifrado reside exclusivamente en
    <code>SOCIAL_TOKEN_ENCRYPTION_KEY</code>.
  </p>
</div>
