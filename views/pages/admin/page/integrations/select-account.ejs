<div class="page-header">
  <div>
    <h1>Seleccionar cuenta — Meta</h1>
    <p>Elige la Facebook Page y cuenta de Instagram que quieres conectar.</p>
  </div>
</div>

<% if (options.length === 1) { %>
  <div class="card" style="margin-bottom: 1.5rem; border-left: 4px solid var(--color-info);">
    <p style="margin: 0;">
      Se encontró una sola Page. Confirmá la selección para continuar.
    </p>
  </div>
<% } %>

<form method="POST" action="/admin/page/integrations/select-account">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <% options.forEach(function(option, index) { %>
    <div class="card" style="margin-bottom: 1rem; cursor: pointer; transition: border-color 0.2s;"
         onclick="document.getElementById('opt-<%= index %>').checked = true;">
      <div style="display: flex; align-items: flex-start; gap: 1rem;">
        <div>
          <input type="radio" name="pageId" id="opt-<%= index %>" value="<%= option.page.id %>"
                 <%= index === 0 ? 'checked' : '' %>
                 style="margin-top: 0.3rem;">
        </div>
        <div style="flex: 1;">
          <h3 style="margin: 0 0 0.25rem 0;">
            📘 <%= option.page.name %>
          </h3>
          <small style="color: var(--color-secondary);">ID: <%= option.page.id %></small>

          <% if (option.instagram) { %>
            <div style="margin-top: 0.5rem; padding: 0.5rem; background: var(--color-bg); border-radius: 4px;">
              <strong style="font-size: 0.9rem;">📸 Instagram vinculado:</strong>
              <span style="font-size: 0.9rem;">
                @<%= option.instagram.username %>
                <% if (option.instagram.name) { %>(<%= option.instagram.name %>)<% } %>
              </span>
            </div>
          <% } else { %>
            <div style="margin-top: 0.5rem; padding: 0.5rem; background: var(--color-bg); border-radius: 4px; color: var(--color-secondary);">
              ⚠ Sin cuenta de Instagram Professional vinculada a esta Page.
            </div>
          <% } %>
        </div>
      </div>
    </div>
  <% }); %>

  <div class="sticky-actions">
    <a href="/admin/page/integrations" class="btn btn-outline">Cancelar</a>
    <button type="submit" class="btn btn-primary">Confirmar selección</button>
  </div>
</form>
