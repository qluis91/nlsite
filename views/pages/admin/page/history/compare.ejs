<div class="page-header">
  <h1>Comparar revisiones</h1>
  <div class="cms-actions">
    <a href="/admin/page/history" class="btn btn-outline">Volver al historial</a>
  </div>
</div>

<div class="card" style="margin-bottom:1.5rem">
  <h2>Revisiones comparadas</h2>
  <table class="cms-table cms-table--meta">
    <thead><tr><th></th><th>Desde (Revisión #<%= fromRev.revision_number %>)</th><th>Hasta (Revisión #<%= toRev.revision_number %>)</th></tr></thead>
    <tbody>
      <tr><th>ID</th><td><code><%= fromRev.id %></code></td><td><code><%= toRev.id %></code></td></tr>
      <tr><th>Entidad</th><td><%= fromRev.entity_type %></td><td><%= toRev.entity_type %></td></tr>
      <tr><th>Acción</th><td><span class="badge"><%= fromRev.action %></span></td><td><span class="badge"><%= toRev.action %></span></td></tr>
      <tr><th>Administrador</th><td><%= fromRev.actor_name || '—' %></td><td><%= toRev.actor_name || '—' %></td></tr>
      <tr><th>Fecha</th><td><%= new Date(fromRev.created_at).toLocaleString('es-CR', {dateStyle:'medium',timeStyle:'short'}) %></td><td><%= new Date(toRev.created_at).toLocaleString('es-CR', {dateStyle:'medium',timeStyle:'short'}) %></td></tr>
    </tbody>
  </table>
</div>

<% if (differences.length) { %>
<div class="card">
  <h2>Diferencias detectadas (<%= differences.length %>)</h2>
  <table class="cms-table diff-table">
    <thead><tr><th style="width:180px">Campo</th><th>Desde</th><th>Hasta</th><th style="width:100px">Tipo</th></tr></thead>
    <tbody>
      <% var typeLabels = { agregado:'Agregado', modificado:'Modificado', eliminado:'Eliminado', reordered:'Reordenado' }; %>
      <% differences.forEach(function(d) { %>
        <tr class="diff-row diff-row--<%= d.type === 'agregado' ? 'added' : d.type === 'eliminado' ? 'removed' : d.type === 'reordered' ? 'reordered' : 'changed' %>">
          <td class="diff-field"><strong><%= d.label || d.field %></strong><br><small><code><%= d.field %></code></small></td>
          <td class="diff-old"><code class="diff-value"><%= String(d.oldValue || d.fromValue || '').slice(0, 200) %></code></td>
          <td class="diff-new"><code class="diff-value"><%= String(d.newValue || d.toValue || '').slice(0, 200) %></code></td>
          <td><span class="badge badge--diff-<%= d.type %>"><%= typeLabels[d.type] || d.type %></span></td>
        </tr>
      <% }); %>
    </tbody>
  </table>
</div>
<% } else { %>
  <div class="empty-state">No se detectaron diferencias entre estas revisiones.</div>
<% } %>

<% if (fromData || toData) { %>
<div class="card" style="margin-top:1.5rem">
  <h2>Datos completos</h2>
  <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
    <div>
      <h3>Desde</h3>
      <details><summary>Ver JSON</summary>
        <pre class="json-preview"><code><%= JSON.stringify(fromData || {}, null, 2).replace(/</g, '&lt;').replace(/>/g, '&gt;') %></code></pre>
      </details>
    </div>
    <div>
      <h3>Hasta</h3>
      <details><summary>Ver JSON</summary>
        <pre class="json-preview"><code><%= JSON.stringify(toData || {}, null, 2).replace(/</g, '&lt;').replace(/>/g, '&gt;') %></code></pre>
      </details>
    </div>
  </div>
</div>
<% } %>
