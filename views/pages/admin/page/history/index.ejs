<div class="page-header">
  <h1>Historial de revisiones</h1>
  <div class="cms-actions">
    <a href="/admin/page/publishing" class="btn btn-outline">Volver a publicación</a>
  </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-success"><%= saved %></div><% } %>

<!-- Filters -->
<form class="cms-form cms-form--inline" method="GET" action="/admin/page/history" style="margin-bottom:1.5rem">
  <div class="form-row">
    <div class="form-group">
      <label class="field-label">Módulo</label>
      <select name="moduleKey" class="form-input">
        <option value="">Todos</option>
        <% moduleKeys.forEach(function(k) { %>
          <option value="<%= k %>" <%= moduleKey === k ? 'selected' : '' %>><%= MODULES[k].label %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group">
      <label class="field-label">Acción</label>
      <select name="action" class="form-input">
        <option value="">Todas</option>
        <% revisionActions.forEach(function(a) { %>
          <option value="<%= a %>" <%= action === a ? 'selected' : '' %>><%= a %></option>
        <% }); %>
      </select>
    </div>
    <div class="form-group" style="align-self:flex-end">
      <button type="submit" class="btn btn-primary">Filtrar</button>
      <% if (moduleKey || action) { %>
        <a href="/admin/page/history" class="btn btn-outline btn-sm">Limpiar</a>
      <% } %>
    </div>
  </div>
</form>

<p class="text-muted"><%= total %> revisiones encontradas<% if (moduleKey) { %> para <%= MODULES[moduleKey].label %><% } %>. Página <%= page %> de <%= totalPages %>.</p>

<table class="cms-table">
  <thead>
    <tr>
      <th>#</th>
      <th>Entidad</th>
      <th>Acción</th>
      <th>Resumen</th>
      <th>Actor</th>
      <th>Fecha</th>
      <th>Acciones</th>
    </tr>
  </thead>
  <tbody>
    <% revisions.forEach(function(rev) { %>
      <tr>
        <td><code>#<%= rev.revision_number %></code></td>
        <td><%= rev.entity_type %></td>
        <td><span class="badge"><%= rev.action %></span></td>
        <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= rev.change_summary || '—' %></td>
        <td><%= rev.actor_name || '—' %></td>
        <td><%= new Date(rev.created_at).toLocaleString('es-CR') %></td>
        <td class="cms-actions-cell">
          <a href="/admin/page/history/revision/<%= rev.id %>" class="btn btn-sm btn-outline">Ver</a>
        </td>
      </tr>
    <% }); %>
    <% if (!revisions.length) { %>
      <tr><td colspan="7" class="empty-state">No se encontraron revisiones.</td></tr>
    <% } %>
  </tbody>
</table>

<% if (totalPages > 1) { %>
  <div class="media-selector__pagination" style="display:flex;gap:0.5rem;justify-content:center;margin-top:1rem">
    <% for (let p = 1; p <= totalPages; p++) { %>
      <a href="/admin/page/history?moduleKey=<%= moduleKey %>&action=<%= action %>&page=<%= p %>"
         class="btn btn-sm <%= p === page ? 'btn-primary' : 'btn-outline' %>"><%= p %></a>
    <% } %>
  </div>
<% } %>
