<% const cmsEditorState = typeof editorState !== 'undefined' ? editorState : null; %>
<% const submittedSocialValues = (typeof submittedSocialItem !== 'undefined' && submittedSocialItem && submittedSocialItem.values) ? submittedSocialItem.values : {}; %>
<% const adminSocialItems = typeof socialItems !== 'undefined' && Array.isArray(socialItems) ? socialItems : []; %>
<div data-cms-editor data-editor-state="<%= cmsEditorState || 'clean' %>">
<div class="page-header">
  <div>
    <h1>Panel 1 — Hero</h1>
    <p>Textos, botones, modelo 3D y contenido de presentación de la portada.</p>
    <p>
      <span class="badge <%= (section && section.status === 'published') ? 'badge-published' : 'badge-hidden' %>">
        <%= section ? section.status : 'sin guardar' %>
      </span>
    </p>
  </div>
  <div class="cms-actions">
    <span class="cms-editor-state" data-cms-editor-status data-state="<%= cmsEditorState || 'clean' %>"><%= ({ dirty: 'Cambios sin guardar', saving: 'Guardando', saved: 'Borrador guardado', published: 'Publicado', error: 'Error' })[cmsEditorState] || 'Sin cambios' %></span>
    <a href="/admin/page" class="btn btn-outline">Administrar página</a>
    <a href="/admin/page/preview" target="_blank" class="btn btn-outline">Vista previa</a>
    <form action="/admin/page/home/panel-1/publish" method="POST" style="display:inline" data-cms-publish-form data-confirm="¿Publicar el Panel 1? Los cambios serán visibles en el sitio.">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-primary">Publicar</button>
    </form>
  </div>
</div>

<% if (typeof fieldErrors !== 'undefined' && fieldErrors.length) { %>
  <div class="card" role="group" aria-label="Errores de validación">
    <ul class="cms-field-errors"><% fieldErrors.forEach(function (message) { %><li><%= message %></li><% }); %></ul>
  </div>
<% } %>

<%
  const heroContent = section ? section.content : {};
  const heroStyle = (section && section.style) ? section.style : {};
  const modelStyle = (heroStyle && heroStyle.model) ? heroStyle.model : {};
%>

<form id="panel1-draft-form" action="/admin/page/home/panel-1/save" method="POST" class="cms-form" data-cms-editor-form novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <div class="card">
    <h2>Textos</h2>
    <div class="form-group form-check">
      <label><input type="checkbox" name="is_visible" value="1" <%= heroContent.isVisible !== false ? 'checked' : '' %>> Panel visible al publicar</label>
    </div>
    <div class="form-group">
      <label for="eyebrow">Texto destacado (eyebrow)</label>
      <input class="form-control" id="eyebrow" name="eyebrow" type="text" maxlength="120"
             value="<%= heroContent.eyebrow || '' %>" placeholder="IMPRESIÓN 3D EN COSTA RICA">
      <small class="char-counter"><span id="eyebrow-count">0</span>/120</small>
    </div>
    <div class="form-group">
      <label for="heading">Título principal</label>
      <input class="form-control" id="heading" name="heading" type="text" maxlength="180"
             value="<%= heroContent.heading || '' %>" placeholder="Fabricamos tus ideas con precisión milimétrica">
      <small class="char-counter"><span id="heading-count">0</span>/180</small>
    </div>
    <div class="form-group">
      <label for="description">Descripción</label>
      <textarea class="form-control" id="description" name="description" rows="3" maxlength="1000"
                placeholder="Diseño, prototipado y fabricación con precisión para convertir ideas en piezas reales."><%= heroContent.description || '' %></textarea>
      <small class="char-counter"><span id="description-count">0</span>/1000</small>
    </div>
  </div>

  <div class="card">
    <h2>Botones CTA</h2>
    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label for="primary_label">Botón principal — Etiqueta</label>
        <input class="form-control" id="primary_label" name="primary_label" type="text" maxlength="80"
               value="<%= (heroContent.primaryButton && heroContent.primaryButton.label) || '' %>" placeholder="Explorar productos">
      </div>
      <div class="form-group" style="flex:2">
        <label for="primary_url">Botón principal — URL</label>
        <input class="form-control" id="primary_url" name="primary_url" type="text" maxlength="500"
               value="<%= (heroContent.primaryButton && heroContent.primaryButton.url) || '' %>" placeholder="#productos">
      </div>
      <div class="form-group"><label for="primary_target">Abrir en</label><select class="form-control" id="primary_target" name="primary_target"><option value="_self" <%= heroContent.primaryButton?.target !== '_blank' ? 'selected' : '' %>>Misma pestaña</option><option value="_blank" <%= heroContent.primaryButton?.target === '_blank' ? 'selected' : '' %>>Nueva pestaña</option></select></div>
    </div>
    <div class="form-group form-check">
      <label>
        <input type="checkbox" name="primary_visible" value="1"
               <%= (!heroContent.primaryButton || heroContent.primaryButton.visible) ? 'checked' : '' %>>
        Visible
      </label>
    </div>

    <div class="form-row">
      <div class="form-group" style="flex:1">
        <label for="secondary_label">Botón secundario — Etiqueta</label>
        <input class="form-control" id="secondary_label" name="secondary_label" type="text" maxlength="80"
               value="<%= (heroContent.secondaryButton && heroContent.secondaryButton.label) || '' %>" placeholder="Cómo trabajamos">
      </div>
      <div class="form-group" style="flex:2">
        <label for="secondary_url">Botón secundario — URL</label>
        <input class="form-control" id="secondary_url" name="secondary_url" type="text" maxlength="500"
               value="<%= (heroContent.secondaryButton && heroContent.secondaryButton.url) || '' %>" placeholder="#como-trabajamos">
      </div>
      <div class="form-group"><label for="secondary_target">Abrir en</label><select class="form-control" id="secondary_target" name="secondary_target"><option value="_self" <%= heroContent.secondaryButton?.target !== '_blank' ? 'selected' : '' %>>Misma pestaña</option><option value="_blank" <%= heroContent.secondaryButton?.target === '_blank' ? 'selected' : '' %>>Nueva pestaña</option></select></div>
    </div>
    <div class="form-group form-check">
      <label>
        <input type="checkbox" name="secondary_visible" value="1"
               <%= (!heroContent.secondaryButton || heroContent.secondaryButton.visible) ? 'checked' : '' %>>
        Visible
      </label>
    </div>
  </div>

  <div class="card">
    <h2>Medios</h2>
    <div class="form-group">
      <%- include('../../../components/media-selector', {
        fieldName: 'background_media',
        currentValue: heroContent.backgroundMedia || '',
        allowedTypes: ['image/png','image/jpeg','image/webp'],
        allowedCategories: ['site'],
        uploadProfile: 'hero-background',
        label: 'Imagen de fondo',
        kindLabel: 'Imagen',
        thumbnailUrl: bgMedia ? bgMedia.thumbnail_url : null,
        selectedTitle: bgMedia ? (bgMedia.title || bgMedia.original_filename) : null,
        selectedCategory: bgMedia ? bgMedia.category : null,
        selectedMime: bgMedia ? bgMedia.mime_type : null,
        selectedDimensions: bgMedia ? bgMedia.dimensions : null,
      }) %>
      <small>Imagen que se usará como fondo del Panel 1.</small>
    </div>
    <div class="form-group">
      <%- include('../../../components/media-selector', {
        fieldName: 'model_media',
        currentValue: heroContent.modelMedia || '',
        allowedTypes: ['model/gltf-binary'],
        allowedCategories: ['model'],
        uploadProfile: 'hero-model',
        label: 'Modelo 3D (GLB)',
        kindLabel: 'Modelo 3D',
        thumbnailUrl: modelMedia ? modelMedia.thumbnail_url : null,
        selectedTitle: modelMedia ? (modelMedia.title || modelMedia.original_filename) : null,
        selectedCategory: modelMedia ? modelMedia.category : null,
        selectedMime: modelMedia ? modelMedia.mime_type : null,
        selectedDimensions: modelMedia ? modelMedia.dimensions : null,
      }) %>
      <small>Solo se aceptan modelos GLB de la categoría "Modelo 3D".</small>
    </div>
    <div class="form-group">
      <%- include('../../../components/media-selector', {
        fieldName: 'model_fallback',
        currentValue: heroContent.modelFallbackMedia || '',
        allowedTypes: ['image/png','image/jpeg','image/webp'],
        allowedCategories: ['site'],
        uploadProfile: 'hero-fallback',
        label: 'Imagen de respaldo del modelo',
        kindLabel: 'Imagen',
        thumbnailUrl: fallbackMedia ? fallbackMedia.thumbnail_url : null,
        selectedTitle: fallbackMedia ? (fallbackMedia.title || fallbackMedia.original_filename) : null,
        selectedCategory: fallbackMedia ? fallbackMedia.category : null,
        selectedMime: fallbackMedia ? fallbackMedia.mime_type : null,
        selectedDimensions: fallbackMedia ? fallbackMedia.dimensions : null,
      }) %>
      <small>Se muestra si el modelo 3D no carga.</small>
    </div>
    <div class="form-group form-check">
      <label>
        <input type="checkbox" name="model_enabled" value="1"
               <%= heroContent.modelEnabled !== false ? 'checked' : '' %>>
        Modelo 3D habilitado
      </label>
    </div>
  </div>

  <div class="card">
    <h2>Configuración del modelo 3D</h2>
    <div class="form-row">
      <div class="form-group">
        <label for="model_scale">Escala</label>
        <input class="form-control" id="model_scale" name="model_scale" type="number"
               min="0.1" max="5" step="0.01"
               value="<%= modelStyle.scale || 1 %>">
      </div>
      <div class="form-group">
        <label for="auto_rotate_speed">Velocidad rotación automática</label>
        <input class="form-control" id="auto_rotate_speed" name="auto_rotate_speed" type="number"
               min="0" max="5" step="0.01"
               value="<%= modelStyle.autoRotateSpeed || 1 %>">
      </div>
    </div>

    <h3 style="font-size:0.95rem;margin:0.75rem 0 0.5rem">Posición</h3>
    <div class="form-row">
      <div class="form-group">
        <label for="model_pos_x">X</label>
        <input class="form-control" id="model_pos_x" name="model_pos_x" type="number"
               min="-10" max="10" step="0.1"
               value="<%= (modelStyle.position && modelStyle.position.x) || 0 %>">
      </div>
      <div class="form-group">
        <label for="model_pos_y">Y</label>
        <input class="form-control" id="model_pos_y" name="model_pos_y" type="number"
               min="-10" max="10" step="0.1"
               value="<%= (modelStyle.position && modelStyle.position.y) || 0 %>">
      </div>
      <div class="form-group">
        <label for="model_pos_z">Z</label>
        <input class="form-control" id="model_pos_z" name="model_pos_z" type="number"
               min="-10" max="10" step="0.1"
               value="<%= (modelStyle.position && modelStyle.position.z) || 0 %>">
      </div>
    </div>

    <h3 style="font-size:0.95rem;margin:0.75rem 0 0.5rem">Rotación inicial</h3>
    <div class="form-row">
      <div class="form-group">
        <label for="model_rot_x">X</label>
        <input class="form-control" id="model_rot_x" name="model_rot_x" type="number"
               min="-6.283" max="6.283" step="0.1"
               value="<%= (modelStyle.rotation && modelStyle.rotation.x) || 0 %>">
      </div>
      <div class="form-group">
        <label for="model_rot_y">Y</label>
        <input class="form-control" id="model_rot_y" name="model_rot_y" type="number"
               min="-6.283" max="6.283" step="0.1"
               value="<%= (modelStyle.rotation && modelStyle.rotation.y) || 0 %>">
      </div>
      <div class="form-group">
        <label for="model_rot_z">Z</label>
        <input class="form-control" id="model_rot_z" name="model_rot_z" type="number"
               min="-6.283" max="6.283" step="0.1"
               value="<%= (modelStyle.rotation && modelStyle.rotation.z) || 0 %>">
      </div>
    </div>

    <div class="form-group form-check">
      <label>
        <input type="checkbox" name="auto_rotate" value="1"
               <%= modelStyle.autoRotate !== false ? 'checked' : '' %>>
        Rotación automática habilitada
      </label>
    </div>
  </div>

  <div class="card">
    <h2>Accesibilidad y estados</h2>
    <div class="form-row">
      <div class="form-group"><label for="hero_aria_label">Etiqueta accesible del modelo</label><input class="form-control" id="hero_aria_label" name="hero_aria_label" maxlength="160" value="<%= heroContent.heroAriaLabel || 'Casco 3D interactivo' %>"></div>
      <div class="form-group"><label for="loading_aria_label">Etiqueta durante la carga</label><input class="form-control" id="loading_aria_label" name="loading_aria_label" maxlength="160" value="<%= heroContent.loadingAriaLabel || 'Cargando modelo 3D' %>"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label for="model_error_text">Mensaje si el modelo falla</label><input class="form-control" id="model_error_text" name="model_error_text" maxlength="240" value="<%= heroContent.modelErrorText || 'No fue posible cargar el modelo 3D.' %>"></div>
      <div class="form-group"><label for="retry_label">Etiqueta del botón de reintento</label><input class="form-control" id="retry_label" name="retry_label" maxlength="80" value="<%= heroContent.retryLabel || 'Reintentar' %>"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label for="model_poster_alt">Texto alternativo del póster</label><input class="form-control" id="model_poster_alt" name="model_poster_alt" maxlength="250" value="<%= heroContent.modelPosterAlt || 'Casco 3D NinjaLab' %>"></div>
      <div class="form-group"><label for="model_fallback_alt">Texto alternativo de respaldo</label><input class="form-control" id="model_fallback_alt" name="model_fallback_alt" maxlength="250" value="<%= heroContent.modelFallbackAlt || 'Modelo 3D no disponible' %>"></div>
    </div>
    <div class="form-group"><label for="social_aria_label">Etiqueta accesible del grupo de redes sociales</label><input class="form-control" id="social_aria_label" name="social_aria_label" maxlength="160" value="<%= heroContent.socialAriaLabel || 'Redes sociales de NinjaLab' %>"></div>
  </div>

  <div class="cms-actions">
    <button class="btn btn-primary" type="submit" form="panel1-draft-form">Guardar cambios</button>
  </div>
</form>

<section class="card">
  <h2>Redes sociales</h2>
  <p>Los iconos integrados se eligen desde una lista segura. Los cambios quedan como borrador hasta publicar el Panel 1.</p>
  <% adminSocialItems.forEach(function(item) { %>
    <form method="POST" action="/admin/page/home/panel-1/social/items/save" class="cms-form cms-repeatable-item" data-cms-editor-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="public_id" value="<%= item.public_id %>">
      <div class="form-row">
        <div class="form-group"><label>Plataforma</label><select name="platform" class="form-control"><% ['instagram','facebook','tiktok','whatsapp','youtube','linkedin','x'].forEach(function(platform) { %><option value="<%= platform %>" <%= item.platform === platform ? 'selected' : '' %>><%= platform %></option><% }); %></select></div>
        <div class="form-group"><label>Etiqueta</label><input name="label" class="form-control" maxlength="80" required value="<%= item.label || '' %>"></div>
        <div class="form-group"><label>Visible</label><select name="is_visible" class="form-control"><option value="1" <%= item.is_visible ? 'selected' : '' %>>Sí</option><option value="0" <%= !item.is_visible ? 'selected' : '' %>>No</option></select></div>
      </div>
      <div class="form-group"><label>URL del perfil</label><input name="profile_url" class="form-control" type="url" maxlength="500" required value="<%= item.profile_url || '' %>" placeholder="https://..."></div>
      <div class="form-group"><label>Etiqueta accesible</label><input name="aria_label" class="form-control" maxlength="160" required value="<%= item.aria_label || '' %>"></div>
      <div class="form-group">
        <%- include('../../../components/media-selector', {
          fieldName: 'media_public_id',
          currentValue: item.media_public_id ? 'media://' + item.media_public_id : '',
          label: 'Icono personalizado (opcional)',
          kindLabel: 'Icono',
          allowedTypes: ['image/png','image/jpeg','image/webp'],
          allowedCategories: ['icon','logo'],
          uploadProfile: 'feature-icon',
          thumbnailUrl: item.media_resolved ? item.media_resolved.thumbnail_url : null,
          selectedTitle: item.media_resolved ? item.media_resolved.title : null,
        }) %>
      </div>
      <div class="cms-actions"><button type="submit" class="btn btn-primary">Guardar red social</button><button type="submit" class="btn btn-danger" formaction="/admin/page/home/panel-1/social/items/archive">Archivar</button></div>
    </form>
  <% }); %>
  <details class="cms-card">
    <summary>Agregar red social</summary>
    <form method="POST" action="/admin/page/home/panel-1/social/items" class="cms-form" data-cms-editor-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-row">
        <div class="form-group"><label>Plataforma</label><select name="platform" class="form-control"><% ['instagram','facebook','tiktok','whatsapp','youtube','linkedin','x'].forEach(function(platform) { %><option value="<%= platform %>"><%= platform %></option><% }); %></select></div>
        <div class="form-group"><label>Etiqueta</label><input name="label" class="form-control" maxlength="80" required value="<%= submittedSocialValues.label || '' %>"></div>
      </div>
      <div class="form-group"><label>URL del perfil</label><input name="profile_url" class="form-control" type="url" maxlength="500" required value="<%= submittedSocialValues.profile_url || '' %>" placeholder="https://www.instagram.com/..."></div>
      <div class="form-group"><label>Etiqueta accesible</label><input name="aria_label" class="form-control" maxlength="160" required value="<%= submittedSocialValues.aria_label || '' %>"></div>
      <div class="form-group">
        <%- include('../../../components/media-selector', {
          fieldName: 'media_public_id',
          currentValue: submittedSocialValues.media_public_id || '',
          label: 'Icono personalizado (opcional)',
          kindLabel: 'Icono',
          allowedTypes: ['image/png','image/jpeg','image/webp'],
          allowedCategories: ['icon','logo'],
          uploadProfile: 'feature-icon',
        }) %>
      </div>
      <input type="hidden" name="is_visible" value="1">
      <button type="submit" class="btn btn-primary">Agregar red social</button>
    </form>
  </details>
  <form method="POST" action="/admin/page/home/panel-1/social/items/reorder" class="cms-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <label>Orden (identificadores separados por coma)</label>
    <input class="form-control" name="ids" value="<%= adminSocialItems.map(function(item) { return item.public_id; }).join(',') %>">
    <button type="submit" class="btn btn-outline">Guardar orden</button>
  </form>
</section>

<section class="card">
  <h2>Biblioteca multimedia</h2>
  <p style="color:#64748b">Modelos 3D disponibles:</p>
  <ul style="list-style:none;padding:0;display:grid;gap:0.5rem">
    <% (modelList.items || []).slice(0, 4).forEach(function (asset) { %>
      <li><code><%= asset.public_id %></code> — <%= asset.title || asset.filename %> (GLB)</li>
    <% }); %>
  </ul>
  <p style="color:#64748b;margin-top:0.75rem">Imágenes disponibles:</p>
  <ul style="list-style:none;padding:0;display:grid;gap:0.5rem">
    <% (mediaList.items || []).filter(function(a) { return a.kind !== 'model'; }).slice(0, 4).forEach(function (asset) { %>
      <li><code><%= asset.public_id %></code> — <%= asset.title || asset.filename %> (<%= asset.mime_type %>)</li>
    <% }); %>
  </ul>
</section>
</div>
