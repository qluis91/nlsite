<% const c = content || {}; const s = style || {}; const cmsEditorState = typeof editorState !== 'undefined' ? editorState : null; %>
<div data-cms-editor data-editor-state="<%= cmsEditorState || 'clean' %>">
<div class="page-header">
  <div>
    <h1>Panel 2 — Showcase de proyectos</h1>
    <p>LogoLoop, carrusel de proyectos y contenido del showcase.</p>
  </div>
  <div class="cms-actions">
    <span class="cms-editor-state" data-cms-editor-status data-state="<%= cmsEditorState || 'clean' %>"><%= ({ dirty: 'Cambios sin guardar', saving: 'Guardando', saved: 'Borrador guardado', published: 'Publicado', error: 'Error' })[cmsEditorState] || 'Sin cambios' %></span>
  </div>
</div>

<% if (typeof fieldErrors !== 'undefined' && fieldErrors.length) { %>
  <div class="card" role="group" aria-label="Errores de validación">
    <ul class="cms-field-errors"><% fieldErrors.forEach(function (message) { %><li><%= message %></li><% }); %></ul>
  </div>
<% } %>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-success"><%= saved %></div><% } %>

<!-- ── Tabs ── -->
<nav class="cms-tabs" role="tablist" aria-label="Secciones del Panel 2">
  <button class="cms-tab is-active" role="tab" aria-selected="true" data-tab="general">Contenido general</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="logoloop">LogoLoop</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="carousel">Carrusel de proyectos</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="style">Apariencia</button>
</nav>

<!-- ═══ General content tab ═══ -->
<div class="cms-tab-panel is-active" role="tabpanel" data-panel="general">
  <form method="POST" action="/admin/page/home/panel-2/draft" class="cms-form" data-cms-editor-form novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label class="field-label"><input type="checkbox" name="isVisible" value="1" <%= c.isVisible !== false ? 'checked' : '' %>> Panel visible al publicar</label></div>

    <div class="form-group">
      <label class="field-label" for="p2-eyebrow">Kicker / Etiqueta superior</label>
      <input type="text" id="p2-eyebrow" name="eyebrow" class="form-input" maxlength="120" value="<%= c.eyebrow || '' %>">
      <span class="char-counter"><%= (c.eyebrow || '').length %>/120</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p2-heading">Encabezado principal <span class="required">*</span></label>
      <input type="text" id="p2-heading" name="heading" class="form-input" maxlength="220" required value="<%= c.heading || '' %>">
      <span class="char-counter"><%= (c.heading || '').length %>/220</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p2-support">Texto de apoyo</label>
      <textarea id="p2-support" name="supportText" class="form-input" rows="3" maxlength="1200"><%= c.supportText || '' %></textarea>
      <span class="char-counter"><%= (c.supportText || '').length %>/1200</span>
    </div>

    <div class="form-row">
      <div class="form-group">
        <label class="field-label" for="p2-carousel-label">Etiqueta del carrusel</label>
        <input type="text" id="p2-carousel-label" name="carouselLabel" class="form-input" maxlength="120" value="<%= c.carouselLabel || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p2-loopl-aria">Etiqueta ARIA del LogoLoop</label>
        <input type="text" id="p2-loopl-aria" name="logoLoopAriaLabel" class="form-input" maxlength="160" value="<%= c.logoLoopAriaLabel || '' %>">
      </div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="field-label" for="p2-controls-label">Etiqueta de controles</label><input id="p2-controls-label" name="carouselControlsAriaLabel" class="form-input" maxlength="160" value="<%= c.carouselControlsAriaLabel || 'Controles del carrusel' %>"></div>
      <div class="form-group"><label class="field-label" for="p2-prev-label">Etiqueta anterior</label><input id="p2-prev-label" name="carouselPreviousLabel" class="form-input" maxlength="100" value="<%= c.carouselPreviousLabel || 'Proyecto anterior' %>"></div>
      <div class="form-group"><label class="field-label" for="p2-next-label">Etiqueta siguiente</label><input id="p2-next-label" name="carouselNextLabel" class="form-input" maxlength="100" value="<%= c.carouselNextLabel || 'Proyecto siguiente' %>"></div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-save" name="action" value="draft">Guardar cambios</button>
    </div>
  </form>
</div>

<!-- ═══ LogoLoop tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="logoloop" hidden>
  <div class="cms-section-header">
    <h3>Elementos del LogoLoop</h3>
    <div class="cms-section-header__actions">
      <span class="badge"><%= logoItems.filter(i => i.status === 'published').length %> publicados · <%= logoItems.filter(i => i.status === 'draft').length %> borradores · <%= logoItems.length %> total</span>
      <button type="button" class="btn btn-primary"
              data-item-editor-open data-editor-type="logo" data-mode="create" data-logo-add>Agregar elemento</button>
    </div>
  </div>

  <table class="cms-table">
    <thead>
      <tr><th>Tipo</th><th>Contenido / URL</th><th>Visible</th><th>Estado</th><th>Orden</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% logoItems.forEach(function(item) { %>
        <tr>
          <td><span class="badge badge-<%= item.item_type %>"><%= item.item_type %></span></td>
          <td>
            <% if (item.item_type === 'text') { %><%= item.text_content %><% } %>
            <% if (item.item_type === 'image' || item.item_type === 'logo') { %>
              <% if (item.media_public_id_resolved) { %>
                <img src="<%= item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url %>" style="max-width:40px;max-height:40px;vertical-align:middle" alt=""> <%= item.media_public_id_resolved.title %>
              <% } else { %> <em>Sin imagen</em> <% } %>
            <% } %>
            <% if (item.url) { %><br><small><a href="<%= item.url %>" target="_blank"><%= item.url %></a></small><% } %>
          </td>
          <td><%= item.is_visible ? 'Sí' : 'No' %></td>
          <td><span class="badge badge-<%= item.status === 'published' ? 'published' : 'draft' %>"><%= item.status %></span></td>
          <td><%= item.sort_order %></td>
          <td class="cms-actions-cell">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-item-editor-open data-editor-type="logo" data-mode="edit"
                    data-item-id="<%= item.public_id %>" data-logo-edit-id="<%= item.public_id %>">Editar</button>
            <form method="POST" action="/admin/page/home/panel-2/logo-loop/items/archive" class="cms-form--inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="public_id" value="<%= item.public_id %>">
              <button type="submit" class="btn btn-sm btn-danger">Archivar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>


  <div class="cms-card">
    <form method="POST" action="/admin/page/home/panel-2/logo-loop/items/reorder" class="cms-form cms-form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field-label">Reordenar (IDs separados por coma)</label>
      <input type="text" name="ids" class="form-input" value="<%= logoItems.map(i => i.public_id).join(',') %>" style="width:100%">
      <button type="submit" class="btn btn-secondary btn-sm">Actualizar orden</button>
    </form>
  </div>

  <div class="cms-section-footer">
    <form method="POST" action="/admin/page/home/panel-2/logo-loop/items/publish" class="cms-form" data-cms-publish-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-publish">Publicar LogoLoop</button>
    </form>
  </div>
</div>

<!-- ═══ Carousel tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="carousel" hidden>
  <div class="cms-section-header">
    <h3>Proyectos del carrusel</h3>
    <div class="cms-section-header__actions">
      <span class="badge"><%= carouselItems.filter(i => i.status === 'published').length %> publicados · <%= carouselItems.filter(i => i.status === 'draft').length %> borradores</span>
      <button type="button" class="btn btn-primary"
              data-item-editor-open data-editor-type="carousel" data-mode="create" data-carousel-add>Agregar proyecto</button>
    </div>
  </div>

  <% carouselItems.forEach(function(item) { %>
    <article class="cms-card carousel-preview-card">
      <div class="carousel-preview-card__inner">
        <div class="carousel-preview-card__image">
          <% if (item.media_public_id_resolved) { %>
            <img src="<%= item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url %>" alt="" class="carousel-preview-card__media" style="--carousel-position-x:<%= item.position_x %>%;--carousel-position-y:<%= item.position_y %>%">
          <% } else { %>
            <div class="empty-state" style="padding:2rem;text-align:center">Sin imagen</div>
          <% } %>
        </div>
        <div class="carousel-preview-card__body">
          <p class="carousel-preview-card__eyebrow"><%= item.eyebrow || '' %></p>
          <h4><%= item.title %></h4>
          <p><%= item.description || '' %></p>
          <% if (item.button_label) { %><p><span class="badge"><%= item.button_label %></span> → <%= item.button_url %></p><% } %>
          <p>
            <small>Tema: <%= item.theme_key || '-' %> · Visible: <%= item.is_visible ? 'Sí' : 'No' %> · <%= item.status %></small>
          </p>
          <div class="cms-actions-cell">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-item-editor-open data-editor-type="carousel" data-mode="edit"
                    data-item-id="<%= item.public_id %>" data-carousel-edit-id="<%= item.public_id %>">Editar</button>
            <form method="POST" action="/admin/page/home/panel-2/carousel/items/archive" class="cms-form--inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="public_id" value="<%= item.public_id %>">
              <button type="submit" class="btn btn-sm btn-danger">Archivar</button>
            </form>
          </div>
        </div>
      </div>
    </article>
  <% }); %>

  <% if (!carouselItems.length) { %>
    <div class="empty-state">Sin proyectos en el carrusel. Use “Agregar proyecto” para crear uno.</div>
  <% } %>


  <div class="cms-card">
    <form method="POST" action="/admin/page/home/panel-2/carousel/items/reorder" class="cms-form cms-form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field-label">Reordenar (IDs separados por coma)</label>
      <input type="text" name="ids" class="form-input" value="<%= carouselItems.map(i => i.public_id).join(',') %>" style="width:100%">
      <button type="submit" class="btn btn-secondary btn-sm">Actualizar orden</button>
    </form>
  </div>

  <div class="cms-section-footer">
    <form method="POST" action="/admin/page/home/panel-2/carousel/items/publish" class="cms-form" data-cms-publish-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-publish">Publicar carrusel</button>
    </form>
  </div>
</div>

<!-- ═══ Style tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="style" hidden>
  <form method="POST" action="/admin/page/home/panel-2/draft" id="panel2-settings-form" class="cms-form" data-cms-editor-form novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <div class="form-group">
        <label class="field-label" for="p2-bg-color">Color de fondo</label>
        <input type="text" id="p2-bg-color" name="backgroundColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.backgroundColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p2-text-color">Color de texto</label>
        <input type="text" id="p2-text-color" name="textColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.textColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p2-accent-color">Color de acento</label>
        <input type="text" id="p2-accent-color" name="accentColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.accentColor || '' %>">
      </div>
    </div>
  </form>

  <div class="sticky-actions">
    <span class="cms-editor-state" data-cms-editor-status data-state="<%= cmsEditorState || 'clean' %>">Sin cambios</span>
    <button type="submit" class="btn btn-save" name="action" value="draft" form="panel2-settings-form">Guardar cambios</button>
    <button type="submit" form="panel2-publish-form" class="btn btn-publish">Publicar Panel 2</button>
  </div>
</div>
<form id="panel2-publish-form" method="POST" action="/admin/page/home/panel-2/publish" style="display:none" data-cms-publish-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<% /* Drawer form partials preserve the existing components/media-selector integration. */ %>
<%- include('../../../components/admin/item-editor-drawer', {
  kind: 'logo',
  createTitle: 'Agregar elemento de LogoLoop',
  editTitle: 'Editar elemento de LogoLoop',
  formPartial: '../../pages/admin/page/partials/logo-loop-form',
  formLocals: {
    csrfToken: csrfToken,
    canPublish: typeof capabilities !== 'undefined' && capabilities.includes('home.logoLoop.publish'),
    fieldErrors: typeof fieldErrors !== 'undefined' ? fieldErrors : [],
    submittedKind: typeof submittedItem !== 'undefined' && submittedItem ? submittedItem.kind : null
  }
}) %>
<%- include('../../../components/admin/item-editor-drawer', {
  kind: 'carousel',
  createTitle: 'Agregar proyecto',
  editTitle: 'Editar proyecto',
  formPartial: '../../pages/admin/page/partials/carousel-form',
  formLocals: {
    csrfToken: csrfToken,
    canPublish: typeof capabilities !== 'undefined' && capabilities.includes('home.carousel.publish'),
    fieldErrors: typeof fieldErrors !== 'undefined' ? fieldErrors : [],
    submittedKind: typeof submittedItem !== 'undefined' && submittedItem ? submittedItem.kind : null
  }
}) %>
</div>

<script type="application/json" id="panel2-submitted-item-data"><%- safeJsonScript(typeof submittedItem !== 'undefined' ? submittedItem : null) %></script>
<script type="application/json" id="panel2-logo-items-data"><%- safeJsonScript(logoItems.map(function(item) {
  return {
    id: item.public_id,
    item_type: item.item_type,
    text_content: item.text_content || '',
    media: item.media_public_id ? 'media://' + item.media_public_id : '',
    media_thumb: item.media_public_id_resolved ? (item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url || '') : '',
    media_title: item.media_public_id_resolved ? (item.media_public_id_resolved.title || '') : '',
    url: item.url || '',
    link_type: item.link_type || 'internal',
    target: item.target || '_self',
    alt_text: item.alt_text || '',
    is_visible: item.is_visible,
    status: item.status,
  };
})) %></script>
</div>
<script type="application/json" id="panel2-carousel-items-data"><%- safeJsonScript(carouselItems.map(function(item) {
  return {
    id: item.public_id,
    eyebrow: item.eyebrow || '',
    title: item.title || '',
    description: item.description || '',
    button_label: item.button_label || '',
    button_url: item.button_url || '',
    button_target: item.button_target || '_self',
    media_public_id: item.media_public_id ? 'media://' + item.media_public_id : '',
    media_thumb: item.media_public_id_resolved ? (item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url || '') : '',
    media_url: item.media_public_id_resolved ? (item.media_public_id_resolved.url || item.media_public_id_resolved.thumbnail_url || '') : '',
    media_title: item.media_public_id_resolved ? (item.media_public_id_resolved.title || '') : '',
    preview_media_public_id: item.preview_media_public_id ? 'media://' + item.preview_media_public_id : '',
    preview_media_thumb: item.preview_media_public_id_resolved ? (item.preview_media_public_id_resolved.thumbnail_url || item.preview_media_public_id_resolved.url || '') : '',
    preview_media_title: item.preview_media_public_id_resolved ? (item.preview_media_public_id_resolved.title || '') : '',
    position_x: item.position_x,
    position_y: item.position_y,
    media_alt: item.media_alt || '',
    preview_media_alt: item.preview_media_alt || '',
    theme_key: item.theme_key || 'graphite',
    is_visible: item.is_visible,
    status: item.status,
  };
})) %></script>
