<% const c = content || {}; const s = style || {}; %>
<div class="page-header">
  <div>
    <h1>Panel 3 — Servicios</h1>
    <p>Contenido general y tarjetas de servicios del panel de cierre.</p>
  </div>
</div>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-success"><%= saved %></div><% } %>

<!-- ── Tabs ── -->
<nav class="cms-tabs" role="tablist" aria-label="Secciones del Panel 3">
  <button class="cms-tab is-active" role="tab" aria-selected="true" data-tab="general">Contenido general</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="cards">Tarjetas / Características</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="style">Apariencia</button>
</nav>

<!-- ═══ General content tab ═══ -->
<div class="cms-tab-panel is-active" role="tabpanel" data-panel="general">
  <form method="POST" action="/admin/page/home/panel-3/draft" class="cms-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-group">
      <label class="field-label" for="p3-eyebrow">Kicker / Etiqueta superior</label>
      <input type="text" id="p3-eyebrow" name="eyebrow" class="form-input" maxlength="120" value="<%= c.eyebrow || '' %>">
      <span class="char-counter"><%= (c.eyebrow || '').length %>/120</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p3-heading">Encabezado principal <span class="required">*</span></label>
      <input type="text" id="p3-heading" name="heading" class="form-input" maxlength="220" required value="<%= c.heading || '' %>">
      <span class="char-counter"><%= (c.heading || '').length %>/220</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p3-desc">Descripción</label>
      <textarea id="p3-desc" name="description" class="form-input" rows="3" maxlength="1200"><%= c.description || '' %></textarea>
      <span class="char-counter"><%= (c.description || '').length %>/1200</span>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" name="action" value="draft">Guardar borrador</button>
    </div>
  </form>
</div>

<!-- ═══ Cards tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="cards" hidden>
  <div class="cms-section-header">
    <h3>Tarjetas de servicios</h3>
    <span class="badge"><%= items.filter(i => i.status === 'published').length %> publicadas · <%= items.filter(i => i.status === 'draft').length %> borradores · <%= items.length %> total</span>
  </div>

  <table class="cms-table">
    <thead>
      <tr><th>Icono</th><th>Título</th><th>Descripción</th><th>Visible</th><th>Estado</th><th>Orden</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td>
            <% if (item.icon_type === 'builtin') { %>
              <span class="badge"><%= item.icon_key %></span>
            <% } else if (item.media_public_id_resolved) { %>
              <img src="<%= item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url %>" style="max-width:30px;max-height:30px" alt="">
            <% } else { %>
              <em>Sin icono</em>
            <% } %>
          </td>
          <td><strong><%= item.title %></strong></td>
          <td><small><%= (item.description || '').substring(0, 100) %></small></td>
          <td><%= item.is_visible ? 'Sí' : 'No' %></td>
          <td><span class="badge badge-<%= item.status === 'published' ? 'published' : 'draft' %>"><%= item.status %></span></td>
          <td><%= item.sort_order %></td>
          <td class="cms-actions-cell">
            <button type="button" class="btn btn-sm btn-secondary" data-feature-edit-id="<%= item.public_id %>">Editar</button>
            <form method="POST" action="/admin/page/home/panel-3/items/archive" class="cms-form--inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="public_id" value="<%= item.public_id %>">
              <button type="submit" class="btn btn-sm btn-danger">Archivar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>

  <details class="cms-card">
    <summary class="cms-card-title">Agregar / Editar tarjeta</summary>
    <form method="POST" action="/admin/page/home/panel-3/items" class="cms-form" id="feature-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="public_id" id="feature-edit-id" value="">

      <div class="form-group">
        <label class="field-label" for="feature-title">Título <span class="required">*</span></label>
        <input type="text" id="feature-title" name="title" class="form-input" maxlength="160" required>
      </div>

      <div class="form-group">
        <label class="field-label" for="feature-desc">Descripción</label>
        <textarea id="feature-desc" name="description" class="form-input" rows="3" maxlength="1000"></textarea>
      </div>

      <div class="form-group">
        <label class="field-label" for="feature-detail">Texto detallado</label>
        <textarea id="feature-detail" name="detail_text" class="form-input" rows="3" maxlength="1500"></textarea>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Tipo de icono</label>
          <select name="icon_type" id="feature-icon-type" class="form-input">
            <option value="builtin">Icono integrado</option>
            <option value="media">Imagen de biblioteca</option>
          </select>
        </div>
        <div class="form-group" id="feature-builtin-group">
          <label class="field-label">Ícono integrado</label>
          <select name="icon_key" id="feature-icon-key" class="form-input">
            <option value="">Seleccionar...</option>
            <option value="diseno-3d">Diseño 3D</option>
            <option value="escaneo-3d">Escaneo 3D</option>
            <option value="diseno-grafico">Diseño Gráfico</option>
            <option value="desarrollo-web">Desarrollo Web</option>
            <option value="prendas">Prendas</option>
            <option value="impresion-3d">Impresión 3D</option>
          </select>
        </div>
      </div>

      <div class="form-group" id="feature-media-group" hidden>
        <%- include('../../../components/media-selector', {
          fieldName: 'media_public_id',
          currentValue: '',
          label: 'Icono desde biblioteca',
          kindLabel: 'Icono/Imagen',
          allowedTypes: ['image/png', 'image/jpeg', 'image/webp'],
          allowedCategories: ['icon'],
          uploadProfile: 'feature-icon',
        }) %>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label" for="feature-url">URL (opcional)</label>
          <input type="text" id="feature-url" name="url" class="form-input" maxlength="500">
        </div>
        <div class="form-group">
          <label class="field-label">Tipo de enlace</label>
          <select name="link_type" id="feature-link-type" class="form-input">
            <option value="internal">Interno</option>
            <option value="external">Externo</option>
          </select>
        </div>
        <div class="form-group">
          <label class="field-label">Target</label>
          <select name="target" id="feature-target" class="form-input">
            <option value="_self">Misma pestaña</option>
            <option value="_blank">Nueva pestaña</option>
          </select>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label class="field-label">Variante de estilo</label>
          <select name="style_variant" id="feature-style" class="form-input">
            <option value="">Default</option>
            <option value="default">Default</option>
            <option value="highlight">Highlight</option>
            <option value="minimal">Minimal</option>
          </select>
        </div>
        <div class="form-group">
          <label class="field-label">Visible</label>
          <select name="is_visible" id="feature-visible" class="form-input">
            <option value="1">Sí</option>
            <option value="0">No</option>
          </select>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="feature-submit-btn">Agregar tarjeta</button>
        <button type="button" class="btn btn-secondary" id="feature-cancel-btn" hidden>Cancelar</button>
      </div>
    </form>

    <form method="POST" action="/admin/page/home/panel-3/items/reorder" class="cms-form cms-form--inline" style="margin-top:1rem">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field-label">Reordenar (IDs separados por coma)</label>
      <input type="text" name="ids" class="form-input" value="<%= items.map(i => i.public_id).join(',') %>" style="width:100%">
      <button type="submit" class="btn btn-secondary btn-sm">Actualizar orden</button>
    </form>
  </details>

  <div class="cms-section-footer">
    <form method="POST" action="/admin/page/home/panel-3/items/publish" class="cms-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-success">Publicar tarjetas</button>
    </form>
  </div>
</div>

<!-- ═══ Style tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="style" hidden>
  <form method="POST" action="/admin/page/home/panel-3/draft" class="cms-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <div class="form-group">
        <label class="field-label" for="p3-bg-color">Color de fondo</label>
        <input type="text" id="p3-bg-color" name="backgroundColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.backgroundColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p3-text-color">Color de texto</label>
        <input type="text" id="p3-text-color" name="textColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.textColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p3-accent-color">Color de acento</label>
        <input type="text" id="p3-accent-color" name="accentColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.accentColor || '' %>">
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-primary" name="action" value="draft">Guardar borrador</button>
    </div>
  </form>

  <div class="cms-section-footer">
    <form method="POST" action="/admin/page/home/panel-3/publish" class="cms-form">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <p style="margin-bottom:0.5rem">Publica contenido general y tarjetas de servicios.</p>
      <button type="submit" class="btn btn-success">Publicar Panel 3</button>
    </form>
  </div>
</div>
</div>

<script type="application/json" id="panel3-feature-items-data"><%- safeJsonScript(items.map(function(item) {
  return {
    id: item.public_id,
    title: item.title || '',
    description: item.description || '',
    detail_text: item.detail_text || '',
    icon_type: item.icon_type || 'builtin',
    icon_key: item.icon_key || '',
    media_public_id: item.media_public_id ? 'media://' + item.media_public_id : '',
    media_thumb: item.media_public_id_resolved ? (item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url || '') : '',
    media_title: item.media_public_id_resolved ? (item.media_public_id_resolved.title || '') : '',
    url: item.url || '',
    link_type: item.link_type || 'internal',
    target: item.target || '_self',
    style_variant: item.style_variant || '',
    is_visible: item.is_visible,
    status: item.status,
  };
})) %></script>
