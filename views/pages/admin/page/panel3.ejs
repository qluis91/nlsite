<% const c = content || {}; const s = style || {}; const cmsEditorState = typeof editorState !== 'undefined' ? editorState : null; %>
<div data-cms-editor data-editor-state="<%= cmsEditorState || 'clean' %>">
<div class="page-header">
  <div>
    <h1>Panel 3 — Servicios</h1>
    <p>Contenido general y tarjetas de servicios del panel de cierre.</p>
  </div>
  <div class="cms-actions">
    <span class="cms-editor-state" data-cms-editor-status data-state="<%= cmsEditorState || 'clean' %>"><%= ({ dirty: 'Cambios sin guardar', saving: 'Guardando', saved: 'Borrador guardado', published: 'Publicado', error: 'Error' })[cmsEditorState] || 'Sin cambios' %></span>
  </div>
</div>

<% if (typeof fieldErrors !== 'undefined' && fieldErrors.length) { %>
  <div class="card" role="group" aria-label="Errores de validación">
    <ul class="cms-field-errors"><% fieldErrors.forEach(function (message) { %><li><%= message %></li><% }); %></ul>
  </div>
<% } %>

<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (saved) { %><div class="alert alert-success"><%= saved %></div><% } %>

<!-- ── Tabs ── -->
<nav class="cms-tabs" role="tablist" aria-label="Secciones del Panel 3">
  <button class="cms-tab is-active" role="tab" aria-selected="true" data-tab="general">Contenido general</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="cards">Tarjetas / Características</button>
  <button class="cms-tab" role="tab" aria-selected="false" data-tab="style">Apariencia</button>
</nav>

<!-- ═══ General content tab ═══ -->
<div class="cms-tab-panel is-active" role="tabpanel" data-panel="general">
  <form method="POST" action="/admin/page/home/panel-3/draft" class="cms-form" data-cms-editor-form novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group"><label class="field-label"><input type="checkbox" name="isVisible" value="1" <%= c.isVisible !== false ? 'checked' : '' %>> Panel visible al publicar</label></div>

    <div class="form-group">
      <label class="field-label" for="p3-eyebrow">Kicker / Etiqueta superior</label>
      <input type="text" id="p3-eyebrow" name="eyebrow" class="form-input" maxlength="120" value="<%= c.eyebrow || '' %>">
      <span class="char-counter"><%= (c.eyebrow || '').length %>/120</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p3-heading">Encabezado principal <span class="required">*</span></label>
      <input type="text" id="p3-heading" name="heading" class="form-input" maxlength="220" required value="<%= c.heading || '' %>">
      <span class="char-counter"><%= (c.heading || '').length %>/220</span>
    </div>

    <div class="form-group">
      <label class="field-label" for="p3-desc">Descripción</label>
      <textarea id="p3-desc" name="description" class="form-input" rows="3" maxlength="1200"><%= c.description || '' %></textarea>
      <span class="char-counter"><%= (c.description || '').length %>/1200</span>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="field-label" for="p3-carousel-label">Etiqueta del carrusel</label><input id="p3-carousel-label" name="carouselAriaLabel" class="form-input" maxlength="160" value="<%= c.carouselAriaLabel || 'Servicios de NinjaLab' %>"></div>
      <div class="form-group"><label class="field-label" for="p3-controls-label">Etiqueta de controles</label><input id="p3-controls-label" name="carouselControlsAriaLabel" class="form-input" maxlength="160" value="<%= c.carouselControlsAriaLabel || 'Controles del carrusel' %>"></div>
    </div>
    <div class="form-row">
      <div class="form-group"><label class="field-label" for="p3-prev-label">Etiqueta anterior</label><input id="p3-prev-label" name="carouselPreviousLabel" class="form-input" maxlength="100" value="<%= c.carouselPreviousLabel || 'Servicio anterior' %>"></div>
      <div class="form-group"><label class="field-label" for="p3-next-label">Etiqueta siguiente</label><input id="p3-next-label" name="carouselNextLabel" class="form-input" maxlength="100" value="<%= c.carouselNextLabel || 'Servicio siguiente' %>"></div>
      <div class="form-group"><label class="field-label" for="p3-button-label">Etiqueta CTA predeterminada</label><input id="p3-button-label" name="defaultButtonLabel" class="form-input" maxlength="80" value="<%= c.defaultButtonLabel || 'VER DETALLE' %>"></div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn btn-save" name="action" value="draft">Guardar cambios</button>
    </div>
  </form>
</div>

<!-- ═══ Cards tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="cards" hidden>
  <div class="cms-section-header">
    <h3>Tarjetas de servicios</h3>
    <div class="cms-section-header__actions">
      <span class="badge"><%= items.filter(i => i.status === 'published').length %> publicadas · <%= items.filter(i => i.status === 'draft').length %> borradores · <%= items.length %> total</span>
      <button type="button" class="btn btn-primary"
              data-item-editor-open data-editor-type="feature" data-mode="create" data-feature-add>Agregar tarjeta</button>
    </div>
  </div>

  <table class="cms-table">
    <thead>
      <tr><th>Icono</th><th>Título</th><th>Descripción</th><th>Visible</th><th>Estado</th><th>Orden</th><th>Acciones</th></tr>
    </thead>
    <tbody>
      <% items.forEach(function(item) { %>
        <tr>
          <td>
            <% if (item.icon_type === 'builtin') { %>
              <span class="badge"><%= item.icon_key %></span>
            <% } else if (item.media_public_id_resolved) { %>
              <img src="<%= item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url %>" style="max-width:30px;max-height:30px" alt="">
            <% } else { %>
              <em>Sin icono</em>
            <% } %>
          </td>
          <td><strong><%= item.title %></strong></td>
          <td><small><%= (item.description || '').substring(0, 100) %></small></td>
          <td><%= item.is_visible ? 'Sí' : 'No' %></td>
          <td><span class="badge badge-<%= item.status === 'published' ? 'published' : 'draft' %>"><%= item.status %></span></td>
          <td><%= item.sort_order %></td>
          <td class="cms-actions-cell">
            <button type="button" class="btn btn-sm btn-secondary"
                    data-item-editor-open data-editor-type="feature" data-mode="edit"
                    data-item-id="<%= item.public_id %>" data-feature-edit-id="<%= item.public_id %>">Editar</button>
            <form method="POST" action="/admin/page/home/panel-3/items/archive" class="cms-form--inline">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <input type="hidden" name="public_id" value="<%= item.public_id %>">
              <button type="submit" class="btn btn-sm btn-danger">Archivar</button>
            </form>
          </td>
        </tr>
      <% }); %>
    </tbody>
  </table>


  <div class="cms-card">
    <form method="POST" action="/admin/page/home/panel-3/items/reorder" class="cms-form cms-form--inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <label class="field-label">Reordenar (IDs separados por coma)</label>
      <input type="text" name="ids" class="form-input" value="<%= items.map(i => i.public_id).join(',') %>" style="width:100%">
      <button type="submit" class="btn btn-secondary btn-sm">Actualizar orden</button>
    </form>
  </div>

  <div class="cms-section-footer">
    <form method="POST" action="/admin/page/home/panel-3/items/publish" class="cms-form" data-cms-publish-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-publish">Publicar tarjetas</button>
    </form>
  </div>
</div>

<!-- ═══ Style tab ═══ -->
<div class="cms-tab-panel" role="tabpanel" data-panel="style" hidden>
  <form method="POST" action="/admin/page/home/panel-3/draft" id="panel3-settings-form" class="cms-form" data-cms-editor-form novalidate>
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

    <div class="form-row">
      <div class="form-group">
        <label class="field-label" for="p3-bg-color">Color de fondo</label>
        <input type="text" id="p3-bg-color" name="backgroundColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.backgroundColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p3-text-color">Color de texto</label>
        <input type="text" id="p3-text-color" name="textColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.textColor || '' %>">
      </div>
      <div class="form-group">
        <label class="field-label" for="p3-accent-color">Color de acento</label>
        <input type="text" id="p3-accent-color" name="accentColor" class="form-input" placeholder="#RRGGBB" pattern="#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?" value="<%= s.accentColor || '' %>">
      </div>
    </div>
  </form>

  <div class="sticky-actions">
    <span class="cms-editor-state" data-cms-editor-status data-state="<%= cmsEditorState || 'clean' %>">Sin cambios</span>
    <button type="submit" class="btn btn-save" name="action" value="draft" form="panel3-settings-form">Guardar cambios</button>
    <button type="submit" form="panel3-publish-form" class="btn btn-publish">Publicar Panel 3</button>
  </div>
</div>
<form id="panel3-publish-form" method="POST" action="/admin/page/home/panel-3/publish" style="display:none" data-cms-publish-form>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
</form>

<% /* Drawer form partial preserves the existing components/media-selector integration. */ %>
<%- include('../../../components/admin/item-editor-drawer', {
  kind: 'feature',
  createTitle: 'Agregar tarjeta',
  editTitle: 'Editar tarjeta',
  formPartial: '../../pages/admin/page/partials/feature-form',
  formLocals: {
    csrfToken: csrfToken,
    canPublish: typeof capabilities !== 'undefined' && capabilities.includes('home.services.publish'),
    fieldErrors: typeof fieldErrors !== 'undefined' ? fieldErrors : [],
    submittedKind: typeof submittedItem !== 'undefined' && submittedItem ? submittedItem.kind : null
  }
}) %>
</div>
</div>

<script type="application/json" id="panel3-submitted-item-data"><%- safeJsonScript(typeof submittedItem !== 'undefined' ? submittedItem : null) %></script>
<script type="application/json" id="panel3-feature-items-data"><%- safeJsonScript(items.map(function(item) {
  return {
    id: item.public_id,
    title: item.title || '',
    description: item.description || '',
    detail_text: item.detail_text || '',
    button_label: item.button_label || 'VER DETALLE',
    icon_type: item.icon_type || 'builtin',
    icon_key: item.icon_key || '',
    media_public_id: item.media_public_id ? 'media://' + item.media_public_id : '',
    media_thumb: item.media_public_id_resolved ? (item.media_public_id_resolved.thumbnail_url || item.media_public_id_resolved.url || '') : '',
    media_title: item.media_public_id_resolved ? (item.media_public_id_resolved.title || '') : '',
    media_alt: item.media_alt || '',
    url: item.url || '',
    link_aria_label: item.link_aria_label || '',
    link_type: item.link_type || 'internal',
    target: item.target || '_self',
    style_variant: item.style_variant || '',
    is_visible: item.is_visible,
    status: item.status,
  };
})) %></script>
</div>
