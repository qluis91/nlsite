<div class="auth-container">
  <div class="auth-card">
    <h2>Reenviar verificación</h2>
    <p class="auth-subtitle">Ingresa tu correo para recibir un nuevo enlace</p>

    <form action="/auth/resend-verification" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" class="form-control"
               placeholder="tu@email.com" required autocomplete="email" autofocus>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Enviar enlace</button>
    </form>

    <p class="auth-footer">
      <a href="/auth/login">Volver a iniciar sesión</a>
    </p>
  </div>
</div>
