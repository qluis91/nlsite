<main class="st-layout">
  <%- include('../components/store-sidebar') %>

  <div class="st-main">
    <header class="st-header">
      <div class="st-header__row">
        <form class="st-search" action="/tienda" method="get" role="search">
          <label class="st-search__label" for="store-search">Buscar productos</label>
          <input
            id="store-search"
            class="st-search__input"
            type="search"
            name="search"
            value="<%= catalog.filters.search %>"
            maxlength="100"
            placeholder="Buscar en la tienda..."
            autocomplete="off"
          >
          <% if (catalog.filters.category) { %><input type="hidden" name="category" value="<%= catalog.filters.category %>"><% } %>
          <button class="st-search__submit" type="submit" aria-label="Buscar">
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18">
              <circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <path d="m16.5 16.5 4 4" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </form>

        <div class="st-header__meta">
          <p class="st-header__count" aria-live="polite">
            <strong><%= catalog.totalProducts %></strong> <%= catalog.totalProducts === 1 ? 'producto' : 'productos' %>
          </p>

          <form class="st-sort" method="get" action="/tienda" data-store-sort-form>
            <% if (catalog.filters.search) { %><input type="hidden" name="search" value="<%= catalog.filters.search %>"><% } %>
            <% if (catalog.filters.category) { %><input type="hidden" name="category" value="<%= catalog.filters.category %>"><% } %>
            <% if (catalog.filters.inStock) { %><input type="hidden" name="inStock" value="<%= catalog.filters.inStock %>"><% } %>
            <label for="store-sort-select" class="st-sort__label">Ordenar:</label>
            <select id="store-sort-select" name="sort" class="st-sort__select" data-store-sort>
              <option value="featured" <%= catalog.filters.sort === 'featured' ? 'selected' : '' %>>Destacados</option>
              <option value="newest" <%= catalog.filters.sort === 'newest' ? 'selected' : '' %>>Más recientes</option>
              <option value="price-asc" <%= catalog.filters.sort === 'price-asc' ? 'selected' : '' %>>Menor precio</option>
              <option value="price-desc" <%= catalog.filters.sort === 'price-desc' ? 'selected' : '' %>>Mayor precio</option>
              <option value="name-asc" <%= catalog.filters.sort === 'name-asc' ? 'selected' : '' %>>Nombre A–Z</option>
              <option value="name-desc" <%= catalog.filters.sort === 'name-desc' ? 'selected' : '' %>>Nombre Z–A</option>
            </select>
          </form>
        </div>
      </div>

      <% if (activeFilters.length) { %>
        <div class="st-active-filters" aria-label="Filtros activos">
          <% activeFilters.forEach(function(filter) { %>
            <a class="st-chip" href="<%= filter.removeUrl %>">
              <%= filter.label %>
              <span aria-hidden="true">&times;</span>
            </a>
          <% }); %>
          <a class="st-chip st-chip--clear" href="/tienda">Limpiar filtros</a>
        </div>
      <% } %>
    </header>

    <%- include('../components/store-hero', { storeHero: storeHero }) %>

    <section class="st-catalog" aria-label="Catálogo de productos">
      <% if (catalogError) { %>
        <div class="st-empty" role="status">
          <h3>No pudimos cargar el catálogo.</h3>
          <p>Inténtalo nuevamente en unos minutos.</p>
          <a href="/tienda">Reintentar</a>
        </div>
      <% } else if (catalog.totalCatalogProducts === 0) { %>
        <div class="st-empty" role="status">
          <h3>Todavía no hay productos disponibles.</h3>
          <p>Estamos preparando el catálogo público de NinjaLab.</p>
          <a href="/">Volver al inicio</a>
        </div>
      <% } else if (catalog.products.length === 0) { %>
        <div class="st-empty" role="status">
          <h3>No encontramos productos con esos filtros.</h3>
          <p>Prueba con otra búsqueda o elimina algunos filtros.</p>
          <div>
            <a href="/tienda" class="btn">Ver todos los productos</a>
          </div>
        </div>
      <% } else { %>
        <ul class="st-grid">
          <% catalog.products.forEach(function(product, index) { %>
            <%- include('../components/store-card', { product: product, idx: index }) %>
          <% }); %>
        </ul>
      <% } %>

      <% if (!catalogError && catalog.totalPages > 1) { %>
        <nav class="st-pagination" aria-label="Paginación del catálogo">
          <% if (catalog.filters.page > 1) { %>
            <a href="<%= buildStoreUrl({ page: catalog.filters.page - 1 }) %>" rel="prev" aria-label="Página anterior">Anterior</a>
          <% } else { %>
            <span class="is-disabled" aria-disabled="true">Anterior</span>
          <% } %>

          <ol class="st-pagination__pages">
            <% paginationPages.forEach(function(page) { %>
              <li>
                <% if (page === 'ellipsis') { %>
                  <span aria-hidden="true">&hellip;</span>
                <% } else if (page === catalog.filters.page) { %>
                  <span class="is-current" aria-current="page"><%= page %></span>
                <% } else { %>
                  <a href="<%= buildStoreUrl({ page }) %>" aria-label="Página <%= page %>"><%= page %></a>
                <% } %>
              </li>
            <% }); %>
          </ol>

          <% if (catalog.filters.page < catalog.totalPages) { %>
            <a href="<%= buildStoreUrl({ page: catalog.filters.page + 1 }) %>" rel="next" aria-label="Página siguiente">Siguiente</a>
          <% } else { %>
            <span class="is-disabled" aria-disabled="true">Siguiente</span>
          <% } %>
        </nav>
      <% } %>
    </section>
  </div>
</main>
