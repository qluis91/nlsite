<%- include('../components/home-navbar', { navbarOnHome: false }) %>

<main class="store-page" data-store-page>
  <header class="store-hero">
    <div class="store-layout">
      <p class="store-hero__eyebrow">CATÁLOGO NINJALAB</p>
      <h1 class="store-hero__title">Tienda NinjaLab</h1>
      <div class="store-hero__footer">
        <p class="store-hero__description">
          Explora piezas, figuras, diseños y productos creados con precisión en impresión 3D.
        </p>
        <p class="store-hero__summary">
          <% if (catalog.totalProducts === 1) { %>
            1 producto
          <% } else { %>
            <%= catalog.totalProducts %> productos
          <% } %>
        </p>
      </div>
      <% if (catalog.filters.search) { %>
        <p class="store-hero__search-summary">Resultados para “<%= catalog.filters.search %>”</p>
      <% } %>
      <% if (catalog.filters.searchWasTruncated) { %>
        <p class="store-hero__notice">La búsqueda se limitó a 100 caracteres.</p>
      <% } %>
    </div>
  </header>

  <div class="store-layout store-workspace">
    <button
      class="store-filter-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="store-filters"
      data-store-filter-toggle
    >
      Filtros<% if (activeFilterCount) { %> (<%= activeFilterCount %>)<% } %>
    </button>

    <button class="store-filter-backdrop" type="button" aria-label="Cerrar filtros" data-store-filter-backdrop hidden></button>

    <aside id="store-filters" class="store-filters" aria-labelledby="store-filters-title" data-store-filters>
      <div class="store-filters__header">
        <h2 id="store-filters-title">Filtrar productos</h2>
        <button class="store-filters__close" type="button" aria-label="Cerrar filtros" data-store-filter-close>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"></path></svg>
        </button>
      </div>

      <nav class="store-filter-group" aria-label="Categorías de productos">
        <h3>Categorías</h3>
        <a class="store-filter-link <%= !catalog.filters.category ? 'is-active' : '' %>" href="<%= buildStoreUrl({ category: '', page: 1 }) %>">
          Todos los productos
        </a>
        <% categories.forEach(function(category) { %>
          <a
            class="store-filter-link <%= catalog.filters.category === category.slug ? 'is-active' : '' %>"
            href="<%= buildStoreUrl({ category: category.slug, page: 1 }) %>"
          ><%= category.name %></a>
        <% }); %>
        <% if (categories.length === 0) { %>
          <p class="store-filter-group__empty">Sin categorías publicadas.</p>
        <% } %>
      </nav>

      <nav class="store-filter-group" aria-label="Disponibilidad">
        <h3>Disponibilidad</h3>
        <a class="store-filter-link <%= !catalog.filters.inStock ? 'is-active' : '' %>" href="<%= buildStoreUrl({ inStock: '', page: 1 }) %>">Todos</a>
        <a class="store-filter-link <%= catalog.filters.inStock === 'true' ? 'is-active' : '' %>" href="<%= buildStoreUrl({ inStock: 'true', page: 1 }) %>">Disponibles</a>
        <a class="store-filter-link <%= catalog.filters.inStock === 'false' ? 'is-active' : '' %>" href="<%= buildStoreUrl({ inStock: 'false', page: 1 }) %>">Agotados</a>
      </nav>

      <a class="store-filters__clear" href="/tienda">Limpiar filtros</a>
    </aside>

    <section class="store-catalog" aria-labelledby="store-catalog-title">
      <h2 id="store-catalog-title" class="store-visually-hidden">Productos</h2>

      <% if (activeFilters.length) { %>
        <div class="store-active-filters" aria-label="Filtros activos">
          <% activeFilters.forEach(function(filter) { %>
            <a class="store-filter-chip" href="<%= filter.removeUrl %>">
              <span><%= filter.label %></span>
              <span aria-hidden="true">×</span>
            </a>
          <% }); %>
          <% if (activeFilters.length > 1) { %>
            <a class="store-active-filters__clear" href="/tienda">Limpiar filtros</a>
          <% } %>
        </div>
      <% } %>

      <div class="store-toolbar">
        <p class="store-toolbar__count" aria-live="polite">
          <strong><%= catalog.totalProducts %></strong>
          <%= catalog.totalProducts === 1 ? 'producto' : 'productos' %>
        </p>

        <form class="store-sort" method="get" action="/tienda" data-store-sort-form>
          <% if (catalog.filters.search) { %><input type="hidden" name="search" value="<%= catalog.filters.search %>"><% } %>
          <% if (catalog.filters.category) { %><input type="hidden" name="category" value="<%= catalog.filters.category %>"><% } %>
          <% if (catalog.filters.inStock) { %><input type="hidden" name="inStock" value="<%= catalog.filters.inStock %>"><% } %>
          <% if (catalog.filters.limit !== 12) { %><input type="hidden" name="limit" value="<%= catalog.filters.limit %>"><% } %>
          <label for="store-sort">Ordenar</label>
          <select id="store-sort" name="sort" data-store-sort>
            <option value="featured" <%= catalog.filters.sort === 'featured' ? 'selected' : '' %>>Destacados</option>
            <option value="newest" <%= catalog.filters.sort === 'newest' ? 'selected' : '' %>>Más recientes</option>
            <option value="price-asc" <%= catalog.filters.sort === 'price-asc' ? 'selected' : '' %>>Precio: menor a mayor</option>
            <option value="price-desc" <%= catalog.filters.sort === 'price-desc' ? 'selected' : '' %>>Precio: mayor a menor</option>
            <option value="name-asc" <%= catalog.filters.sort === 'name-asc' ? 'selected' : '' %>>Nombre A–Z</option>
          </select>
          <button class="store-sort__submit" type="submit">Aplicar</button>
        </form>
      </div>

      <% if (catalogError) { %>
        <div class="store-empty-state" role="status">
          <h3>No pudimos cargar el catálogo.</h3>
          <p>Inténtalo nuevamente en unos minutos.</p>
          <a href="/tienda">Reintentar</a>
        </div>
      <% } else if (catalog.totalCatalogProducts === 0) { %>
        <div class="store-empty-state" role="status">
          <h3>Todavía no hay productos disponibles.</h3>
          <p>Estamos preparando el catálogo público de NinjaLab.</p>
          <a href="/">Volver al inicio</a>
        </div>
      <% } else if (catalog.products.length === 0) { %>
        <div class="store-empty-state" role="status">
          <h3>No encontramos productos con esos filtros.</h3>
          <p>Prueba con otra búsqueda o elimina algunos filtros.</p>
          <div class="store-empty-state__actions">
            <a href="/tienda">Limpiar filtros</a>
            <a href="/tienda">Ver todos los productos</a>
          </div>
        </div>
      <% } else { %>
        <ul class="store-product-grid">
          <% catalog.products.forEach(function(product, index) { %>
            <li>
              <article class="store-product-card">
                <a class="store-product-card__image-link" href="<%= product.url %>" aria-label="Ver <%= product.title %>">
                  <div class="store-product-card__media">
                    <% if (product.image) { %>
                      <img
                        src="<%= product.image %>"
                        alt="<%= product.title %>"
                        width="<%= product.imageWidth %>"
                        height="<%= product.imageHeight %>"
                        loading="<%= index < 4 ? 'eager' : 'lazy' %>"
                        decoding="async"
                      >
                    <% } else { %>
                      <span class="store-product-card__image-placeholder" aria-hidden="true">NINJALAB</span>
                    <% } %>
                  </div>
                </a>
                <div class="store-product-card__body">
                  <% if (product.categoryName) { %><p class="store-product-card__category"><%= product.categoryName %></p><% } %>
                  <h3 class="store-product-card__title"><a href="<%= product.url %>"><%= product.title %></a></h3>
                  <% if (product.description) { %><p class="store-product-card__description"><%= product.description %></p><% } %>
                  <div class="store-product-card__meta">
                    <p class="store-product-card__price"><%= product.priceLabel %></p>
                    <p class="store-product-card__availability <%= product.inStock ? 'is-available' : 'is-sold-out' %>"><%= product.availability %></p>
                  </div>
                </div>
              </article>
            </li>
          <% }); %>
        </ul>
      <% } %>

      <% if (!catalogError && catalog.totalPages > 1) { %>
        <nav class="store-pagination" aria-label="Paginación del catálogo">
          <% if (catalog.filters.page > 1) { %>
            <a href="<%= buildStoreUrl({ page: catalog.filters.page - 1 }) %>" rel="prev" aria-label="Página anterior">Anterior</a>
          <% } else { %>
            <span class="is-disabled" aria-disabled="true">Anterior</span>
          <% } %>

          <ol>
            <% paginationPages.forEach(function(page) { %>
              <li>
                <% if (page === 'ellipsis') { %>
                  <span aria-hidden="true">…</span>
                <% } else if (page === catalog.filters.page) { %>
                  <span class="is-current" aria-current="page"><%= page %></span>
                <% } else { %>
                  <a href="<%= buildStoreUrl({ page }) %>" aria-label="Página <%= page %>"><%= page %></a>
                <% } %>
              </li>
            <% }); %>
          </ol>

          <% if (catalog.filters.page < catalog.totalPages) { %>
            <a href="<%= buildStoreUrl({ page: catalog.filters.page + 1 }) %>" rel="next" aria-label="Página siguiente">Siguiente</a>
          <% } else { %>
            <span class="is-disabled" aria-disabled="true">Siguiente</span>
          <% } %>
        </nav>
      <% } %>
    </section>
  </div>
</main>
