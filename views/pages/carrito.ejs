<%- include('../components/home-navbar', { navbarOnHome: false }) %>

<main class="cart-page" data-cart-page>
  <div class="store-layout">

    <nav class="pd-breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/tienda">Tienda</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Carrito</span>
    </nav>

    <h1 class="cart-title">Tu carrito</h1>

    <% if (removedCount > 0) { %>
      <div class="alert alert-warning" role="alert">
        Algunos productos ya no están disponibles y fueron retirados del carrito.
      </div>
    <% } %>

    <% if (!cart.items.length) { %>
      <div class="cart-empty" role="status">
        <p class="cart-empty__text">Tu carrito está vacío.</p>
        <p class="cart-empty__hint">Explora la tienda y agrega productos.</p>
        <a href="/tienda" class="cart-empty__link">Ir a la tienda</a>
      </div>
    <% } else { %>
      <div class="cart-layout">
        <!-- Items -->
        <div class="cart-items" role="list" aria-label="Artículos en tu carrito">
          <% cart.items.forEach(function(item) { %>
            <div class="cart-item <%= item.available ? '' : 'cart-item--unavailable' %>" role="listitem">
              <div class="cart-item__media">
                <a href="<%= item.url %>" aria-label="Ver <%= item.title %>">
                  <% if (item.primaryImage) { %>
                    <img src="<%= item.primaryImage %>" alt="<%= item.title %>" loading="lazy" width="<%= item.imageWidth || 200 %>" height="<%= item.imageHeight || 200 %>">
                  <% } else { %>
                    <span class="cart-item__placeholder" aria-hidden="true">NINJALAB</span>
                  <% } %>
                </a>
              </div>

              <div class="cart-item__details">
                <h2 class="cart-item__title">
                  <a href="<%= item.url %>"><%= item.title %></a>
                </h2>

                <p class="cart-item__price">
                  <span class="cart-item__unit-price"><%= item.priceLabel %></span>
                  <% if (item.hasPromotion && item.regularPrice > item.displayPrice) { %>
                    <span class="cart-item__price-regular">
                      <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(item.regularPrice) %>
                    </span>
                  <% } %>
                </p>

                <p class="cart-item__stock <%= item.available ? 'is-available' : 'is-sold-out' %>">
                  <% if (item.available) { %>
                    Disponible
                  <% } else { %>
                    Este producto está agotado.
                  <% } %>
                </p>
              </div>

              <div class="cart-item__actions">
                <% if (item.available) { %>
                  <form action="/carrito/actualizar" method="post" class="cart-item__quantity-form">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="productId" value="<%= item.productId %>">
                    <label for="qty-<%= item.productId %>" class="cart-item__qty-label">Cantidad</label>
                    <div class="pd-quantity__control">
                      <button type="button" class="pd-quantity__btn cart-qty-dec" data-qty-target="qty-<%= item.productId %>" aria-label="Reducir cantidad de <%= item.title %>">−</button>
                      <input
                        id="qty-<%= item.productId %>"
                        type="number"
                        name="quantity"
                        min="1"
                        max="<%= Math.min(item.stockQuantity, 99) %>"
                        value="<%= item.quantity %>"
                        inputmode="numeric"
                        class="cart-item__qty-input"
                      >
                      <button type="button" class="pd-quantity__btn cart-qty-inc" data-qty-target="qty-<%= item.productId %>" aria-label="Aumentar cantidad de <%= item.title %>">+</button>
                    </div>
                    <button type="submit" class="cart-item__qty-update">Actualizar</button>
                  </form>
                <% } %>

                <div class="cart-item__line-total">
                  <span class="cart-item__line-label">Subtotal</span>
                  <span class="cart-item__line-value">
                    <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(item.lineTotal) %>
                  </span>
                </div>

                <form action="/carrito/eliminar" method="post" class="cart-item__remove-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="productId" value="<%= item.productId %>">
                  <button type="submit" class="cart-item__remove" aria-label="Eliminar <%= item.title %> del carrito">
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M19 6l-.87 12.14A2 2 0 0 1 16.14 20H7.86a2 2 0 0 1-1.99-1.86L5 6"/></svg>
                    Eliminar
                  </button>
                </form>
              </div>
            </div>
          <% }); %>
        </div>

        <!-- Summary -->
        <aside class="cart-summary" aria-labelledby="cart-summary-title">
          <h2 id="cart-summary-title" class="cart-summary__title">Resumen</h2>

          <div class="cart-summary__row">
            <span>Productos</span>
            <span><%= cart.uniqueItemCount %></span>
          </div>
          <div class="cart-summary__row">
            <span>Cantidad total</span>
            <span><%= cart.itemCount %></span>
          </div>
          <div class="cart-summary__row cart-summary__row--total">
            <span>Subtotal</span>
            <span>
              <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(cart.subtotal) %>
            </span>
          </div>

          <p class="cart-summary__disclaimer">Los precios y la disponibilidad se confirmarán nuevamente al continuar con la compra.</p>

          <% if (cart.items.some(i => i.available)) { %>
            <a href="/checkout" class="cart-summary__checkout cart-summary__checkout--enabled">
              Continuar con la compra
            </a>
          <% } else { %>
            <p class="cart-summary__checkout-notice">No hay productos disponibles para comprar. Revisa los artículos agotados.</p>
          <% } %>

          <a href="/tienda" class="cart-summary__continue">← Seguir comprando</a>

          <form action="/carrito/vaciar" method="post" class="cart-summary__clear-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="cart-summary__clear" onclick="return confirm('¿Estás seguro de vaciar el carrito?')">
              Vaciar carrito
            </button>
          </form>
        </aside>
      </div>
    <% } %>

  </div>
</main>
