<%- include('../../components/home-navbar', { navbarOnHome: false }) %>
<%
  const fv = typeof formValues !== 'undefined' && formValues ? formValues : {};
  const val = function (key, fallback) {
    if (Object.prototype.hasOwnProperty.call(fv, key) && fv[key] != null && fv[key] !== '') return fv[key];
    return fallback == null ? '' : fallback;
  };
%>
<div class="quote-page" data-quote-3d>
  <section class="quote-hero">
    <span class="svc-eyebrow" style="color:var(--color-accent,#39ff14)">Cotización a tu medida</span>
    <h1>Cotización personalizada 3D</h1>
    <p>Contanos qué querés imprimir: subí hasta 5 imágenes de referencia, agregá las medidas y, si tenés un archivo 3D, pegá el link. Nuestro equipo revisa tu proyecto para preparar una cotización personalizada.</p>
    <div class="quote-hero__facts">
      <span>Respuesta personalizada</span>
      <span>Hasta 5 imágenes</span>
      <span>Soporta link de archivo 3D</span>
    </div>
  </section>

  <div class="quote-layout">
    <form
      id="cotizacion-form"
      class="quote-form"
      method="POST"
      action="/cotizar/pieza-3d"
      enctype="multipart/form-data"
      novalidate
      data-max-image-files="<%= maxImageFiles || 5 %>"
      data-max-image-bytes="<%= maxImageBytes || 12582912 %>"
      data-max-image-mb="<%= maxImageMb || 12 %>"
    >
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="reference_id" value="<%= referenceId || val('reference_id') %>">
      <input type="hidden" name="reference_product" value="<%= referenceName || val('reference_product') %>">

      <div class="quote-form__header">
        <h2>Tus datos</h2>
      </div>
      <div class="quote-grid">
        <label class="quote-field">Nombre completo *<input id="cot-name" name="customer_name" type="text" autocomplete="name" required maxlength="150" value="<%= val('customer_name', prefill.name || '') %>"></label>
        <label class="quote-field">Correo electrónico *<input id="cot-email" name="customer_email" type="email" autocomplete="email" required maxlength="180" value="<%= val('customer_email', prefill.email || '') %>"></label>
        <label class="quote-field">Teléfono / WhatsApp *<input id="cot-phone" name="customer_phone" type="tel" autocomplete="tel" required maxlength="80" value="<%= val('customer_phone', prefill.phone || '') %>"></label>
      </div>

      <div class="quote-form__header" style="margin-top:1.25rem">
        <h2>Datos de la pieza</h2>
        <p>Indicá al menos el ancho y la altura de la pieza en milímetros. La profundidad es opcional.</p>
      </div>

      <label class="quote-field quote-field--block">Descripción del proyecto
        <textarea id="cot-description" name="description" rows="4" maxlength="5000" placeholder="Contanos qué necesitás imprimir, cantidad, color, acabado, fecha estimada, etc."><%= val('description') %></textarea>
      </label>

      <div class="quote-grid">
        <label class="quote-field">Ancho X (mm) *
          <input id="cot-width" name="width" type="number" min="0.1" step="0.1" required placeholder="Obligatorio" value="<%= val('width') %>">
        </label>
        <label class="quote-field">Profundidad Y (mm)
          <input id="cot-depth" name="depth" type="number" min="0.1" step="0.1" placeholder="Opcional" value="<%= val('depth') %>">
        </label>
        <label class="quote-field">Altura Z (mm) *
          <input id="cot-height" name="height" type="number" min="0.1" step="0.1" required placeholder="Obligatorio" value="<%= val('height') %>">
        </label>
        <label class="quote-field">Cantidad
          <input id="cot-quantity" name="quantity" type="number" min="1" step="1" value="<%= val('quantity', '1') %>">
        </label>
        <label class="quote-field">Material preferido
          <select id="cot-material" name="material">
            <% const mat = val('material'); %>
            <option value="" <%= !mat ? 'selected' : '' %>>Sin preferencia</option>
            <option value="PLA" <%= mat === 'PLA' ? 'selected' : '' %>>PLA</option>
            <option value="PETG" <%= mat === 'PETG' ? 'selected' : '' %>>PETG</option>
            <option value="ABS" <%= mat === 'ABS' ? 'selected' : '' %>>ABS</option>
            <option value="TPU" <%= mat === 'TPU' ? 'selected' : '' %>>TPU</option>
            <option value="Resina" <%= mat === 'Resina' ? 'selected' : '' %>>Resina</option>
          </select>
        </label>
      </div>

      <label class="quote-upload" for="cot-images">
        <input id="cot-images" name="images" type="file" accept="image/*" multiple>
        <span>Subir imágenes de referencia (hasta <%= maxImageFiles || 5 %>)</span>
        <small>PNG, JPG o WEBP. Máximo <%= maxImageFiles || 5 %> imágenes de <%= maxImageMb || 12 %> MB cada una. Se optimizan automáticamente.</small>
      </label>
      <div class="cotizacion-previews" id="cot-previews" hidden></div>

      <label class="quote-field quote-field--block">Link de archivo 3D (opcional)
        <input id="cot-file-link" name="file_link" type="url" maxlength="1000" placeholder="https://www.thingiverse.com/... o tu enlace de Drive/MakerWorld" value="<%= val('file_link') %>">
      </label>

      <p id="cotizacion-ref" class="quote-ref" <%= (referenceName || val('reference_product')) ? '' : 'hidden' %>>
        <% const refLabel = referenceName || val('reference_product'); %>
        <% if (refLabel) { %>Pieza de referencia: <%= refLabel %><% } %>
      </p>

      <button id="cotizacion-submit" class="quote-submit" type="submit">Enviar cotización</button>
      <p id="cotizacion-msg" class="quote-form-msg" hidden aria-live="polite"></p>
    </form>

    <aside class="quote-side">
      <h2>¿Cómo funciona?</h2>
      <ol>
        <li>Completá tus datos y las medidas principales.</li>
        <li>Subí imágenes de referencia y/o el link de tu archivo 3D.</li>
        <li>Te contactamos con una cotización personalizada.</li>
      </ol>
      <% if (whatsappUrl) { %>
        <p style="margin-top:1rem"><a href="<%= whatsappUrl %>" target="_blank" rel="noopener noreferrer">Escribinos por WhatsApp</a></p>
      <% } %>
    </aside>
  </div>
</div>
