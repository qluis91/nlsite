<%- include('../components/home-navbar', { navbarOnHome: false }) %>

<main class="gallery-page" data-gallery-page data-requested-view="<%= filters.view %>">
  <div class="gallery-shell gallery-content">
    <% if (invalidCategory) { %>
      <p class="gallery-notice" role="status">La categoría solicitada no existe o no está disponible. Mostramos toda la galería.</p>
    <% } %>

    <section class="gallery-filters" aria-labelledby="gallery-filters-title">
      <h1 id="gallery-filters-title" data-gallery-animate="entry">Explora galería</h1>
      <nav class="gallery-filter-group gallery-category-chips" aria-label="Categorías" data-gallery-animate="entry">
        <span>Categorías</span>
        <a href="<%= buildGalleryUrl({ category: '', page: 1 }) %>" <% if (!filters.category) { %>aria-current="true"<% } %>>Todos</a>
        <% categories.forEach(function(category) { %>
          <a
            href="<%= buildGalleryUrl({ category: category.slug, page: 1 }) %>"
            <% if (filters.category === category.slug) { %>aria-current="true"<% } %>
          ><%= category.name %></a>
        <% }); %>
      </nav>
      <form class="gallery-category-select" action="/galeria" method="get" data-gallery-category-form data-gallery-animate="entry">
        <label for="gallery-category-select">Categoría</label>
        <select id="gallery-category-select" name="categoria" data-gallery-category-select>
          <option value="" <% if (!filters.category) { %>selected<% } %>>Todos</option>
          <% categories.forEach(function(category) { %>
            <option value="<%= category.slug %>" <% if (filters.category === category.slug) { %>selected<% } %>><%= category.name %></option>
          <% }); %>
        </select>
        <% if (filters.type) { %><input type="hidden" name="tipo" value="<%= filters.type %>"><% } %>
        <input type="hidden" name="view" value="<%= filters.view %>">
        <noscript><button type="submit">Aplicar categoría</button></noscript>
      </form>
    </section>

    <section class="gallery-results" aria-labelledby="gallery-results-title">
      <div class="gallery-results__header">
        <div data-gallery-animate="entry">
          <h2 id="gallery-results-title"><%= activeCategory ? activeCategory.name : 'Imágenes' %></h2>
          <p>Selecciona un elemento para abrir el visor.</p>
        </div>
        <nav class="gallery-view-switcher" aria-label="Visualización de galería" data-gallery-animate="entry">
          <a class="gallery-view-switcher__item" href="<%= buildGalleryUrl({ view: 'infinite' }) %>" data-gallery-view="infinite" <% if (filters.view === 'infinite') { %>aria-current="true"<% } %>>Menú infinito</a>
          <a class="gallery-view-switcher__item" href="<%= buildGalleryUrl({ view: 'grid' }) %>" data-gallery-view="grid" <% if (filters.view === 'grid') { %>aria-current="true"<% } %>>Cuadrícula</a>
        </nav>
      </div>

      <% if (!items.length) { %>
        <div class="gallery-empty" role="status">
          <h3>Todavía no hay proyectos publicados en esta categoría.</h3>
          <p>Prueba con otro filtro o vuelve a consultar pronto.</p>
          <a href="/galeria">Ver toda la galería</a>
        </div>
      <% } else { %>
        <div class="home-panel--showcase gallery-visual-zone" data-gallery-visual-zone>
          <%- include('../components/panel2-antigravity') %>
          <div class="gallery-visual-zone__content">
            <div
              class="gallery-primary-mode gallery-primary-mode--infinite <%= filters.view === 'infinite' ? 'is-active' : 'is-inactive' %>"
              data-gallery-primary-mode="infinite"
              aria-hidden="<%= filters.view === 'infinite' ? 'false' : 'true' %>"
              <% if (filters.view !== 'infinite') { %>hidden<% } %>
            >
              <section
                class="gallery-infinite"
                data-gallery-infinite
                role="region"
                aria-label="Menú infinito tridimensional de la galería"
                aria-describedby="gallery-infinite-hint"
                tabindex="0"
              >
                <canvas class="gallery-infinite__canvas" data-gallery-infinite-canvas role="img" aria-label="Esfera interactiva de imágenes de la galería"></canvas>
                <div class="gallery-infinite__loader" data-gallery-infinite-loader role="status">Preparando menú infinito…</div>
                <div class="gallery-infinite__overlay" data-gallery-infinite-overlay data-gallery-animate="infinite-panel" hidden>
                  <p class="gallery-infinite__meta" data-gallery-infinite-meta></p>
                  <h3 class="gallery-infinite__title" data-gallery-infinite-title></h3>
                  <button class="gallery-infinite__action" type="button" data-gallery-infinite-action>Ver proyecto</button>
                </div>
                <p class="gallery-infinite__hint" id="gallery-infinite-hint">Arrastra en cualquier dirección para explorar.</p>
                <p class="gallery-infinite__fallback" data-gallery-infinite-fallback role="status" hidden></p>
                <p class="gallery-visually-hidden" data-gallery-infinite-live aria-live="polite"></p>
              </section>
            </div>

            <div
              class="gallery-primary-mode gallery-primary-mode--grid <%= filters.view === 'grid' ? 'is-active' : 'is-inactive' %>"
              data-gallery-primary-mode="grid"
              aria-hidden="<%= filters.view === 'grid' ? 'false' : 'true' %>"
              <% if (filters.view !== 'grid') { %>hidden<% } %>
            >
              <ul class="gallery-grid" data-gallery-grid>
                <% items.forEach(function(item) { %>
                  <%- include('../partials/gallery-card', { item }) %>
                <% }); %>
              </ul>
            </div>

            <section
              class="gallery-circular"
              data-gallery-circular
              data-gallery-video-carousel
              data-requested-view="<%= filters.view %>"
              role="region"
              aria-label="Carrusel circular de proyectos en video. Usa las flechas izquierda y derecha para navegar."
              tabindex="0"
              hidden
            >
              <div class="gallery-circular__viewport" data-gallery-circular-viewport></div>
              <div class="gallery-circular__loader" data-gallery-circular-loader role="status">Preparando videos…</div>
              <button
                class="gallery-circular__nav gallery-circular__nav--previous"
                type="button"
                data-gallery-circular-previous
                aria-label="Video anterior"
              >
                <span aria-hidden="true">‹</span>
              </button>
              <button
                class="gallery-circular__nav gallery-circular__nav--next"
                type="button"
                data-gallery-circular-next
                aria-label="Video siguiente"
              >
                <span aria-hidden="true">›</span>
              </button>
              <div class="gallery-circular__overlay" data-gallery-circular-overlay hidden>
                <p class="gallery-circular__meta" data-gallery-circular-meta></p>
                <h3 class="gallery-circular__title" data-gallery-circular-title></h3>
                <button class="gallery-circular__action" type="button" data-gallery-circular-action>Ver proyecto</button>
              </div>
              <p class="gallery-circular__fallback" data-gallery-circular-fallback role="status" hidden></p>
              <p class="gallery-visually-hidden" data-gallery-circular-live aria-live="polite"></p>
            </section>
          </div>
        </div>
      <% } %>
    </section>

    <% if (totalPages > 1) { %>
      <nav class="gallery-pagination" aria-label="Paginación de galería" data-gallery-animate="scroll">
        <% if (page > 1) { %>
          <a href="<%= buildGalleryUrl({ page: page - 1 }) %>" rel="prev">Anterior</a>
        <% } else { %>
          <span aria-disabled="true">Anterior</span>
        <% } %>
        <ol>
          <% paginationPages.forEach(function(pageNumber) { %>
            <li>
              <% if (pageNumber === 'ellipsis') { %>
                <span aria-hidden="true">…</span>
              <% } else if (pageNumber === page) { %>
                <span aria-current="page"><%= pageNumber %></span>
              <% } else { %>
                <a href="<%= buildGalleryUrl({ page: pageNumber }) %>"><%= pageNumber %></a>
              <% } %>
            </li>
          <% }); %>
        </ol>
        <% if (page < totalPages) { %>
          <a href="<%= buildGalleryUrl({ page: page + 1 }) %>" rel="next">Siguiente</a>
        <% } else { %>
          <span aria-disabled="true">Siguiente</span>
        <% } %>
      </nav>
    <% } %>

    <aside class="gallery-cta" data-gallery-animate="scroll">
      <div>
        <p>¿Tienes una idea en mente?</p>
        <h2>Convirtámosla en algo real.</h2>
      </div>
      <a href="/#como-trabajamos">Conocer el proceso</a>
    </aside>
  </div>

  <script type="application/json" id="gallery-data"><%- galleryJson %></script>
  <script type="application/json" id="gallery-video-data"><%- typeof videoGalleryJson === 'string' ? videoGalleryJson : '[]' %></script>
  <%- include('../partials/gallery-lightbox') %>
</main>
