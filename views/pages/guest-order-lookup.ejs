<main class="guest-order-lookup">
  <div class="guest-order-lookup__card">
    <p class="account-orders__eyebrow">Seguimiento seguro</p>
    <h1>Consultar pedido</h1>
    <p>Ingresa la referencia del pedido y el correo utilizado al realizar la compra.</p>

    <% if (lookupError) { %>
      <div id="lookup-error" class="guest-order-lookup__error" role="alert"><%= lookupError %></div>
    <% } %>

    <form action="/consultar-pedido" method="post" class="guest-order-lookup__form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div>
        <label for="order-reference">Referencia del pedido</label>
        <input id="order-reference" name="reference" value="<%= form.reference %>" maxlength="15" autocomplete="off" required aria-invalid="<%= lookupError ? 'true' : 'false' %>" <% if (lookupError) { %>aria-describedby="lookup-error"<% } %> placeholder="NL-XXXXXXXXXXXX">
      </div>
      <div>
        <label for="order-email">Correo electrónico</label>
        <input id="order-email" type="email" name="email" value="<%= form.email %>" maxlength="180" autocomplete="email" required aria-invalid="<%= lookupError ? 'true' : 'false' %>" <% if (lookupError) { %>aria-describedby="lookup-error"<% } %>>
      </div>
      <button class="account-orders__button" type="submit">Verificar pedido</button>
    </form>
    <p class="guest-order-lookup__login">¿El pedido pertenece a tu cuenta? <a href="/auth/login?returnTo=%2Fcuenta%2Fpedidos">Inicia sesión</a>.</p>
  </div>
</main>
