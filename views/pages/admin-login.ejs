<div class="auth-container">
  <div class="auth-card auth-card-admin">
    <div class="admin-login-badge">Administración</div>
    <h2>Acceso Administrativo</h2>
    <p class="auth-subtitle">Panel de control del sitio</p>

    <form action="/admin/login" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" class="form-control"
               placeholder="admin@ejemplo.com" required autocomplete="email"
               autofocus>
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" class="form-control"
               placeholder="Tu contraseña" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary btn-block">Ingresar al panel</button>
    </form>

    <p class="auth-footer">
      ¿No eres administrador? <a href="/auth/login">Ir al inicio de sesión</a>
    </p>

    <p class="auth-footer">
      <a href="/">Volver al inicio</a>
    </p>
  </div>
</div>
