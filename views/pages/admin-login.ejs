<div class="auth-container">
  <!-- Logo -->
  <div class="auth-logo">
    <a
      href="/"
      class="auth-logo-link"
      aria-label="Volver a la página principal"
    >
      <img
        src="/images/LogoCompleto.png"
        alt="<%= site.name %> — Impresión y diseño 3D"
        width="300"
        height="120"
        loading="eager"
      >
    </a>
  </div>

  <p class="auth-page-title">Acceso Administrativo</p>

  <main class="auth-card" aria-labelledby="admin-login-heading">
    <h1 id="admin-login-heading" class="sr-only">Acceso Administrativo</h1>
    <p class="auth-subtitle" style="text-align:center;margin:0 0 1.25rem;font-size:0.87rem;color:#8b9389;">Panel de control del sitio</p>

    <form action="/admin/login" method="POST" class="auth-form" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">

      <div class="form-group">
        <label for="email">Correo electrónico</label>
        <input type="email" id="email" name="email" class="form-control"
               placeholder="admin@ejemplo.com" required autocomplete="email"
               inputmode="email" autocapitalize="none" spellcheck="false"
               autofocus>
      </div>

      <div class="form-group">
        <label for="password">Contraseña</label>
        <div class="password-wrapper">
          <input type="password" id="password" name="password" class="form-control"
                 placeholder="Tu contraseña" required autocomplete="current-password">
          <button type="button" class="password-toggle"
                  aria-label="Mostrar contraseña"
                  data-password-toggle
                  data-target="password">
            <!-- Eye (hidden) icon -->
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" class="password-toggle__show">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" fill="none" stroke="currentColor" stroke-width="1.8"/>
              <circle cx="12" cy="12" r="3" fill="none" stroke="currentColor" stroke-width="1.8"/>
            </svg>
            <!-- Eye-off (visible) icon -->
            <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18" class="password-toggle__hide" style="display:none">
              <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
              <line x1="1" y1="1" x2="23" y2="23" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>
      </div>

      <button type="submit" class="btn btn-primary btn-block">Ingresar al panel</button>
    </form>

    <div class="auth-links">
      <p>¿No eres administrador? <a href="/auth/login">Ir al inicio de sesión</a></p>
      <p class="auth-links__secondary"><a href="/">Volver al inicio</a></p>
    </div>
  </main>
</div>

<script nonce="<%= cspNonce %>">
(function () {
  'use strict';
  var toggle = document.querySelector('[data-password-toggle]');
  if (!toggle) return;
  var targetId = toggle.getAttribute('data-target');
  var input = document.getElementById(targetId);
  if (!input) return;
  var showIcon = toggle.querySelector('.password-toggle__show');
  var hideIcon = toggle.querySelector('.password-toggle__hide');

  toggle.addEventListener('click', function () {
    var isPassword = input.type === 'password';
    input.type = isPassword ? 'text' : 'password';
    if (showIcon) showIcon.style.display = isPassword ? 'none' : '';
    if (hideIcon) hideIcon.style.display = isPassword ? '' : 'none';
    toggle.setAttribute('aria-label', isPassword ? 'Ocultar contraseña' : 'Mostrar contraseña');
  });
})();
</script>
