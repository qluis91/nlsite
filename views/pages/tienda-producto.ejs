<%- include('../components/home-navbar', { navbarOnHome: false }) %>

<main class="store-page" data-store-page>
  <% if (!product) { %>
    <div class="store-layout">
      <div class="store-empty-state" role="status" style="margin-top:6rem">
        <h3>Producto no encontrado</h3>
        <p>El producto que buscas no está disponible o fue retirado del catálogo público.</p>
        <div class="store-empty-state__actions">
          <a href="/tienda">Ver todos los productos</a>
        </div>
      </div>
    </div>
  <% } else { %>
    <div class="store-layout">

      <!-- Breadcrumbs -->
      <nav class="pd-breadcrumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/tienda">Tienda</a>
        <% if (product.categories && product.categories.length) { %>
          <span aria-hidden="true">/</span>
          <a href="/tienda?category=<%= product.categories[0].slug %>"><%= product.categories[0].name %></a>
        <% } %>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= product.title %></span>
      </nav>

      <!-- Back link -->
      <a href="<%= returnTo %>" class="pd-back-link">← Volver a la tienda</a>

      <!-- Product layout -->
      <div class="pd-grid">

        <!-- Gallery -->
        <section class="pd-gallery" aria-label="Galería del producto" data-product-gallery>
          <div class="pd-gallery__main">
            <% if (product.primaryImage) { %>
              <img
                src="<%= product.primaryImage %>"
                alt="<%= product.title %>"
                width="<%= product.primaryImageWidth || 1200 %>"
                height="<%= product.primaryImageHeight || 1200 %>"
                data-product-main-image
                decoding="async"
              >
            <% } else { %>
              <div class="pd-gallery__placeholder" aria-hidden="true">NINJALAB</div>
            <% } %>
          </div>

          <% if (product.images && product.images.length > 1) { %>
            <div class="pd-gallery__thumbnails" role="list" aria-label="Imágenes del producto">
              <% product.images.forEach(function(img, idx) { %>
                <button
                  type="button"
                  class="pd-thumbnail <%= img.isPrimary ? 'is-active' : '' %>"
                  role="listitem"
                  data-product-thumbnail
                  data-image-src="<%= img.filePath %>"
                  data-image-alt="<%= product.title + (product.images.length > 1 ? ' - Imagen ' + (idx + 1) : '') %>"
                  aria-label="<%= 'Ver imagen ' + (idx + 1) + ' de ' + product.title %>"
                  aria-pressed="<%= img.isPrimary ? 'true' : 'false' %>"
                >
                  <img
                    src="<%= img.filePath %>"
                    alt=""
                    width="80"
                    height="80"
                    loading="lazy"
                  >
                </button>
              <% }); %>
            </div>
          <% } %>
        </section>

        <!-- Product summary -->
        <div class="pd-summary">

          <% if (product.categories && product.categories.length) { %>
            <p class="pd-summary__categories">
              <% product.categories.forEach(function(cat, i) { %>
                <a href="/tienda?category=<%= cat.slug %>"><%= cat.name %></a><%= i < product.categories.length - 1 ? ', ' : '' %>
              <% }); %>
            </p>
          <% } %>

          <h1 class="pd-title"><%= product.title %></h1>

          <!-- Price -->
          <div class="pd-price">
            <span class="pd-price__current"><%= product.priceLabel %></span>
            <% if (product.hasPromotion && product.regularPrice > product.displayPrice) { %>
              <span class="pd-price__regular">
                <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(product.regularPrice) %>
              </span>
              <span class="pd-price__badge">Oferta</span>
            <% } %>
          </div>

          <!-- Availability + weight -->
          <div class="pd-meta">
            <p class="pd-availability <%= product.inStock ? 'is-available' : 'is-sold-out' %>">
              <span class="pd-availability__dot" aria-hidden="true"></span>
              <%= product.availability %>
            </p>
            <% if (weightLabel) { %>
              <p class="pd-meta__item">Peso: <%= weightLabel %></p>
            <% } %>
          </div>

          <!-- Quantity selector -->
          <div class="pd-quantity" data-product-quantity>
            <label for="quantity-input" class="pd-quantity__label">Cantidad</label>
            <div class="pd-quantity__control">
              <button type="button" class="pd-quantity__btn" data-quantity-decrease aria-label="Reducir cantidad" <%= !product.inStock ? 'disabled' : '' %>>−</button>
              <input
                id="quantity-input"
                type="number"
                name="quantity"
                min="1"
                max="<%= product.inStock ? Math.min(product.stockQuantity, 99) : 1 %>"
                value="1"
                inputmode="numeric"
                data-quantity-input
                <%= !product.inStock ? 'disabled' : '' %>
              >
              <button type="button" class="pd-quantity__btn" data-quantity-increase aria-label="Aumentar cantidad" <%= !product.inStock ? 'disabled' : '' %>>+</button>
            </div>
          </div>

          <!-- Actions -->
          <div class="pd-actions">
            <% if (product.inStock) { %>
              <form action="/carrito/agregar" method="post" class="pd-cart-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <input type="hidden" name="productId" value="<%= product.id %>">
                <input type="hidden" name="quantity" value="1" data-cart-quantity>
                <input type="hidden" name="returnTo" value="/tienda/<%= product.slug %>">
                <button type="submit" class="pd-action pd-action--cart">
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                  </svg>
                  Agregar al carrito
                </button>
              </form>
            <% } else { %>
              <button
                type="button"
                class="pd-action pd-action--cart"
                disabled
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                  <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                  <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
                </svg>
                Agotado
              </button>
            <% } %>

            <a
              href="<%= whatsappUrl %>"
              class="pd-action pd-action--whatsapp"
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
              </svg>
              Consultar por WhatsApp
            </a>
          </div>

          <!-- Description -->
          <% if (product.description) { %>
            <div class="pd-description">
              <h2 class="pd-section-title">Descripción</h2>
              <div class="pd-description__text"><%= product.description %></div>
            </div>
          <% } %>

          <!-- Tags -->
          <% if (product.tags && product.tags.length) { %>
            <div class="pd-tags">
              <% product.tags.forEach(function(tag) { %>
                <span class="store-tag"><%= tag %></span>
              <% }); %>
            </div>
          <% } %>

        </div>
      </div>

      <!-- Related products -->
      <% if (relatedProducts && relatedProducts.length) { %>
        <section class="pd-related" aria-labelledby="related-title">
          <h2 id="related-title" class="pd-related__title">También podría interesarte</h2>
          <ul class="pd-related__grid">
            <% relatedProducts.forEach(function(rp) { %>
              <li>
                <article class="store-product-card">
                  <a class="store-product-card__image-link" href="<%= rp.url %>" aria-label="Ver <%= rp.title %>">
                    <div class="store-product-card__media">
                      <% if (rp.primaryImage) { %>
                        <img src="<%= rp.primaryImage %>" alt="<%= rp.title %>" width="<%= rp.imageWidth %>" height="<%= rp.imageHeight %>" loading="lazy" decoding="async">
                      <% } else { %>
                        <span class="store-product-card__image-placeholder" aria-hidden="true">NINJALAB</span>
                      <% } %>
                    </div>
                  </a>
                  <div class="store-product-card__body">
                    <% if (rp.categoryName) { %><p class="store-product-card__category"><%= rp.categoryName %></p><% } %>
                    <h3 class="store-product-card__title"><a href="<%= rp.url %>"><%= rp.title %></a></h3>
                    <div class="store-product-card__meta">
                      <div class="store-product-card__price-group">
                        <p class="store-product-card__price"><%= rp.priceLabel %></p>
                        <% if (rp.hasPromotion) { %>
                          <p class="store-product-card__price-regular">
                            <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(rp.regularPrice) %>
                          </p>
                        <% } %>
                      </div>
                      <p class="store-product-card__availability <%= rp.inStock ? 'is-available' : 'is-sold-out' %>"><%= rp.availability %></p>
                    </div>
                  </div>
                </article>
              </li>
            <% }); %>
          </ul>
        </section>
      <% } %>

    </div>
  <% } %>
</main>
