<main class="st-layout" data-product-page>
  <%- include('../components/store-sidebar') %>

  <div class="st-main">
    <% if (!product) { %>
      <div class="st-product">
        <div class="st-empty" role="status">
          <h1>Producto no encontrado</h1>
          <p>El producto que buscas no está disponible o fue retirado del catálogo público.</p>
          <a href="/tienda">Ver todos los productos</a>
        </div>
      </div>
    <% } else { %>
      <%
        const galleryImages = [];
        const seenPaths = new Set();
        (product.images || []).forEach(function(img) {
          if (!img || !img.filePath || seenPaths.has(img.filePath)) return;
          seenPaths.add(img.filePath);
          galleryImages.push(img);
        });
        if (!galleryImages.length && product.primaryImage) {
          galleryImages.push({
            filePath: product.primaryImage,
            isPrimary: true,
            width: product.primaryImageWidth,
            height: product.primaryImageHeight,
          });
        }
        const hasMultipleImages = galleryImages.length > 1;
        const initialImage = galleryImages.find(function(img) { return img.isPrimary; }) || galleryImages[0] || null;
      %>

      <div class="st-product">
        <nav class="st-breadcrumb" aria-label="Migas de pan">
          <ol class="st-breadcrumb__list">
            <li><a href="/tienda">Tienda</a></li>
            <% if (product.categories && product.categories.length) { %>
              <li>
                <a href="/tienda?category=<%= product.categories[0].slug %>"><%= product.categories[0].name %></a>
              </li>
            <% } %>
            <li><span aria-current="page"><%= product.title %></span></li>
          </ol>
          <a href="<%= returnTo %>" class="st-breadcrumb__back">← Volver a la tienda</a>
        </nav>

        <div class="st-product__grid <%= hasMultipleImages ? 'has-thumbs' : 'is-single' %>">
          <% if (hasMultipleImages) { %>
            <div
              class="st-product__thumbs"
              role="list"
              aria-label="Imágenes del producto"
              data-product-thumbs
            >
              <% galleryImages.forEach(function(img, idx) {
                const isActive = initialImage && img.filePath === initialImage.filePath;
              %>
                <button
                  type="button"
                  class="st-product__thumb <%= isActive ? 'is-active' : '' %>"
                  role="listitem"
                  data-product-thumbnail
                  data-image-src="<%= img.filePath %>"
                  data-image-alt="<%= product.title + ' — imagen ' + (idx + 1) %>"
                  aria-label="Ver imagen <%= idx + 1 %> de <%= product.title %>"
                  aria-pressed="<%= isActive ? 'true' : 'false' %>"
                >
                  <img
                    src="<%= img.filePath %>"
                    alt=""
                    width="80"
                    height="80"
                    loading="lazy"
                    decoding="async"
                  >
                </button>
              <% }); %>
            </div>
          <% } %>

          <section class="st-product__media" aria-label="Imagen principal del producto" data-product-gallery>
            <div class="st-product__main">
              <% if (initialImage) { %>
                <img
                  src="<%= initialImage.filePath %>"
                  alt="<%= product.title %>"
                  width="<%= initialImage.width || product.primaryImageWidth || 1200 %>"
                  height="<%= initialImage.height || product.primaryImageHeight || 1200 %>"
                  data-product-main-image
                  loading="eager"
                  decoding="async"
                >
              <% } else { %>
                <div class="st-product__placeholder" aria-hidden="true">NINJALAB</div>
              <% } %>
            </div>
          </section>

          <div class="st-product__info">
            <% if (product.categories && product.categories.length) { %>
              <p class="st-product__category">
                <% product.categories.forEach(function(cat, i) { %>
                  <a href="/tienda?category=<%= cat.slug %>"><%= cat.name %></a><%= i < product.categories.length - 1 ? ', ' : '' %>
                <% }); %>
              </p>
            <% } %>

            <h1 class="st-product__title"><%= product.title %></h1>

            <div class="st-product__price">
              <span class="st-product__price-current"><%= product.priceLabel %></span>
              <% if (product.hasPromotion && product.regularPrice > product.displayPrice) { %>
                <span class="st-product__price-regular">
                  <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(product.regularPrice) %>
                </span>
                <span class="st-product__price-badge">Oferta</span>
              <% } %>
            </div>

            <div class="st-product__meta">
              <p class="st-product__availability <%= product.inStock ? 'is-available' : 'is-sold-out' %>">
                <span class="st-product__availability-dot" aria-hidden="true"></span>
                <%= product.availability %>
              </p>
              <% if (weightLabel) { %>
                <p class="st-product__weight">Peso: <%= weightLabel %></p>
              <% } %>
            </div>

            <div class="st-product__quantity" data-product-quantity>
              <label for="quantity-input" class="st-product__quantity-label">Cantidad</label>
              <div class="st-product__quantity-control">
                <button type="button" class="st-product__qty-btn" data-quantity-decrease aria-label="Reducir cantidad" <%= !product.inStock ? 'disabled' : '' %>>−</button>
                <input
                  id="quantity-input"
                  type="number"
                  name="quantity"
                  min="1"
                  max="<%= product.inStock ? Math.min(product.stockQuantity, 99) : 1 %>"
                  value="1"
                  inputmode="numeric"
                  data-quantity-input
                  <%= !product.inStock ? 'disabled' : '' %>
                >
                <button type="button" class="st-product__qty-btn" data-quantity-increase aria-label="Aumentar cantidad" <%= !product.inStock ? 'disabled' : '' %>>+</button>
              </div>
            </div>

            <div class="st-product__actions">
              <% if (product.inStock) { %>
                <form action="/carrito/agregar" method="post" class="st-product__cart-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <input type="hidden" name="productId" value="<%= product.id %>">
                  <input type="hidden" name="quantity" value="1" data-cart-quantity>
                  <input type="hidden" name="returnTo" value="/tienda/<%= product.slug %>">
                  <button type="submit" class="st-product__btn st-product__btn--primary">
                    <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                      <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" fill="none" stroke="currentColor" stroke-width="1.8"/>
                    </svg>
                    Agregar al carrito
                  </button>
                </form>
              <% } else { %>
                <button type="button" class="st-product__btn st-product__btn--primary" disabled>
                  <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                    <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
                    <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6" fill="none" stroke="currentColor" stroke-width="1.8"/>
                  </svg>
                  Agotado
                </button>
              <% } %>

              <a
                href="<%= whatsappUrl %>"
                class="st-product__btn st-product__btn--secondary"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z" fill="currentColor"/>
                </svg>
                Consultar por WhatsApp
              </a>
            </div>
          </div>
        </div>

        <% if (product.description || (product.tags && product.tags.length)) { %>
          <section class="st-product__details" aria-labelledby="product-details-title">
            <% if (product.description) { %>
              <h2 id="product-details-title" class="st-product__details-title">Descripción</h2>
              <div class="st-product__description"><%= product.description %></div>
            <% } else { %>
              <h2 id="product-details-title" class="st-visually-hidden">Detalles del producto</h2>
            <% } %>

            <% if (product.tags && product.tags.length) { %>
              <ul class="st-product__tags" aria-label="Etiquetas">
                <% product.tags.forEach(function(tag) { %>
                  <li class="st-product__tag"><%= tag %></li>
                <% }); %>
              </ul>
            <% } %>
          </section>
        <% } %>

        <% if (relatedProducts && relatedProducts.length) { %>
          <section class="st-product__related" aria-labelledby="related-title">
            <h2 id="related-title" class="st-product__related-title">También podría interesarte</h2>
            <ul class="st-grid">
              <% relatedProducts.forEach(function(rp, index) { %>
                <%- include('../components/store-card', { product: rp, idx: index }) %>
              <% }); %>
            </ul>
          </section>
        <% } %>
      </div>
    <% } %>
  </div>
</main>
