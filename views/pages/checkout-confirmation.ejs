<% const money = value => value === null || value === undefined ? null : new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(value); %>
<% const isPaid = order.paymentStatus === 'paid'; %>
<% const isPendingShipping = order.shippingStatus === 'pending_quote'; %>

<main class="st-layout">
  <%- include('../components/store-sidebar') %>

  <div class="st-main">
    <div class="st-confirm">

      <header class="st-confirm__header">
        <p class="st-confirm__eyebrow">Tienda NinjaLabCR</p>
        <h1 class="st-confirm__title">¡Pedido recibido!</h1>
        <p class="st-confirm__ref">Pedido <strong><%= order.reference %></strong></p>
      </header>

      <div class="st-confirm__layout">
        <div class="st-confirm__details">
          <!-- Order info -->
          <section class="st-confirm__section">
            <h2 class="st-confirm__section-title">Datos del pedido</h2>
            <dl class="st-confirm__meta">
              <div><dt>Cliente</dt><dd><%= order.customerName %></dd></div>
              <div><dt>Correo</dt><dd><%= order.customerEmail %></dd></div>
              <div><dt>Teléfono</dt><dd><%= order.customerPhone %></dd></div>
              <div><dt>Entrega</dt><dd><%= order.deliveryMethodLabel %></dd></div>
              <div><dt>Pago</dt><dd><%= order.paymentMethodLabel %></dd></div>
            </dl>
          </section>

          <% if (order.deliveryAddress) { %>
            <section class="st-confirm__section">
              <h2 class="st-confirm__section-title">Dirección de entrega</h2>
              <address class="st-confirm__address">
                <%= [order.deliveryAddress.province, order.deliveryAddress.canton, order.deliveryAddress.district, order.deliveryAddress.addressLine, order.deliveryAddress.reference].filter(Boolean).join(', ') %>
              </address>
            </section>
          <% } %>

          <% if (isPendingShipping) { %>
            <section class="st-confirm__section">
              <h2 class="st-confirm__section-title">Estado del envío</h2>
              <div class="st-confirm__notice st-confirm__notice--warn">
                <p><strong>Tu pedido incluye envío con costo pendiente de cotización.</strong></p>
                <p>NinjaLab se comunicará contigo al <strong><%= order.customerPhone %></strong> o al correo <strong><%= order.customerEmail %></strong> para confirmar el costo de envío y el total final.</p>
                <p class="st-confirm__warn">No realices ningún pago todavía. Espera la confirmación del costo de envío.</p>
              </div>
            </section>
          <% } else if (!isPaid) { %>
            <section class="st-confirm__section">
              <h2 class="st-confirm__section-title">Instrucciones de pago</h2>
              <div class="st-confirm__notice">
                <% if (order.paymentMethod === 'sinpe') { %>
                  <p>Realiza el <strong>SINPE Móvil</strong> al número:</p>
                  <p class="st-confirm__phone">+506 7024 0270</p>
                  <p>Incluye el número de pedido <strong><%= order.reference %></strong> en el detalle.</p>
                <% } else if (order.paymentMethod === 'bank_transfer') { %>
                  <p>Realiza la <strong>transferencia bancaria</strong>. NinjaLab te enviará los datos bancarios junto con la confirmación.</p>
                <% } %>
                <p class="st-confirm__pending">El pedido permanecerá <strong>pendiente</strong> hasta confirmar el pago.</p>
              </div>
            </section>
          <% } %>

          <!-- Items -->
          <section class="st-confirm__section">
            <h2 class="st-confirm__section-title">Productos</h2>
            <ul class="st-confirm__items" role="list">
              <% order.items.forEach(function(item) { %>
                <li class="st-confirm__line">
                  <span class="st-confirm__line-name"><%= item.productName %> × <%= item.quantity %></span>
                  <span class="st-confirm__line-price"><%= money(item.lineTotal) %></span>
                </li>
              <% }); %>
            </ul>
          </section>
        </div>

        <!-- Totals -->
        <aside class="st-confirm__summary">
          <dl class="st-confirm__rows">
            <div class="st-confirm__row">
              <dt>Subtotal</dt>
              <dd><%= money(order.productSubtotal) %></dd>
            </div>
            <div class="st-confirm__row">
              <dt>Envío</dt>
              <% if (isPendingShipping) { %>
                <dd class="st-confirm__pending-val">Por calcular</dd>
              <% } else { %>
                <dd><%= money(order.shippingAmount) %></dd>
              <% } %>
            </div>
          </dl>
          <div class="st-confirm__divider" aria-hidden="true"></div>
          <div class="st-confirm__row st-confirm__row--total">
            <dt>Total final</dt>
            <% if (isPendingShipping) { %>
              <dd class="st-confirm__pending-val">Pendiente</dd>
            <% } else { %>
              <dd><%= money(order.finalTotal) %></dd>
            <% } %>
          </div>
          <div class="st-confirm__row">
            <dt>Estado del pago</dt>
            <dd><span class="st-confirm__status"><%= isPaid ? 'Pagado' : 'Pendiente' %></span></dd>
          </div>

          <% if (order.paymentStatus === 'pending' && order.paymentMethod !== 'tilopay' && !isPendingShipping) { %>
            <p class="st-confirm__proof-hint">Adjunta el comprobante en los detalles del pedido una vez realizado el pago.</p>
          <% } %>
        </aside>
      </div>

      <div class="st-confirm__actions">
        <a href="/tienda" class="st-confirm__store-link">← Seguir comprando</a>
      </div>

    </div>
  </div>
</main>
