<%- include('../components/home-navbar', { navbarOnHome: false }) %>

<main class="checkout-page" data-checkout-page>
  <div class="store-layout">

    <nav class="pd-breadcrumbs" aria-label="Migas de pan">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <a href="/tienda">Tienda</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">Pedido confirmado</span>
    </nav>

    <div class="confirm-hero">
      <h1 class="confirm-hero__title">¡Pedido recibido!</h1>
      <p class="confirm-hero__ref">Pedido <strong><%= order.order_reference %></strong></p>
    </div>

    <div class="confirm-layout">
      <!-- Order details -->
      <div class="confirm-details">
        <section class="checkout-section">
          <h2 class="checkout-section__title">Datos del pedido</h2>
          <dl class="confirm-meta">
            <dt>Cliente</dt>
            <dd><%= order.customer_name %></dd>
            <dt>Correo</dt>
            <dd><%= order.customer_email %></dd>
            <dt>Teléfono</dt>
            <dd><%= order.customer_phone %></dd>
            <dt>Entrega</dt>
            <dd><%= dlvLabel %></dd>
            <dt>Pago</dt>
            <dd><%= pmtLabel %></dd>
          </dl>
        </section>

        <% if (isPendingShipping) { %>
          <section class="checkout-section">
            <h2 class="checkout-section__title">Estado del envío</h2>
            <div class="confirm-notice confirm-notice--shipping">
              <p><strong>Tu pedido incluye envío con costo pendiente de cotización.</strong></p>
              <p>NinjaLab se comunicará contigo al <strong><%= order.customer_phone %></strong> o al correo <strong><%= order.customer_email %></strong> para confirmar el costo de envío y el total final.</p>
              <p class="confirm-notice__warn">⚠️ No realices ningún pago todavía. Espera la confirmación del costo de envío.</p>
            </div>
          </section>
        <% } else { %>
          <section class="checkout-section">
            <h2 class="checkout-section__title">Instrucciones de pago</h2>
            <div class="confirm-notice confirm-notice--payment">
              <% if (order.payment_method === 'sinpe') { %>
                <p>Puedes realizar el <strong>SINPE Móvil</strong> al número:</p>
                <p class="confirm-notice__phone">+506 7024 0270</p>
                <p>Incluye el número de pedido <strong><%= order.order_reference %></strong> en el detalle del SINPE.</p>
              <% } else { %>
                <p>Puedes realizar la <strong>transferencia bancaria</strong>. NinjaLab te enviará los datos bancarios junto con la confirmación del pedido.</p>
              <% } %>
              <p class="confirm-notice__pending">El pedido permanecerá <strong>pendiente</strong> hasta confirmar el pago.</p>
            </div>
          </section>
        <% } %>

        <!-- Order items -->
        <section class="checkout-section">
          <h2 class="checkout-section__title">Productos</h2>
          <div class="confirm-items" role="list">
            <% items.forEach(function(item) { %>
              <div class="confirm-item" role="listitem">
                <span class="confirm-item__name"><%= item.product_name %> × <%= item.quantity %></span>
                <span class="confirm-item__price">
                  <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(item.line_total) %>
                </span>
              </div>
            <% }); %>
          </div>
        </section>
      </div>

      <!-- Totals sidebar -->
      <div class="confirm-summary">
        <div class="checkout-summary__row">
          <span>Subtotal</span>
          <span>
            <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(order.product_subtotal) %>
          </span>
        </div>
        <div class="checkout-summary__row">
          <span>Envío</span>
          <% if (isPendingShipping) { %>
            <span class="confirm-summary__pending">Por calcular</span>
          <% } else { %>
            <span>₡0</span>
          <% } %>
        </div>
        <div class="checkout-summary__row checkout-summary__row--total">
          <span>Total final</span>
          <% if (isPendingShipping) { %>
            <span class="confirm-summary__pending">Pendiente</span>
          <% } else { %>
            <span>
              <%= new Intl.NumberFormat('es-CR', { style: 'currency', currency: 'CRC', maximumFractionDigits: 0 }).format(order.final_total) %>
            </span>
          <% } %>
        </div>
        <div class="checkout-summary__row">
          <span>Estado del pago</span>
          <span class="confirm-summary__status">Pendiente</span>
        </div>
      </div>
    </div>

    <div class="confirm-actions">
      <a href="/tienda" class="confirm-actions__store">← Seguir comprando</a>
    </div>

  </div>
</main>
