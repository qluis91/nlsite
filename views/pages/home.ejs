<%-
/* ── Panel 1 — Hero ──
   Visual reference: public/reference/PaginaWeb.png
   Motion inspiration: trymeridian.com
   Regions:
     1. Gradient background + grid overlay
     2. Logo (upper left)
     3. Navigation (upper right): Tienda, Galería, Nosotros, Cuenta
     4. Eyebrow: IMPRESIÓN 3D EN COSTA RICA
     5. Main title: Fabricamos tus / ideas / con precisión / milimétrica
     6. 3D helmet model (right side)
     7. CTA buttons: Explorar productos, Cómo trabajamos
     8. Social links: Instagram, Facebook, TikTok, WhatsApp (bottom right)
*/ -%>

<main class="home-page" data-home-page>
  <!-- ═══ Panel 1: Hero ═══ -->
  <section
    id="inicio"
    class="home-panel home-panel--hero"
    data-panel="1"
    aria-labelledby="hero-title"
  >

    <!-- ── Header region: Logo + Nav ── -->
    <header class="hero-header">
      <a href="/" class="hero-logo" aria-label="<%= site.name %> — Inicio">
        <img src="/images/LogoCompleto.png" alt="<%= site.name %>" class="hero-logo-img">
      </a>

      <nav class="hero-nav" aria-label="Navegación principal">
        <ul class="hero-nav-list">
          <li><a href="#tienda" class="hero-nav-link">Tienda</a></li>
          <li><a href="#galeria" class="hero-nav-link">Galería</a></li>
          <li><a href="#nosotros" class="hero-nav-link">Nosotros</a></li>
          <li class="hero-nav-account">
            <% if (user) { %>
              <span class="hero-nav-user"><%= user.name %></span>
              <% if (Number(user.role_id) === 1) { %>
                <a href="/admin" class="hero-nav-link hero-nav-admin">Admin</a>
              <% } %>
              <form action="/auth/logout" method="POST" class="hero-logout-form">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="hero-nav-link hero-nav-logout">Salir</button>
              </form>
            <% } else { %>
              <a href="/auth/login" class="hero-nav-link">Cuenta</a>
            <% } %>
          </li>
        </ul>
      </nav>
    </header>

    <!-- ── Background layers ── -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-gradient"></div>
      <div class="hero-bg-glow"></div>
      <div class="hero-bg-grid"></div>
    </div>

    <!-- ── Hero content ── -->
    <div class="hero-content">
      <div class="hero-text">

        <!-- Eyebrow -->
        <span class="hero-eyebrow">IMPRESIÓN 3D EN COSTA RICA</span>

        <!-- Main title -->
        <h1 id="hero-title" class="hero-heading">
          <span class="hero-line">Fabricamos tus</span>
          <span class="hero-line">ideas</span>
          <span class="hero-line">con precisión</span>
          <span class="hero-line hero-line--accent">milimétrica</span>
        </h1>

        <!-- CTA buttons -->
        <div class="hero-ctas">
          <a href="#productos" class="hero-btn hero-btn--primary">
            Explorar productos
            <svg class="hero-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a href="#como-trabajamos" class="hero-btn hero-btn--outline">
            Cómo trabajamos
            <svg class="hero-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- 3D helmet stage -->
      <div class="hero-3d" aria-label="Casco 3D interactivo" role="img">
        <canvas class="hero-canvas" data-helmet-canvas></canvas>
        <div class="hero-loader" data-helmet-loader>
          <div class="hero-loader-spinner"></div>
          <span class="hero-loader-text">Cargando modelo 3D…</span>
        </div>
        <div class="hero-3d-fallback" data-helmet-fallback hidden>
          <div class="hero-3d-fallback-icon">🪖</div>
        </div>
      </div>
    </div>

    <!-- ── Social links (bottom right) ── -->
    <div class="hero-social">
      <!-- Placeholder URLs — configure real social links -->
      <a href="#" class="hero-social-link" aria-label="Instagram" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/>
        </svg>
      </a>
      <a href="#" class="hero-social-link" aria-label="Facebook" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
      </a>
      <a href="#" class="hero-social-link" aria-label="TikTok" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm6-8h.5A3.5 3.5 0 0 0 19 7.5V8M15 4v12a4 4 0 1 1-4-4"/></svg>
      </a>
      <a href="#" class="hero-social-link" aria-label="WhatsApp" rel="noopener noreferrer" target="_blank">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
      </a>
    </div>

  </section>

  <!-- ═══ Panel 2: Transition placeholder (scroll space only) ═══ -->
  <section
    class="home-panel home-panel--transition"
    data-panel="2"
    aria-label="Próxima sección"
  >
  </section>
</main>
