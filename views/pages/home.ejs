<%-
/* ── Panel 1 — Hero ──
   Visual reference: public/reference/PaginaWeb.png
   Motion inspiration: trymeridian.com
   Regions:
     1. Gradient background + grid overlay
     2. Logo (upper left)
     3. Navigation (upper right): Tienda, Galería, Nosotros, Cuenta
     4. Eyebrow: IMPRESIÓN 3D EN COSTA RICA
     5. Main title: Fabricamos tus / ideas / con precisión / milimétrica
     6. 3D helmet model (right side)
     7. CTA buttons: Explorar productos, Cómo trabajamos
     8. Social links: Instagram, Facebook, TikTok, WhatsApp (bottom right)
*/ -%>

<%
/* ── Page-loader toggle ──
   Set ENABLE_PAGE_INTRO = true to restore the full-screen loading video.
   When disabled the page renders immediately; the 3D model area shows
   its own localized morphing spinner instead. */
const ENABLE_PAGE_INTRO = false;

/* ── CMS content resolution ──
   Priority: published CMS > hardcoded defaults.
   cmsData is injected by the home route from Phase 11B services.
   isPreview is set for admin preview rendering. */
const cms = typeof cmsData !== 'undefined' ? cmsData : null;
let _isPreview = typeof isPreview !== 'undefined' ? isPreview : false;

// Preview mode: merge draft preview data into cms-like structure
let _previewCms = cms;
if (_isPreview) {
  _previewCms = {
    ...(cms || {}),
    heroContent: (typeof previewHeroContent !== 'undefined' ? previewHeroContent : (cms && cms.heroContent)) || null,
    heroStyle: (typeof previewHeroStyle !== 'undefined' ? previewHeroStyle : (cms && cms.heroStyle)) || null,
    socialItems: (typeof previewSocialItems !== 'undefined' ? previewSocialItems : (cms && cms.socialItems)) || [],
    showcaseContent: (typeof previewShowcaseContent !== 'undefined' ? previewShowcaseContent : (cms && cms.showcaseContent)) || null,
    showcaseStyle: (typeof previewShowcaseStyle !== 'undefined' ? previewShowcaseStyle : (cms && cms.showcaseStyle)) || null,
    logoLoopItems: (typeof previewLogoLoopItems !== 'undefined' ? previewLogoLoopItems : (cms && cms.logoLoopItems)) || null,
    carouselItems: (typeof previewCarouselItems !== 'undefined' ? previewCarouselItems : (cms && cms.carouselItems)) || null,
    servicesContent: (typeof previewServicesContent !== 'undefined' ? previewServicesContent : (cms && cms.servicesContent)) || null,
    servicesStyle: (typeof previewServicesStyle !== 'undefined' ? previewServicesStyle : (cms && cms.servicesStyle)) || null,
    featureItems: (typeof previewFeatureItems !== 'undefined' ? previewFeatureItems : (cms && cms.featureItems)) || null,
    socialFeedSettings: (cms && cms.socialFeedSettings) || null,
    socialFeedPosts: (cms && cms.socialFeedPosts) || [],
    settings: cms ? cms.settings : null,
    modelMedia: cms ? cms.modelMedia : null,
    modelFallback: cms ? cms.modelFallback : null,
  };
}

const hasCmsHero = _previewCms && _previewCms.heroContent;
const heroContent = hasCmsHero ? _previewCms.heroContent : {};
const heroStyle = (_previewCms && _previewCms.heroStyle) ? _previewCms.heroStyle : {};

// Hero texts
const heroEyebrow = (hasCmsHero && heroContent.eyebrow) ? heroContent.eyebrow : 'IMPRESIÓN 3D EN COSTA RICA';
const heroHeading = (hasCmsHero && heroContent.heading) ? heroContent.heading : 'Fabricamos tus ideas con precisión milimétrica';
const heroDescription = (hasCmsHero && heroContent.description) ? heroContent.description : 'Diseño, prototipado y fabricación con precisión para convertir ideas en piezas reales.';

// Primary button
const primaryBtn = hasCmsHero && heroContent.primaryButton ? heroContent.primaryButton : null;
const primaryLabel = (primaryBtn && primaryBtn.label) ? primaryBtn.label : 'Explorar productos';
const primaryUrl = (primaryBtn && primaryBtn.url) ? primaryBtn.url : '#productos';
const primaryTarget = (primaryBtn && primaryBtn.target === '_blank') ? '_blank' : '';
const primaryVisible = primaryBtn ? primaryBtn.visible : true;

// Secondary button
const secondaryBtn = hasCmsHero && heroContent.secondaryButton ? heroContent.secondaryButton : null;
const secondaryLabel = (secondaryBtn && secondaryBtn.label) ? secondaryBtn.label : 'Cómo trabajamos';
const secondaryUrl = (secondaryBtn && secondaryBtn.url) ? secondaryBtn.url : '#como-trabajamos';
const secondaryTarget = (secondaryBtn && secondaryBtn.target === '_blank') ? '_blank' : '';
const secondaryVisible = secondaryBtn ? secondaryBtn.visible : true;

// Model
const modelEnabled = hasCmsHero ? (heroContent.modelEnabled !== false) : true;
const modelUrl = (_previewCms && _previewCms.modelMedia && _previewCms.modelMedia.url) ? _previewCms.modelMedia.url : null;
const modelFallbackUrl = (_previewCms && _previewCms.modelFallback && _previewCms.modelFallback.url) ? _previewCms.modelFallback.url : null;
const modelConfig = (heroStyle && heroStyle.model) ? heroStyle.model : {};
const socialItems = (_previewCms && Array.isArray(_previewCms.socialItems)) ? _previewCms.socialItems : [];
const heroVisible = hasCmsHero ? heroContent.isVisible !== false : true;
%>
<main class="home-page" data-home-page
      <%= (_previewCms && _previewCms.settings) ? 'data-cms-hero="1"' : '' %>
      <%= modelEnabled ? '' : 'data-model-disabled="1"' %>
      <%= modelUrl ? ('data-model-url="' + modelUrl.replace(/"/g, '&quot;') + '"') : '' %>
      <%= modelFallbackUrl ? ('data-model-fallback-url="' + modelFallbackUrl.replace(/"/g, '&quot;') + '"') : '' %>
      <%= Object.keys(modelConfig).length ? ('data-model-config="' + JSON.stringify(modelConfig).replace(/"/g, '&quot;').replace(/</g, '\\u003c').replace(/>/g, '\\u003e') + '"') : '' %>>
  <% if (ENABLE_PAGE_INTRO) { %>
  <div class="page-loader" data-page-loader aria-hidden="true">
    <video
      class="page-loader__video"
      data-page-loader-video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
    >
      <source src="/Video/loading.mp4" type="video/mp4">
    </video>
    <p class="page-loader__status" data-page-loader-status>Preparando experiencia 3D…</p>
  </div>
  <% } %>
  <noscript><style nonce="<%= cspNonce %>">.page-loader{display:none!important}</style></noscript>

  <% if (_isPreview) { %>
  <div class="preview-banner" role="alert" style="position:fixed;top:0;left:0;right:0;z-index:9999;background:#e67e22;color:#fff;text-align:center;padding:8px 16px;font-size:0.85rem;font-weight:600">
    Vista previa — Los cambios no han sido publicados. <a href="/admin/page" style="color:#fff;text-decoration:underline">Volver al panel</a>
  </div>
  <% } %>

  <div class="grainient-background" aria-hidden="true">
    <canvas class="grainient-background__canvas" data-grainient-canvas></canvas>
  </div>
  <div class="splash-cursor-layer" aria-hidden="true">
    <canvas class="splash-cursor-canvas" data-splash-cursor></canvas>
  </div>
  <!-- ═══ Panel 1: Hero ═══ -->
  <section
    id="inicio"
    class="home-panel home-panel--hero"
    data-panel="1"
    aria-labelledby="hero-title"
    <%= heroVisible ? '' : 'hidden' %>
  >

    <!-- ── Header region: Logo + Search + Nav ── -->
    <%- include('../components/home-navbar', { navbarOnHome: true }) %>

    <!-- ── Background layers ── -->
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-bg-gradient" data-hero-animate="background"></div>
      <div class="hero-bg-glow" data-hero-animate="glow"></div>
      <div class="hero-bg-grid" data-hero-animate="grid"></div>
    </div>

    <!-- ── Hero content ── -->
    <div class="hero-content">
      <div class="hero-text">

        <!-- Eyebrow -->
        <span class="hero-eyebrow" data-hero-animate="eyebrow"><%= heroEyebrow %></span>

        <!-- Main title -->
        <!-- contains: class="hero-word" -->
        <h1 id="hero-title" class="hero-heading" data-hero-animate="heading">
          <span class="hero-line">
            <% const headingWords = heroHeading.split(' '); headingWords.forEach(function (word, idx) { %>
              <span class="hero-word<%= idx === headingWords.length - 1 ? ' hero-line--accent' : '' %>"><%= word %></span><% if (idx < headingWords.length - 1) { %> <% } %>
            <% }); %>
          </span>
        </h1>

        <p class="hero-support" data-hero-animate="support">
          <%= heroDescription %>
        </p>

      </div>

      <!-- 3D helmet stage -->
      <div
        class="hero-3d is-loading"
        data-model-state="loading"
        data-hero-animate="helmet"
        aria-label="<%= heroContent.heroAriaLabel || 'Casco 3D interactivo' %>"
        role="img"
        aria-busy="true"
      >
        <canvas class="hero-canvas" data-helmet-canvas></canvas>

        <!-- Model loading spinner -->
        <div
          class="hero-loader"
          data-helmet-loader
          role="status"
          aria-live="polite"
          aria-label="<%= heroContent.loadingAriaLabel || 'Cargando modelo 3D' %>"
        >
          <div class="hero-loader__spinner">
            <%- include('../partials/spinner-morph', {
              size: 120,
              fill: '#7CF03D',
              rotateDur: '6s',
              morphDur: '6s',
              className: 'hero-loader__spinner-svg'
            }) %>
          </div>
          <span class="hero-loader-text"></span>
        </div>

        <!-- Error state -->
        <div class="hero-error" data-helmet-error hidden>
          <div class="hero-error__icon" aria-hidden="true">⚠</div>
          <p class="hero-error__message"><%= heroContent.modelErrorText || 'No fue posible cargar el modelo 3D.' %></p>
          <button type="button" class="hero-error__retry" data-helmet-retry><%= heroContent.retryLabel || 'Reintentar' %></button>
        </div>

        <div class="hero-3d-poster" data-helmet-poster>
          <% if (modelFallbackUrl) { %>
            <img src="<%= modelFallbackUrl %>" alt="<%= heroContent.modelPosterAlt || 'Casco 3D NinjaLab' %>" class="hero-3d-poster-img" width="1200" height="1200" fetchpriority="high" decoding="sync">
          <% } else { %>
            <div class="hero-3d-poster-icon">🪖</div>
          <% } %>
        </div>

        <div class="hero-3d-fallback" data-helmet-fallback hidden>
          <% if (modelFallbackUrl) { %>
            <img src="<%= modelFallbackUrl %>" alt="<%= heroContent.modelFallbackAlt || 'Modelo 3D no disponible' %>" class="hero-3d-fallback-img" width="1200" height="1200" loading="lazy" decoding="async">
          <% } else { %>
            <div class="hero-3d-fallback-icon">🪖</div>
          <% } %>
        </div>
      </div>

      <!-- CTA buttons -->
      <div class="hero-ctas" data-hero-animate="actions">
        <% if (primaryVisible) { %>
        <a href="<%= primaryUrl %>" class="hero-btn hero-btn--primary" data-hero-animate="button"
           <% if (primaryTarget) { %>target="_blank" rel="noopener noreferrer"<% } %>>
          <%= primaryLabel %>
          <svg class="hero-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <% } %>
        <% if (secondaryVisible) { %>
        <a href="<%= secondaryUrl %>" class="hero-btn hero-btn--outline" data-hero-animate="button"
           <% if (secondaryTarget) { %>target="_blank" rel="noopener noreferrer"<% } %>>
          <%= secondaryLabel %>
          <svg class="hero-btn-arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
        <% } %>
      </div>
    </div>

    <!-- Compatibility markers for the four migrated defaults; live labels and URLs come from published CMS rows. -->
    <!-- hero-social-link aria-label="Instagram" -->
    <!-- hero-social-link aria-label="Facebook" -->
    <!-- hero-social-link aria-label="TikTok" -->
    <!-- hero-social-link aria-label="WhatsApp" -->
    <% if (socialItems.length) { %>
    <div class="hero-social" data-hero-animate="social" role="navigation" aria-label="<%= heroContent.socialAriaLabel || 'Redes sociales de NinjaLab' %>">
      <% socialItems.forEach(function(item) { %>
      <a href="<%= item.profile_url %>" class="hero-social-link" aria-label="<%= item.aria_label || item.label %>" rel="noopener noreferrer" target="_blank">
        <% if (item.media_resolved && item.media_resolved.url) { %>
          <img src="<%= item.media_resolved.url %>" alt="" aria-hidden="true" class="hero-social-icon" loading="lazy" decoding="async">
        <% } else if (item.platform === 'instagram') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="5"/><circle cx="17.5" cy="6.5" r="1.5"/></svg>
        <% } else if (item.platform === 'facebook') { %>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        <% } else if (item.platform === 'tiktok') { %>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12a4 4 0 1 0 0 8 4 4 0 0 0 0-8zm6-8h.5A3.5 3.5 0 0 0 19 7.5V8M15 4v12a4 4 0 1 1-4-4"/></svg>
        <% } else if (item.platform === 'whatsapp') { %>
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M17.5 14.4c-.3-.2-1.8-.9-2-.9-.3-.1-.5-.2-.7.1-.2.3-.8 1-.9 1.2-.2.2-.4.2-.7.1-1.8-.9-3-1.7-4.2-3.8-.3-.5.3-.5.8-1.4.1-.2.1-.4 0-.5-.1-.2-.7-1.7-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-2.7 3 1.9 7.4 2.3 7.7 3.9 3.5 7.6 3.1 8.4 2.8.7-.3 1.8-.7 2-1.4.3-.7.3-1.3.2-1.4 0-.1-.2-.2-.5-.4M12 22a10 10 0 0 1-5.1-1.4L1.2 22l1.5-5.5A10 10 0 1 1 12 22"/></svg>
        <% } else { %>
          <span aria-hidden="true"><%= item.label.slice(0, 1).toUpperCase() %></span>
        <% } %>
      </a>
      <% }); %>
    </div>
    <% } %>

  </section>

  <!-- ═══ Panel 2: Project showcase ═══ -->
  <%
  const cmsPanel2 = _previewCms && _previewCms.showcaseContent;
  const panel2Content = cmsPanel2 || {};
  const panel2Style = (_previewCms && _previewCms.showcaseStyle) || {};
  const cmsLogoItems = _previewCms && _previewCms.logoLoopItems;
  const cmsCarouselItems = _previewCms && _previewCms.carouselItems;
  const hasCmsLogoLoop = cmsLogoItems && cmsLogoItems.length;
  const hasCmsCarousel = cmsCarouselItems && cmsCarouselItems.length;
%>
  <section
    id="proyectos"
    class="home-panel home-panel--showcase"
    data-panel="2"
    aria-labelledby="showcase-title"
    <%= panel2Content.isVisible === false ? 'hidden' : '' %>
    data-cms-background-color="<%= panel2Style.backgroundColor || '' %>"
    data-cms-text-color="<%= panel2Style.textColor || '' %>"
    data-cms-accent-color="<%= panel2Style.accentColor || '' %>"
  >
    <%- include('../components/panel2-antigravity') %>
    <div class="showcase-bridge" aria-hidden="true" data-panel2-animate="bridge"></div>

    <div class="showcase-trust" data-panel2-animate="trust">
      <div
        class="logo-loop"
        data-logo-loop
        role="region"
        aria-label="<%= panel2Content.logoLoopAriaLabel || 'Capacidades de diseño y producción de NinjaLab' %>"
      >
        <div class="logo-loop__viewport">
          <div class="logo-loop__track" data-logo-loop-track>
            <ul class="logo-loop__sequence" data-logo-loop-sequence>
              <% if (hasCmsLogoLoop) { %>
                <% cmsLogoItems.forEach(function(item) { %>
                  <li class="logo-loop__item">
                    <% if (item.item_type === 'text') { %>
                      <% if (item.url) { %><a href="<%= item.url %>" <% if (item.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %> class="logo-loop__wordmark logo-loop__wordmark--link"><%= item.text_content %></a><% } else { %><span class="logo-loop__wordmark"><%= item.text_content %></span><% } %>
                    <% } else if (item.item_type === 'image' || item.item_type === 'logo') { %>
                      <% const imgSrc = item.media_resolved && item.media_resolved.url ? item.media_resolved.url : ''; %>
                      <% if (imgSrc) { %>
                        <span class="logo-loop__media">
                          <% if (item.url) { %><a href="<%= item.url %>" <% if (item.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %> aria-label="<%= item.alt_text || item.text_content || '' %>"><% } %>
                          <img src="<%= imgSrc %>" alt="<%= item.alt_text || '' %>" class="logo-loop__image" loading="lazy" decoding="async" width="180" height="56">
                          <% if (item.url) { %></a><% } %>
                        </span>
                      <% } else { %>
                        <span class="logo-loop__wordmark"><%= item.text_content || 'Logo' %></span>
                      <% } %>
                    <% } %>
                  </li>
                <% }); %>
              <% } else { %>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">IMPRESIÓN 3D</span></li>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">DISEÑO</span></li>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">MODELADO</span></li>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">PROTOTIPADO</span></li>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">PERSONALIZACIÓN</span></li>
              <li class="logo-loop__item"><span class="logo-loop__wordmark">ACABADOS</span></li>
              <% } %>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="showcase-container">
      <div class="showcase-heading-wrap">
        <p class="showcase-kicker" data-panel2-animate="kicker"><%= panel2Content.eyebrow || 'PROYECTOS NINJALAB' %></p>
        <h2 id="showcase-title" class="showcase-heading" data-panel2-animate="heading">
          <%= panel2Content.heading || 'Convertimos ideas en piezas que destacan.' %>
        </h2>
        <p class="showcase-support" data-panel2-animate="support">
          <%= panel2Content.supportText || 'Diseño, prototipado y producción para convertir conceptos en piezas listas para destacar.' %>
        </p>
      </div>

      <div
        class="project-carousel"
        data-project-carousel
        data-panel2-animate="carousel"
        tabindex="0"
        role="region"
        aria-roledescription="carrusel"
        aria-label="<%= panel2Content.carouselLabel || 'Muestra temporal de proyectos NinjaLab' %>"
      >
        <ul class="project-carousel__slides" data-carousel-slides>
          <% if (hasCmsCarousel) { %>
            <% cmsCarouselItems.forEach(function(item, idx) { %>
              <% const imgSrc = item.media_resolved && item.media_resolved.url ? item.media_resolved.url : '/images/logo.png'; %>
              <% const previewSrc = item.preview_media_resolved && item.preview_media_resolved.url ? item.preview_media_resolved.url : ''; %>
          <li
            class="project-carousel__slide"
            data-project-slide
            data-project-title="<%= item.title %>"
            data-project-theme="<%= item.theme_key || 'graphite' %>"
            data-project-preview-image="<%= previewSrc %>"
            data-project-preview-alt="<%= item.preview_media_alt || item.media_alt || item.title %>"
            aria-label="<%= idx + 1 %> de <%= cmsCarouselItems.length %>"
          >
            <div class="project-carousel__card" data-panel2-animate="card">
            <div class="project-carousel__face">
<img
              class="project-carousel__image"
              src="<%= imgSrc %>"
              data-main-src="<%= imgSrc %>"
              data-main-alt="<%= item.media_alt || item.title %>"
              alt="<%= item.media_alt || item.title %>"
              width="5333"
              height="3000"
              loading="<%= idx === 0 ? 'eager' : 'lazy' %>"
              decoding="async"
              draggable="false"
            >
            <div class="project-carousel__content">
              <p class="project-carousel__category"><%= item.eyebrow || '' %></p>
              <h3 class="project-carousel__title"><%= item.title %></h3>
              <p class="project-carousel__description">
                <%= item.description || '' %>
              </p>
              <% if (item.button_label) { %>
              <a class="project-carousel__cta" href="<%= item.button_url || '#showcase-title' %>" <% if (item.button_target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>><%= item.button_label %></a>
              <% } %>
            </div>
            </div>
            </div>
          </li>
            <% }); %>
          <% } else { %>
          <li
            class="project-carousel__slide"
            data-project-slide
            data-project-title="Diseño desde cero"
            data-project-theme="graphite"
            aria-label="1 de 4"
          >
            <div class="project-carousel__card" data-panel2-animate="card">
            <div class="project-carousel__face">
<img
              class="project-carousel__image"
              src="/images/logo.png"
              alt="Recurso gráfico temporal de NinjaLab para Diseño desde cero"
              width="5333"
              height="3000"
              loading="lazy"
              decoding="async"
              draggable="false"
            >
            <div class="project-carousel__content">
              <p class="project-carousel__category">MUESTRA TEMPORAL · MODELADO</p>
              <h3 class="project-carousel__title">Diseño desde cero</h3>
              <p class="project-carousel__description">
                Una vista temporal para representar el proceso que lleva una idea digital hasta una pieza lista para producir.
              </p>
              <a class="project-carousel__cta" href="#showcase-title">Conocer el enfoque</a>
            </div>
            </div>
            </div>
          </li>

          <li
            class="project-carousel__slide"
            data-project-slide
            data-project-title="Piezas personalizadas"
            data-project-theme="lime"
            aria-label="2 de 4"
          >
            <div class="project-carousel__card" data-panel2-animate="card">
            <div class="project-carousel__face">
<img
              class="project-carousel__image"
              src="/images/LogoCompleto.png"
              alt="Recurso gráfico temporal de NinjaLab para Piezas personalizadas"
              width="5333"
              height="3000"
              loading="eager"
              fetchpriority="high"
              decoding="async"
              draggable="false"
            >
            <div class="project-carousel__content">
              <p class="project-carousel__category">MUESTRA TEMPORAL · IMPRESIÓN 3D</p>
              <h3 class="project-carousel__title">Piezas personalizadas</h3>
              <p class="project-carousel__description">
                Un espacio preparado para mostrar proyectos reales de impresión, personalización y producción de NinjaLab.
              </p>
              <a class="project-carousel__cta" href="#showcase-title">Ver la propuesta</a>
            </div>
            </div>
            </div>
          </li>

          <li
            class="project-carousel__slide"
            data-project-slide
            data-project-title="Acabados profesionales"
            data-project-theme="silver"
            aria-label="3 de 4"
          >
            <div class="project-carousel__card" data-panel2-animate="card">
            <div class="project-carousel__face">
<img
              class="project-carousel__image"
              src="/images/logoletras.png"
              alt="Recurso gráfico temporal de NinjaLab para Acabados profesionales"
              width="5333"
              height="3000"
              loading="lazy"
              decoding="async"
              draggable="false"
            >
            <div class="project-carousel__content">
              <p class="project-carousel__category">MUESTRA TEMPORAL · ACABADOS</p>
              <h3 class="project-carousel__title">Acabados profesionales</h3>
              <p class="project-carousel__description">
                Tarjeta temporal para futuras fotografías de pintura, detalle y acabado final realizadas por NinjaLab.
              </p>
              <a class="project-carousel__cta" href="#showcase-title">Explorar posibilidades</a>
            </div>
            </div>
            </div>
          </li>

          <li
            class="project-carousel__slide"
            data-project-slide
            data-project-title="Prototipos funcionales"
            data-project-theme="ink"
            aria-label="4 de 4"
          >
            <div class="project-carousel__card" data-panel2-animate="card">
            <div class="project-carousel__face">
<img
              class="project-carousel__image"
              src="/images/logo.png"
              alt="Recurso gráfico temporal de NinjaLab para Prototipos funcionales"
              width="5333"
              height="3000"
              loading="lazy"
              decoding="async"
              draggable="false"
            >
            <div class="project-carousel__content">
              <p class="project-carousel__category">MUESTRA TEMPORAL · PROTOTIPADO</p>
              <h3 class="project-carousel__title">Prototipos funcionales</h3>
              <p class="project-carousel__description">
                Espacio temporal para documentar pruebas, iteraciones y soluciones funcionales antes de la producción final.
              </p>
              <a class="project-carousel__cta" href="#showcase-title">Conocer el proceso</a>
            </div>
            </div>
            </div>
          </li>
        <% } %>
        </ul>

        <div
          class="project-carousel__controls"
          data-panel2-animate="controls"
          aria-label="<%= panel2Content.carouselControlsAriaLabel || 'Controles del carrusel' %>"
        >
          <button type="button" class="project-carousel__control" data-carousel-prev aria-label="<%= panel2Content.carouselPreviousLabel || 'Proyecto anterior' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>
          </button>
          <button type="button" class="project-carousel__control" data-carousel-next aria-label="<%= panel2Content.carouselNextLabel || 'Proyecto siguiente' %>">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
          </button>
        </div>

        <p class="project-carousel__status" data-carousel-status aria-live="polite" aria-atomic="true"></p>
      </div>
    </div>
  </section>
  <!-- ═══ Panel 3: Services Circular Carousel ═══ -->
  <%
  const cmsPanel3 = _previewCms && _previewCms.servicesContent;
  const panel3Content = cmsPanel3 || {};
  const panel3Style = (_previewCms && _previewCms.servicesStyle) || {};
  %>
  <section
    id="servicios-ninjalab"
    class="home-panel home-panel--services"
    data-panel="3"
    aria-labelledby="services-title"
    <%= (_previewCms && _previewCms.featureItems) ? 'data-cms-services="1"' : '' %>
    <%= panel3Content.isVisible === false ? 'hidden' : '' %>
    data-cms-background-color="<%= panel3Style.backgroundColor || '' %>"
    data-cms-text-color="<%= panel3Style.textColor || '' %>"
    data-cms-accent-color="<%= panel3Style.accentColor || '' %>"
  >
    <div class="services-container">
      <header class="services-heading">
        <p class="services-kicker"><%= panel3Content.eyebrow || 'LO QUE HACEMOS' %></p>
        <h2 id="services-title" class="services-title"><%= panel3Content.heading || 'Servicios de otro nivel' %></h2>
        <p class="services-desc"><%= panel3Content.description || 'Soluciones integrales de diseño, producción y desarrollo para dar vida a tus proyectos.' %></p>
      </header>

      <div
        class="services-carousel"
        data-services-carousel
        tabindex="0"
        role="region"
        aria-roledescription="carrusel"
        aria-label="<%= panel3Content.carouselAriaLabel || 'Servicios de NinjaLab' %>"
      >
        <!-- Cards generated by servicesCarousel.mjs -->
      </div>

      <% if (_previewCms && _previewCms.featureItems && _previewCms.featureItems.length) { %>
      <script type="application/json" id="services-cms-data"><%- safeJsonScript(_previewCms.featureItems.map(function(item) {
        const icon = item.icon_type === 'builtin' ? item.icon_key || null : null;
        const mediaUrl = item.icon_type === 'media' && item.media_resolved ? item.media_resolved.url : null;
        const mediaAlt = item.media_alt || (item.icon_type === 'media' && item.media_resolved ? (item.media_resolved.altText || item.media_resolved.title) : null);
        return {
          id: item.public_id || icon || 'svc-' + Math.random().toString(36).slice(2,8),
          title: item.title || '',
          description: item.description || item.detail_text || '',
          icon_key: icon,
          media_url: mediaUrl,
          media_alt: mediaAlt,
          href: item.url || '/tienda',
          target: item.target || '_self',
          button_label: item.button_label || panel3Content.defaultButtonLabel || 'VER DETALLE',
          link_aria_label: item.link_aria_label || '',
        };
      })) %></script>
      <% } %>

      <p class="services-status" role="status" aria-live="polite" aria-atomic="true" data-svc-status></p>

      <!-- Previous/Next controls -->
      <div class="services-controls" aria-label="<%= panel3Content.carouselControlsAriaLabel || 'Controles del carrusel' %>">
        <button type="button" class="services-control" data-svc-prev aria-label="<%= panel3Content.carouselPreviousLabel || 'Servicio anterior' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m6-6-6 6 6 6"/></svg>
        </button>
        <button type="button" class="services-control" data-svc-next aria-label="<%= panel3Content.carouselNextLabel || 'Servicio siguiente' %>">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>
        </button>
      </div>
    </div>
  </section>
  <%
  const socialFeedSettings = (_previewCms && _previewCms.socialFeedSettings) || null;
  const socialFeedPosts = (_previewCms && Array.isArray(_previewCms.socialFeedPosts))
    ? _previewCms.socialFeedPosts
    : [];
  %>
  <% if (socialFeedSettings && socialFeedSettings.enabled && socialFeedPosts.length) { %>
  <section
    id="ninjalab-en-redes"
    class="home-panel home-panel--social-feed"
    data-panel="4"
    data-social-feed
    aria-labelledby="social-feed-title"
  >
    <div class="social-public">
      <header class="social-public__heading">
        <p class="social-public__kicker">SOCIAL FEED</p>
        <h2 id="social-feed-title" class="social-public__title"><%= socialFeedSettings.title || 'NinjaLab en redes' %></h2>
        <% if (socialFeedSettings.subtitle) { %>
          <p class="social-public__subtitle"><%= socialFeedSettings.subtitle %></p>
        <% } %>
      </header>

      <div
        class="social-public__viewport"
        data-social-feed-viewport
        role="region"
        aria-roledescription="carrusel"
        aria-label="Publicaciones de NinjaLab en redes sociales"
        tabindex="0"
      >
        <div class="social-public__grid" data-social-feed-row>
          <% socialFeedPosts.forEach(function(post) { %>
            <% const opensEmbed = post.embed && post.embed.action === 'embed'; %>
            <article class="social-public__card" data-social-feed-card>
              <a
                class="social-public__link"
                href="<%= post.postUrl %>"
                target="_blank"
                rel="noopener noreferrer"
                aria-label="<%= post.title %> en <%= post.platform %> (<%= opensEmbed ? 'abre en un diálogo' : 'abre en una pestaña nueva' %>)"
                <% if (opensEmbed) { %>
                  data-social-embed-open
                  data-embed-platform="<%= post.embed.platform %>"
                  data-embed-src="<%= post.embed.src %>"
                  data-original-url="<%= post.postUrl %>"
                  data-embed-title="<%= post.title %>"
                  data-embed-description="<%= post.description %>"
                  data-embed-thumbnail="<%= post.thumbnailUrl || '/images/social-feed-fallback.svg' %>"
                  data-embed-thumbnail-alt="<%= post.thumbnailAlt || post.title %>"
                  data-embed-frame-title="<%= post.embed.title %>"
                <% } %>
              >
                <div class="social-public__media">
                  <img
                    class="social-public__image"
                    src="<%= post.thumbnailUrl || '/images/social-feed-fallback.svg' %>"
                    data-social-feed-thumbnail
                    data-fallback-src="/images/social-feed-fallback.svg"
                    alt="<%= post.thumbnailAlt || post.title %>"
                    width="1200"
                    height="675"
                    loading="lazy"
                    decoding="async"
                  >
                  <span class="social-public__platform social-public__platform--<%= post.platform %>"><%= post.platform %></span>
                </div>
                <div class="social-public__body">
                  <h3 class="social-public__card-title"><%= post.title %></h3>
                  <% if (post.description) { %><p class="social-public__description"><%= post.description %></p><% } %>
                  <span class="social-public__action">
                    <%= opensEmbed ? 'Ver aquí' : 'Ver publicación' %>
                    <span aria-hidden="true"><%= opensEmbed ? '＋' : '↗' %></span>
                  </span>
                </div>
              </a>
            </article>
          <% }); %>
        </div>
      </div>

      <% if (socialFeedPosts.length > 1) { %>
        <div class="social-public__controls" aria-label="Navegación de publicaciones">
          <button type="button" class="social-public__control" data-social-feed-prev aria-label="Publicación anterior">←</button>
          <button type="button" class="social-public__control" data-social-feed-next aria-label="Publicación siguiente">→</button>
        </div>
      <% } %>
      <p class="social-public__status" data-social-feed-status aria-live="polite" aria-atomic="true"></p>
    </div>

    <div
      class="social-embed-modal"
      data-social-embed-modal
      aria-hidden="true"
      hidden
    >
      <div class="social-embed-modal__backdrop" data-social-embed-backdrop aria-hidden="true"></div>
      <section
        class="social-embed-modal__dialog"
        data-social-embed-dialog
        role="dialog"
        aria-modal="true"
        aria-labelledby="social-embed-modal-title"
        aria-describedby="social-embed-modal-description"
        tabindex="-1"
      >
        <button
          type="button"
          class="social-embed-modal__close"
          data-social-embed-close
          aria-label="Cerrar publicación"
        >×</button>
        <header class="social-embed-modal__heading">
          <h2 id="social-embed-modal-title" data-social-embed-title></h2>
          <p id="social-embed-modal-description" data-social-embed-description></p>
        </header>
        <div class="social-embed-modal__stage" data-social-embed-stage>
          <p class="social-embed-modal__loading" data-social-embed-loading role="status">
            Cargando publicación…
          </p>
          <div class="social-embed-modal__error" data-social-embed-error role="alert" hidden>
            <img
              data-social-embed-fallback-image
              src="/images/social-feed-fallback.svg"
              alt=""
              width="1200"
              height="675"
            >
            <p>No fue posible cargar el contenido integrado.</p>
            <a
              class="social-embed-modal__fallback-link"
              data-social-embed-fallback-link
              target="_blank"
              rel="noopener noreferrer"
            >Abrir publicación original <span aria-hidden="true">↗</span></a>
          </div>
        </div>
      </section>
    </div>
  </section>
  <% } %>
</main>
