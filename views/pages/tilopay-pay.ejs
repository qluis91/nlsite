<%- include('../components/header', { pageTitle: 'Pagar con Tilopay', pageClass: 'checkout-page', pageStyles: '' }) %>

<div class="container" style="max-width:640px;margin:2rem auto;padding:1rem;">
  <h2>Pagar con Tarjeta</h2>
  <p>Serás redirigido a la plataforma segura de <strong>Tilopay</strong> para completar tu pago.</p>

  <form method="POST" action="/cuenta/pedidos/<%= orderId %>/pagar/tilopay" id="tilopay-form">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

    <div class="form-group" style="margin-bottom:1rem;">
      <label for="email">Correo electrónico</label>
      <input type="email" id="email" name="email" class="form-control"
             value="<%= customerEmail || '' %>" required />
    </div>

    <div class="form-group" style="margin-bottom:1rem;">
      <label for="firstName">Nombre</label>
      <input type="text" id="firstName" name="firstName" class="form-control"
             value="<%= customerFirstName || '' %>" required />
    </div>

    <div class="form-group" style="margin-bottom:1rem;">
      <label for="lastName">Apellidos</label>
      <input type="text" id="lastName" name="lastName" class="form-control"
             value="<%= customerLastName || '' %>" required />
    </div>

    <div class="form-group" style="margin-bottom:1rem;">
      <label for="phone">Teléfono</label>
      <input type="tel" id="phone" name="phone" class="form-control"
             value="<%= customerPhone || '' %>" required />
    </div>

    <% if (orderTotal) { %>
    <div style="margin:1.5rem 0;padding:1rem;background:#f8f9fa;border-radius:8px;">
      <strong>Total a pagar:</strong>
      <span style="font-size:1.3rem;color:#2563eb;">₡<%= Number(orderTotal).toLocaleString('es-CR', {minimumFractionDigits:2}) %></span>
    </div>
    <% } %>

    <button type="submit" class="btn btn-primary" style="width:100%;padding:0.8rem;font-size:1.1rem;" id="tilopay-submit">
      Continuar a Tilopay
    </button>
  </form>

  <div style="margin-top:1rem;text-align:center;color:#64748b;font-size:0.85rem;">
    <p>Tus datos de pago serán procesados de forma segura por Tilopay.<br>
    No almacenamos información de tu tarjeta.</p>
  </div>
</div>

<script>
document.getElementById('tilopay-form').addEventListener('submit', function() {
  var btn = document.getElementById('tilopay-submit');
  btn.disabled = true;
  btn.textContent = 'Conectando con Tilopay...';
});
</script>

<%- include('../components/footer') %>
