<%
  const layoutSiteInput =
    typeof site !== 'undefined' && site && typeof site === 'object'
      ? site
      : {};
  const layoutDefaultColors = {
    primary: '#2563eb',
    primaryHover: '#1d4ed8',
    secondary: '#64748b',
    accent: '#f59e0b',
    bg: '#f8fafc',
    success: '#22c55e',
    danger: '#ef4444',
    warning: '#f59e0b',
  };
  const layoutColorsInput =
    layoutSiteInput.colors && typeof layoutSiteInput.colors === 'object'
      ? layoutSiteInput.colors
      : {};
  const layoutSiteName =
    layoutSiteInput.name
      ? String(layoutSiteInput.name)
      : 'NinjaLab CR';
  const layoutSiteDescription =
    layoutSiteInput.description
      ? String(layoutSiteInput.description)
      : 'NinjaLab CR';
  const layoutSite = {
    ...layoutSiteInput,
    name: layoutSiteName,
    description: layoutSiteDescription,
    colors: {
      ...layoutDefaultColors,
      ...layoutColorsInput,
    },
  };
  const layoutPageTitle =
    typeof title !== 'undefined' && title
      ? String(title)
      : '';
  const layoutMetaTitleRaw =
    typeof metaTitle !== 'undefined' && metaTitle
      ? String(metaTitle)
      : (typeof pageSeoTitle !== 'undefined' && pageSeoTitle)
        ? String(pageSeoTitle)
        : '';
  const layoutDocumentTitle =
    layoutMetaTitleRaw
      ? layoutMetaTitleRaw
      : layoutPageTitle
        ? `${layoutPageTitle} | ${layoutSiteName}`
        : (typeof globalSeoTitle !== 'undefined' && globalSeoTitle)
          ? globalSeoTitle
          : layoutSiteName;
  const layoutDescription =
    typeof metaDescription !== 'undefined' && metaDescription
      ? String(metaDescription)
      : (typeof pageSeoDescription !== 'undefined' && pageSeoDescription)
        ? String(pageSeoDescription)
        : (typeof globalSeoDescription !== 'undefined' && globalSeoDescription)
          ? globalSeoDescription
          : layoutSiteDescription;
  const layoutRobots =
    typeof robots !== 'undefined' && robots
      ? String(robots)
      : (typeof pageSeoRobots !== 'undefined' && pageSeoRobots)
        ? String(pageSeoRobots)
        : (typeof globalRobots !== 'undefined' && globalRobots)
          ? String(globalRobots)
          : '';
  const layoutCanonical =
    typeof canonical !== 'undefined' && canonical
      ? String(canonical)
      : (typeof pageSeoCanonical !== 'undefined' && pageSeoCanonical)
        ? String(pageSeoCanonical)
        : (typeof globalCanonical !== 'undefined' && globalCanonical)
          ? String(globalCanonical)
          : '';
  const layoutCanonicalAbs =
    layoutCanonical
    && (typeof baseUrl !== 'undefined' && baseUrl)
    && !/^https?:\/\//i.test(layoutCanonical)
      ? String(baseUrl).replace(/\/+$/, '') + (layoutCanonical.startsWith('/') ? layoutCanonical : '/' + layoutCanonical)
      : layoutCanonical;
  const layoutOgImage =
    typeof ogImage !== 'undefined' && ogImage
      ? String(ogImage)
      : (typeof pageSeoOgImage !== 'undefined' && pageSeoOgImage)
        ? String(pageSeoOgImage)
        : (typeof globalOgImage !== 'undefined' && globalOgImage)
          ? String(globalOgImage)
          : '';
  const layoutFavicon =
    typeof favicon !== 'undefined' && favicon
      ? String(favicon)
      : (typeof globalFavicon !== 'undefined' && globalFavicon)
        ? String(globalFavicon)
        : '';
  const layoutOgUrl =
    typeof ogUrl !== 'undefined' && ogUrl
      ? String(ogUrl)
      : layoutCanonicalAbs;
  const layoutPageClass =
    typeof pageClass !== 'undefined' && pageClass
      ? String(pageClass)
      : '';
  const layoutPageStyles =
    typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)
      ? pageStyles.map(String)
      : [];
  const layoutPageModule =
    typeof pageModule !== 'undefined' && pageModule
      ? String(pageModule)
      : '';
  const layoutNonce =
    typeof cspNonce !== 'undefined' && cspNonce
      ? String(cspNonce)
      : '';
  const layoutHideFooter =
    typeof hideFooter !== 'undefined'
      ? Boolean(hideFooter)
      : false;
  const layoutUsesHeroNavbar =
    typeof usesHeroNavbar !== 'undefined'
      ? Boolean(usesHeroNavbar)
      : false;
  const layoutUsesPanel2Background =
    typeof usesPanel2Background !== 'undefined'
      ? Boolean(usesPanel2Background)
      : false;
  const layoutUser =
    typeof user !== 'undefined' && user && typeof user === 'object'
      ? user
      : null;
  const layoutCurrentPath =
    typeof currentPath !== 'undefined' && currentPath
      ? String(currentPath)
      : '';
  const layoutCsrfToken =
    typeof csrfToken !== 'undefined' && csrfToken
      ? String(csrfToken)
      : '';
  const layoutCartItemCount =
    typeof cartItemCount !== 'undefined' && Number.isFinite(Number(cartItemCount))
      ? Number(cartItemCount)
      : 0;
  const layoutContent =
    typeof body !== 'undefined'
      ? body
      : '';
%>
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= layoutDescription %>">
  <% if (layoutRobots) { %>
    <meta name="robots" content="<%= layoutRobots %>">
  <% } %>
  <% if (layoutCanonicalAbs) { %>
    <link rel="canonical" href="<%= layoutCanonicalAbs %>">
  <% } %>
  <title><%= layoutDocumentTitle %></title>
  <% if (layoutFavicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= layoutFavicon %>">
    <link rel="shortcut icon" href="<%= layoutFavicon %>">
  <% } %>
  <% /* Open Graph */ %>
  <meta property="og:title" content="<%= layoutDocumentTitle %>">
  <meta property="og:description" content="<%= layoutDescription %>">
  <% if (layoutOgImage) { %>
    <meta property="og:image" content="<%= layoutOgImage %>">
  <% } %>
  <% if (layoutOgUrl) { %>
    <meta property="og:url" content="<%= layoutOgUrl %>">
  <% } %>
  <meta property="og:type" content="website">
  <meta property="og:locale" content="es_CR">
  <% /* Twitter Card */ %>
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= layoutDocumentTitle %>">
  <meta name="twitter:description" content="<%= layoutDescription %>">
  <% if (layoutOgImage) { %>
    <meta name="twitter:image" content="<%= layoutOgImage %>">
  <% } %>
  <% /* Phase 12D: JSON-LD Structured Data */ %>
  <% if (typeof jsonLdOrg !== 'undefined' && jsonLdOrg) { %><%- jsonLdOrg %><% } %>
  <% if (typeof jsonLdWeb !== 'undefined' && jsonLdWeb) { %><%- jsonLdWeb %><% } %>
  <% if (typeof jsonLdProduct !== 'undefined' && jsonLdProduct) { %><%- jsonLdProduct %><% } %>
  <% if (typeof jsonLdBreadcrumb !== 'undefined' && jsonLdBreadcrumb) { %><%- jsonLdBreadcrumb %><% } %>
  <% /* Phase 14: Google Search Console verification */ %>
  <% if (typeof googleVerification !== 'undefined' && googleVerification) { %>
    <meta name="google-site-verification" content="<%= googleVerification %>">
  <% } %>
  <% /* Phase 14: Analytics consent banner CSS */ %>
  <% if (typeof gaConsentEnabled !== 'undefined' && gaConsentEnabled) { %>
    <link rel="stylesheet" href="/css/consent-banner.css">
  <% } %>
  <% if (layoutPageClass === 'page-home') { %>
  <script nonce="<%= layoutNonce %>">
    document.documentElement.classList.add('js');
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('hero-entrance-pending', 'panel-transition-pending');
      window.__heroEntranceSafetyTimer = window.setTimeout(function () {
        document.documentElement.classList.remove(
          'hero-entrance-pending',
          'panel-transition-pending',
          'panel-transition-ready'
        );
      }, 3500);
    }
  </script>
  <% } %>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/ninja-alerts.css">
  <% if (!layoutHideFooter) { %>
    <link rel="stylesheet" href="/css/footer.css">
  <% } %>
  <% if (layoutPageStyles.length) { %>
    <% layoutPageStyles.forEach(function(s) { %>
      <link rel="stylesheet" href="<%= s %>">
    <% }); %>
  <% } %>
  <!-- Variables CSS inyectadas desde config/site.js -->
  <style nonce="<%= layoutNonce %>">
    :root {
      --color-primary: <%= layoutSite.colors.primary %>;
      --color-primary-hover: <%= layoutSite.colors.primaryHover %>;
      --color-secondary: <%= layoutSite.colors.secondary %>;
      --color-accent: <%= layoutSite.colors.accent %>;
      --color-bg: <%= layoutSite.colors.bg %>;
      --color-success: <%= layoutSite.colors.success %>;
      --color-danger: <%= layoutSite.colors.danger %>;
      --color-warning: <%= layoutSite.colors.warning %>;
    }
  </style>

  <% if (layoutPageClass === 'page-home' || layoutUsesPanel2Background) { %>
  <script type="importmap" nonce="<%= layoutNonce %>">
  {
    "imports": {
      "three": "/vendor/three/build/three.module.js",
      "three/addons/": "/vendor/three/examples/jsm/"
    }
  }
  </script>
  <link rel="preload" href="/css/home.css" as="style">
  <% /* Phase 15B: Preload hero GLB when available */ %>
  <% if (layoutPageClass === 'page-home' && typeof heroGlbUrl !== 'undefined' && heroGlbUrl) { %>
  <link rel="preload" href="<%= heroGlbUrl %>" as="fetch" crossorigin="anonymous">
  <% } %>
  <% } %>
  <% /* Phase 14: DNS-prefetch for analytics */ %>
  <% if (typeof gaMeasurementId !== 'undefined' && gaMeasurementId) { %>
  <link rel="dns-prefetch" href="https://www.googletagmanager.com">
  <link rel="dns-prefetch" href="https://www.google-analytics.com">
  <% } %>
</head>
<body class="<%= layoutPageClass %>">
  <%- include('../partials/ninja-alerts') %>
  <% if (layoutPageClass !== 'page-home' && !layoutUsesHeroNavbar) { %>
    <%- include('../components/navbar', {
      site: layoutSite,
      user: layoutUser,
      currentPath: layoutCurrentPath,
      csrfToken: layoutCsrfToken,
      cartItemCount: layoutCartItemCount
    }) %>
  <% } %>

  <%- layoutContent %>

  <% if (!layoutHideFooter) { %>
    <%- include('../components/footer', {
      site: layoutSite,
      pageClass: layoutPageClass
    }) %>
  <% } %>

  <% if (!layoutHideFooter) { %>
  <script type="module" src="/js/footerMagicRings.mjs"></script>
  <% } %>
  <script src="/js/ninja-alerts.js"></script>

  <% if (layoutPageClass === 'page-home') { %>
    <script type="module" src="/js/home/home.js"></script>
  <% } else { %>
    <script src="/js/main.js"></script>
  <% } %>
  <% if (layoutPageModule) { %>
    <script type="module" src="<%= layoutPageModule %>"></script>
  <% } %>
  <% /* Phase 14: Analytics config + script */ %>
  <% var _showAnalytics = (typeof gaConsentEnabled !== 'undefined' && gaConsentEnabled) || (typeof gaMeasurementId !== 'undefined' && gaMeasurementId); %>
  <% if (_showAnalytics) { %>
  <script nonce="<%= layoutNonce %>">
    window.__GA_MEASUREMENT_ID = '<%= typeof gaMeasurementId !== 'undefined' && gaMeasurementId ? gaMeasurementId : '' %>';
    window.__GA_ENABLED = <%= typeof gaMeasurementId !== 'undefined' && gaMeasurementId ? 'true' : 'false' %>;
    window.__CONSENT_ENABLED = <%= typeof gaConsentEnabled !== 'undefined' && gaConsentEnabled ? 'true' : 'false' %>;
  </script>
  <% } %>
  <script src="/js/analytics.js"></script>
</body>
</html>
