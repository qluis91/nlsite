<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= typeof metaDescription !== 'undefined' ? metaDescription : site.description %>">
  <% if (typeof robots !== 'undefined' && robots) { %>
    <meta name="robots" content="<%= robots %>">
  <% } %>
  <title><%= typeof title !== 'undefined' ? title + ' | ' + site.name : site.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <% if (typeof hideFooter === 'undefined' || hideFooter !== true) { %>
    <link rel="stylesheet" href="/css/footer.css">
  <% } %>
  <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { %>
    <% pageStyles.forEach(function(s) { %>
      <link rel="stylesheet" href="<%= s %>">
    <% }); %>
  <% } %>
  <!-- Variables CSS inyectadas desde config/site.js -->
  <style nonce="<%= cspNonce %>">
    :root {
      --color-primary: <%= site.colors.primary %>;
      --color-primary-hover: <%= site.colors.primaryHover %>;
      --color-secondary: <%= site.colors.secondary %>;
      --color-accent: <%= site.colors.accent %>;
      --color-bg: <%= site.colors.bg %>;
      --color-success: <%= site.colors.success %>;
      --color-danger: <%= site.colors.danger %>;
      --color-warning: <%= site.colors.warning %>;
    }
  </style>

  <% if (typeof pageClass !== 'undefined' && pageClass === 'page-home') { %>
  <link rel="preconnect" href="https://storage.googleapis.com" crossorigin>
  <script type="importmap" nonce="<%= cspNonce %>">
  {
    "imports": {
      "three": "/vendor/three/build/three.module.js",
      "three/addons/": "/vendor/three/examples/jsm/"
    }
  }
  </script>
  <% } %>
</head>
<body class="<%= typeof pageClass !== 'undefined' ? pageClass : '' %>">
  <% if ((typeof pageClass === 'undefined' || pageClass !== 'page-home') && (typeof usesHeroNavbar === 'undefined' || !usesHeroNavbar)) { %>
    <%- include('../components/navbar') %>
  <% } %>

  <% if (success_msg) { %>
    <div class="alert alert-success"><%= success_msg %></div>
  <% } %>
  <% if (error_msg) { %>
    <div class="alert alert-danger"><%= error_msg %></div>
  <% } %>

  <%- body || '' %>

  <% if (typeof hideFooter === 'undefined' || hideFooter !== true) { %>
    <%- include('../components/footer') %>
  <% } %>

  <script type="module" src="/js/footerMagicRings.mjs"></script>

  <% if (typeof pageClass !== 'undefined' && pageClass === 'page-home') { %>
    <script type="module" src="/js/home/home.js"></script>
  <% } else { %>
    <script src="/js/main.js"></script>
  <% } %>
  <% if (typeof pageModule !== 'undefined' && pageModule) { %>
    <script type="module" src="<%= pageModule %>"></script>
  <% } %>
</body>
</html>
