<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= site.description %>">
  <title><%= typeof title !== 'undefined' ? title + ' | ' + site.name : site.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <!-- Variables CSS inyectadas desde config/site.js -->
  <style>
    :root {
      --color-primary: <%= site.colors.primary %>;
      --color-primary-hover: <%= site.colors.primaryHover %>;
      --color-secondary: <%= site.colors.secondary %>;
      --color-accent: <%= site.colors.accent %>;
      --color-bg: <%= site.colors.bg %>;
      --color-success: <%= site.colors.success %>;
      --color-danger: <%= site.colors.danger %>;
      --color-warning: <%= site.colors.warning %>;
    }
  </style>
</head>
<body>
  <%- include('../components/navbar') %>

  <% if (success_msg) { %>
    <div class="alert alert-success"><%= success_msg %></div>
  <% } %>
  <% if (error_msg) { %>
    <div class="alert alert-danger"><%= error_msg %></div>
  <% } %>

  <main class="container">
    <%- body || '' %>
  </main>

  <%- include('../components/footer') %>

  <script src="/js/main.js"></script>
</body>
</html>
