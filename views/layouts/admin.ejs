<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="<%= site.description %>">
  <title><%= typeof title !== 'undefined' ? title + ' | ' + site.name : site.name %></title>
  <% if (typeof globalFavicon !== 'undefined' && globalFavicon) { %>
    <link rel="icon" type="image/x-icon" href="<%= globalFavicon %>">
    <link rel="shortcut icon" href="<%= globalFavicon %>">
  <% } %>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/ninja-alerts.css">
  <% if (typeof pageStyles !== 'undefined' && Array.isArray(pageStyles)) { %>
    <% pageStyles.forEach(function(stylePath) { %>
      <link rel="stylesheet" href="<%= stylePath %>">
    <% }); %>
  <% } %>
  <style>
    :root {
      --color-primary: <%= site.colors.primary %>;
      --color-primary-hover: <%= site.colors.primaryHover %>;
      --color-secondary: <%= site.colors.secondary %>;
      --color-accent: <%= site.colors.accent %>;
      --color-bg: <%= site.colors.bg %>;
      --color-sidebar-bg: <%= site.colors.sidebarBg %>;
      --color-sidebar-text: <%= site.colors.sidebarText %>;
      --color-sidebar-hover: <%= site.colors.sidebarHover %>;
      --color-success: <%= site.colors.success %>;
      --color-danger: <%= site.colors.danger %>;
      --color-warning: <%= site.colors.warning %>;
    }
  </style>
</head>
<body class="admin-layout">
  <%- include('../partials/ninja-alerts') %>
  <%- include('../components/sidebar') %>

  <div class="admin-main">
    <%- include('../components/navbar-admin') %>

    <main class="admin-content">
      <%- body %>
    </main>
  </div>

  <script src="/js/main.js"></script>
  <script src="/js/ninja-alerts.js"></script>
  <script src="/js/admin/confirm-dialog.js"></script>
  <script src="/js/admin/disclosure.js"></script>
  <% if (typeof pageModule !== 'undefined' && pageModule) { %>
    <script type="module" src="<%= pageModule %>"></script>
  <% } %>
  <% if (typeof pageScripts !== 'undefined' && Array.isArray(pageScripts)) { %>
    <% pageScripts.forEach(function(s) { %>
      <script src="<%= s %>"></script>
    <% }); %>
  <% } %>
</body>
</html>
