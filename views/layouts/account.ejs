<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Área privada de la cuenta de cliente.">
  <meta name="robots" content="noindex, nofollow">
  <title><%= title %> | <%= typeof accountSiteName !== 'undefined' && accountSiteName ? accountSiteName : site.name %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/footer.css">
  <link rel="stylesheet" href="/css/account-orders.css">
  <link rel="stylesheet" href="/css/account.css">
  <link rel="stylesheet" href="/css/ninja-alerts.css">
  <style nonce="<%= cspNonce %>">
    :root {
      --color-primary: <%= site.colors.primary %>;
      --color-primary-hover: <%= site.colors.primaryHover %>;
      --color-secondary: <%= site.colors.secondary %>;
      --color-accent: <%= site.colors.accent %>;
      --color-bg: <%= site.colors.bg %>;
      --color-success: <%= site.colors.success %>;
      --color-danger: <%= site.colors.danger %>;
      --color-warning: <%= site.colors.warning %>;
    }
  </style>
</head>
<body class="account-page">
  <%- include('../partials/ninja-alerts') %>
  <%- include('../components/account-header') %>

  <div class="account-shell">
    <%- include('../components/account-sidebar') %>
    <div class="account-main">
      <%- body || '' %>
    </div>
  </div>

  <% if (typeof hideFooter === 'undefined' || !hideFooter) { %>
    <%- include('../components/footer') %>
  <% } %>
  <script src="/js/main.js"></script>
  <script src="/js/ninja-alerts.js"></script>
</body>
</html>
