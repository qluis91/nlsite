<nav class="navbar">
  <div class="container navbar-inner">
    <a href="/" class="navbar-brand"><%= site.name %></a>
    <ul class="navbar-nav">
      <li><a href="/" class="<%= currentPath === '/' ? 'active' : '' %>">Inicio</a></li>
      <li><a href="/galeria" class="<%= currentPath.startsWith('/galeria') ? 'active' : '' %>">Galería</a></li>
      <% if (user) { %>
        <li><a href="/cuenta" class="<%= currentPath === '/cuenta' || currentPath.startsWith('/cuenta/perfil') || currentPath.startsWith('/cuenta/direcciones') || currentPath.startsWith('/cuenta/seguridad') ? 'active' : '' %>">Mi cuenta</a></li>
        <li><a href="/cuenta/pedidos" class="<%= currentPath.startsWith('/cuenta/pedidos') ? 'active' : '' %>">Mis pedidos</a></li>
        <% if (Number(user.role_id) === 1) { %>
          <li><a href="/admin" class="<%= currentPath.startsWith('/admin') && currentPath !== '/admin/login' ? 'active' : '' %>">Panel Admin</a></li>
        <% } %>
        <li class="nav-user">
          <span class="nav-user-name"><%= user.name %></span>
          <form action="/auth/logout" method="POST" class="logout-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <button type="submit" class="btn btn-sm btn-outline logout-button">Cerrar Sesión</button>
          </form>
        </li>
      <% } else { %>
        <li><a href="/auth/login" class="<%= currentPath === '/auth/login' ? 'active' : '' %>">Iniciar Sesión</a></li>
        <li><a href="/auth/register" class="btn btn-sm btn-primary <%= currentPath === '/auth/register' ? 'active' : '' %>">Registrarse</a></li>
      <% } %>
    </ul>
  </div>
</nav>
