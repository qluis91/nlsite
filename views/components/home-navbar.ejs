<%
  const isHomepageNavbar = typeof navbarOnHome !== 'undefined' && navbarOnHome;
  const anchorPrefix = isHomepageNavbar ? '' : '/';
  const navbarQuery = typeof searchQuery !== 'undefined' ? searchQuery : '';
  const isStoreSearch = typeof navbarSearchContext !== 'undefined' && navbarSearchContext === 'store';
  const navbarSearchAction = isStoreSearch ? '/tienda' : '/buscar';
  const navbarSearchName = isStoreSearch ? 'search' : 'q';
  const navbarSearchLabel = isStoreSearch ? 'Buscar productos' : 'Buscar en NinjaLab';
  const navbarSearchPlaceholder = isStoreSearch ? 'Buscar productos...' : 'Buscar en NinjaLab...';
%>
<header class="hero-header" data-home-navbar>
  <a href="/" class="hero-logo" aria-label="<%= site.name %> — Inicio">
    <span class="hero-logo-stage" aria-hidden="true">
      <img src="/images/LogoCompleto.png" alt="" class="hero-logo-img hero-logo-img--full">
      <img src="/images/logoletras.png" alt="" class="hero-logo-img hero-logo-img--compact">
    </span>
  </a>

  <form class="hero-search hero-search--desktop" action="<%= navbarSearchAction %>" method="get" role="search">
    <label class="hero-search__label" for="navbar-search"><%= navbarSearchLabel %></label>
    <input
      id="navbar-search"
      class="hero-search__input"
      type="search"
      name="<%= navbarSearchName %>"
      value="<%= navbarQuery %>"
      maxlength="100"
      placeholder="<%= navbarSearchPlaceholder %>"
      autocomplete="off"
    >
    <button class="hero-search__submit" type="submit" aria-label="<%= navbarSearchLabel %>">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4 4"></path>
      </svg>
    </button>
  </form>

  <button class="hero-nav-toggle" type="button" aria-expanded="false" aria-controls="hero-navigation" aria-label="Abrir menú principal" data-nav-toggle>
    <span></span><span></span><span></span>
  </button>

  <nav id="hero-navigation" class="hero-nav" aria-label="Navegación principal" data-nav-panel>
    <form class="hero-search hero-search--mobile" action="<%= navbarSearchAction %>" method="get" role="search">
      <label class="hero-search__label" for="mobile-navbar-search"><%= navbarSearchLabel %></label>
      <input
        id="mobile-navbar-search"
        class="hero-search__input"
        type="search"
        name="<%= navbarSearchName %>"
        value="<%= navbarQuery %>"
        maxlength="100"
        placeholder="<%= navbarSearchPlaceholder %>"
        autocomplete="off"
      >
      <button class="hero-search__submit" type="submit" aria-label="<%= navbarSearchLabel %>">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16.5 16.5 4 4"></path>
        </svg>
      </button>
    </form>

    <ul class="hero-nav-list">
      <li class="hero-nav-item hero-nav-item--dropdown" data-nav-dropdown>
        <a href="/tienda" class="hero-nav-link">Tienda <svg class="hero-nav-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></a>
        <div id="nav-shop" class="hero-dropdown-panel" aria-label="Opciones de Tienda"><div class="hero-dropdown-inner">
          <a href="/tienda" class="hero-dropdown-link"><strong>Explorar productos</strong><span>Conoce el catálogo de NinjaLab.</span></a>
          <a href="<%= anchorPrefix %>#como-trabajamos" class="hero-dropdown-link"><strong>Productos personalizados</strong><span>Convierte una idea en una pieza única.</span></a>
        </div></div>
      </li>
      <li class="hero-nav-item hero-nav-item--dropdown" data-nav-dropdown>
        <button class="hero-nav-link hero-nav-trigger" type="button" aria-expanded="false" aria-controls="nav-services">Servicios <svg class="hero-nav-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></button>
        <div id="nav-services" class="hero-dropdown-panel" aria-label="Opciones de Servicios"><div class="hero-dropdown-inner">
          <a href="<%= anchorPrefix %>#como-trabajamos" class="hero-dropdown-link"><strong>Impresión 3D</strong><span>Producción precisa para prototipos y proyectos.</span></a>
          <a href="/galeria" class="hero-dropdown-link"><strong>Diseño y acabados</strong><span>Explora proyectos, pintura y modelado.</span></a>
        </div></div>
      </li>
      <li class="hero-nav-item"><a href="/galeria" class="hero-nav-link">Galería</a></li>
      <li class="hero-nav-item hero-nav-item--dropdown" data-nav-dropdown data-dropdown-align="end">
        <button class="hero-nav-link hero-nav-trigger" type="button" aria-expanded="false" aria-controls="nav-about">Nosotros <svg class="hero-nav-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg></button>
        <div id="nav-about" class="hero-dropdown-panel" aria-label="Opciones de Nosotros"><div class="hero-dropdown-inner">
          <a href="<%= anchorPrefix %>#nosotros" class="hero-dropdown-link"><strong>Sobre NinjaLab</strong><span>Conoce nuestro enfoque y experiencia.</span></a>
          <a href="<%= anchorPrefix %>#inicio" class="hero-dropdown-link"><strong>Volver al inicio</strong><span>Regresa a la presentación principal.</span></a>
        </div></div>
      </li>
    </ul>

    <div class="hero-nav-account">
      <a href="/carrito" class="hero-nav-link hero-nav-cart" aria-label="<%= 'Carrito, ' + (cartItemCount || 0) + ' artículos' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <% if (cartItemCount && cartItemCount > 0) { %>
          <span class="hero-nav-badge" aria-hidden="true"><%= cartItemCount %></span>
        <% } %>
      </a>
      <% if (user) { %>
        <a href="/cuenta" class="hero-nav-user"><%= user.name %></a>
        <a href="/cuenta/pedidos" class="hero-nav-link">Mis pedidos</a>
        <% if (Number(user.role_id) === 1) { %>
          <a href="/admin" class="hero-nav-link hero-nav-admin">Admin</a>
        <% } %>
        <form action="/auth/logout" method="POST" class="hero-logout-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit" class="hero-nav-link hero-nav-logout">Salir</button>
        </form>
      <% } else { %>
        <a href="/auth/login" class="hero-nav-link hero-nav-account-link">Cuenta</a>
      <% } %>
    </div>
  </nav>
</header>
