<%
  const navHelpers = typeof publicNavbarHelpers !== 'undefined' && publicNavbarHelpers
    ? publicNavbarHelpers
    : null;
  const cms = typeof cmsData !== 'undefined' ? cmsData : null;
  const isHomepageNavbar = typeof navbarOnHome !== 'undefined' && navbarOnHome;
  const navbarQuery = typeof searchQuery !== 'undefined' ? searchQuery : '';
  const isStoreSearch = typeof navbarSearchContext !== 'undefined' && navbarSearchContext === 'store';
  const navbarSearchAction = isStoreSearch ? '/tienda' : '/buscar';
  const navbarSearchName = isStoreSearch ? 'search' : 'q';
  const navbarSearchLabel = isStoreSearch ? 'Buscar productos' : 'Buscar en NinjaLab';
  const navbarSearchPlaceholder = isStoreSearch ? 'Buscar productos...' : 'Buscar en NinjaLab...';
  const navbarCurrentPath = typeof currentPath !== 'undefined' ? String(currentPath || '') : '';

  const fallbackNav = (navHelpers && navHelpers.FALLBACK_NAV_TREE) ? navHelpers.FALLBACK_NAV_TREE : [];
  const rawNav = (cms && Array.isArray(cms.navItems) && cms.navItems.length)
    ? cms.navItems
    : fallbackNav;
  const navTree = rawNav.map(function (item) {
    const state = navHelpers && typeof navHelpers.resolveNavActiveState === 'function'
      ? navHelpers.resolveNavActiveState(navbarCurrentPath, item)
      : {
          parentActive: false,
          childActiveUrl: '',
          hasChildren: Array.isArray(item.children) && item.children.length > 0,
        };
    return Object.assign({}, item, state);
  });

  const logoPrimary = (cms && cms.logos && cms.logos.primary) ? cms.logos.primary.url : null;
  const logoLight = (cms && cms.logos && cms.logos.light) ? cms.logos.light.url : null;
%>
<header class="hero-header" data-home-navbar data-hero-animate="navbar"
        <%= (cms && cms.settings) ? 'data-cms-navbar="1"' : '' %>
        <%= (cms && cms.settings && cms.settings['navbar.bg_color']) ? ('style="--cms-nav-bg:' + cms.settings['navbar.bg_color'] + '"').replace(/"/g, '&quot;') : '' %>
        <%= (cms && cms.settings && cms.settings['navbar.text_color']) ? ('data-cms-nav-text="' + cms.settings['navbar.text_color'] + '"').replace(/"/g, '&quot;') : '' %>
        <%= (cms && cms.settings && cms.settings['navbar.accent_color']) ? ('data-cms-nav-accent="' + cms.settings['navbar.accent_color'] + '"').replace(/"/g, '&quot;') : '' %>
>
  <a href="/" class="hero-logo" aria-label="<%= site.name %> — Inicio">
    <span class="hero-logo-stage" aria-hidden="true">
      <% if (logoPrimary) { %>
        <img src="<%= logoPrimary %>" alt="" class="hero-logo-img hero-logo-img--full">
        <% if (logoLight) { %><img src="<%= logoLight %>" alt="" class="hero-logo-img hero-logo-img--compact"><% } %>
      <% } else { %>
        <img src="/images/LogoCompleto.png" alt="" class="hero-logo-img hero-logo-img--full">
        <img src="/images/logoletras.png" alt="" class="hero-logo-img hero-logo-img--compact">
      <% } %>
    </span>
  </a>

  <form class="hero-search hero-search--desktop" action="<%= navbarSearchAction %>" method="get" role="search">
    <label class="hero-search__label" for="navbar-search"><%= navbarSearchLabel %></label>
    <input
      id="navbar-search"
      class="hero-search__input"
      type="search"
      name="<%= navbarSearchName %>"
      value="<%= navbarQuery %>"
      maxlength="100"
      placeholder="<%= navbarSearchPlaceholder %>"
      autocomplete="off"
    >
    <button class="hero-search__submit" type="submit" aria-label="<%= navbarSearchLabel %>">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m16.5 16.5 4 4"></path>
      </svg>
    </button>
  </form>

  <button class="hero-nav-toggle" type="button" aria-expanded="false" aria-controls="hero-navigation" aria-label="Abrir menú principal" data-nav-toggle>
    <span></span><span></span><span></span>
  </button>

  <nav id="hero-navigation" class="hero-nav" aria-label="Navegación principal" data-nav-panel>
    <form class="hero-search hero-search--mobile" action="<%= navbarSearchAction %>" method="get" role="search">
      <label class="hero-search__label" for="mobile-navbar-search"><%= navbarSearchLabel %></label>
      <input
        id="mobile-navbar-search"
        class="hero-search__input"
        type="search"
        name="<%= navbarSearchName %>"
        value="<%= navbarQuery %>"
        maxlength="100"
        placeholder="<%= navbarSearchPlaceholder %>"
        autocomplete="off"
      >
      <button class="hero-search__submit" type="submit" aria-label="<%= navbarSearchLabel %>">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m16.5 16.5 4 4"></path>
        </svg>
      </button>
    </form>

    <ul class="hero-nav-list">
      <% navTree.forEach(function (item, idx) {
        const panelId = 'nav-panel-' + (item.publicId || idx);
        const hasChildren = item.hasChildren;
        const parentActive = item.parentActive;
        const alignEnd = item.label === 'Cotizar' || item.label === 'Nosotros';
      %>
        <% if (hasChildren) { %>
          <li class="hero-nav-item hero-nav-item--dropdown<%= parentActive ? ' is-active-parent' : '' %>" data-nav-dropdown<%= alignEnd ? ' data-dropdown-align="end"' : '' %>>
            <button
              class="hero-nav-link hero-nav-trigger<%= parentActive ? ' active' : '' %>"
              type="button"
              aria-expanded="false"
              aria-controls="<%= panelId %>"
              <% if (parentActive) { %>aria-current="true"<% } %>
            >
              <%= item.label %>
              <svg class="hero-nav-chevron" viewBox="0 0 12 8" aria-hidden="true"><path d="m1 1 5 5 5-5"/></svg>
            </button>
            <div id="<%= panelId %>" class="hero-dropdown-panel" aria-label="Opciones de <%= item.label %>">
              <div class="hero-dropdown-inner">
                <% item.children.forEach(function (child) {
                  const childActive = item.childActiveUrl === child.url;
                %>
                  <a
                    href="<%= child.url %>"
                    class="hero-dropdown-link<%= childActive ? ' active' : '' %>"
                    <% if (childActive) { %>aria-current="page"<% } %>
                    <% if (child.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>
                  >
                    <strong><%= child.label %></strong>
                    <% if (child.description) { %><span><%= child.description %></span><% } %>
                  </a>
                <% }); %>
              </div>
            </div>
          </li>
        <% } else { %>
          <li class="hero-nav-item">
            <a
              href="<%= item.url %>"
              class="hero-nav-link<%= parentActive ? ' active' : '' %>"
              <% if (parentActive) { %>aria-current="page"<% } %>
              <% if (item.target === '_blank') { %>target="_blank" rel="noopener noreferrer"<% } %>
            ><%= item.label %></a>
          </li>
        <% } %>
      <% }); %>
    </ul>

    <div class="hero-nav-account">
      <% if (user) { %>
        <div class="hero-nav-user-block">
          <a href="/cuenta" class="hero-nav-account-link" aria-label="Mi cuenta">
            <div class="hero-nav-avatar" aria-hidden="true">
            <% if (user.avatar_path) { %>
              <img src="/uploads/<%= user.avatar_path %>" alt="" width="32" height="32" class="hero-nav-avatar-img">
            <% } else { %>
              <svg viewBox="0 0 24 24" width="24" height="24"><circle cx="12" cy="8" r="4"/><path d="M4 20c0-4 4-7 8-7s8 3 8 7"/></svg>
            <% } %>
          </div>
          <span class="hero-nav-username" title="<%= user.name %>"><%= user.name %></span>
          </a>
        </div>
      <% } %>
      <a href="/carrito" class="hero-nav-link hero-nav-cart" aria-label="<%= 'Carrito, ' + (cartItemCount || 0) + ' artículos' %>">
        <svg viewBox="0 0 24 24" aria-hidden="true" width="20" height="20">
          <circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/>
          <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/>
        </svg>
        <% if (cartItemCount && cartItemCount > 0) { %>
          <span class="hero-nav-badge" aria-hidden="true"><%= cartItemCount %></span>
        <% } %>
      </a>
      <% if (!user) { %>
        <a href="/auth/login" class="hero-nav-link hero-nav-account-link">Cuenta</a>
      <% } %>
    </div>
  </nav>
</header>
