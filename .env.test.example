# Copy to .env.test only for isolated local DB-backed tests.
# Process variables override values in this file. The normal .env is never
# loaded by a Node test worker or a process with NODE_ENV=test.
NODE_ENV=test
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=nlsite_test

# Both flags are deliberately opt-in. Enable mutations only for an isolated,
# disposable test database after confirming DB_NAME ends in _test.
TEST_DB_ALLOW_CONNECTION=false
TEST_DB_ALLOW_MUTATIONS=false
TEST_DB_ALLOW_REMOTE=false
